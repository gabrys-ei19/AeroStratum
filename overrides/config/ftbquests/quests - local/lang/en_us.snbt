{
	chapter.1354FE99817DA6E3.title: "ERA 0: Początki inżyniera"
	chapter.78F4F7FE4BE6E101.title: "WITAJ W AeroStratum"
	chapter_group.40B7CC202ACD7077.title: "Największa fabryka na świecie"
	chapter_group.5177702D2E2E75BA.title: "Największa fabryka naświecie"
	quest.0794B19AAB6261EF.quest_desc: ["Połącz ociosane drewno ze Stopem Andezytowym (Andesite Alloy), klikając stopem na postawione drewno lub łącząc je w stole rzemieślniczym. Gratulacje – masz oficjalny korpus, który potrafi utrzymać w miejscu koła zębate i tłoki bez rozpadania się konstrukcji."]
	quest.0794B19AAB6261EF.quest_subtitle: "5x Andesite Casing"
	quest.0794B19AAB6261EF.title: "Andezytowa Obudowa"
	quest.083ED9A55CB6F690.quest_desc: [
		"Nie pozwól, aby Creepery zniszczyły Twoje ciężko zarobione maszyny i skrzynki. Może to też uchronić Cię przed kradzieżą, jeśli grasz ze znajomymi!"
		""
		"Otwórz mapę świata klawiszem [ M ]."
		""
		"Kliknij ikonę trzech nakładających się kwadratów w lewym górnym rogu (Claimed Chunks)."
		""
		"Klikaj lewym przyciskiem myszy na kwadraty (chunki), aby je zająć. Staną się bezpieczne."
		""
		"Przytrzymaj [ Shift ] + kliknij LPM na zajęty chunk, aby go załadować na stałe (Force Load). Dzięki temu Twoje farmy i maszyny będą działać, nawet gdy pójdziesz na daleką wyprawę!"
	]
	quest.083ED9A55CB6F690.quest_subtitle: "(Zabezpiecz bazę)"
	quest.083ED9A55CB6F690.title: "Moje na zawsze!"
	quest.0961A1F2AC4E3A5B.quest_desc: [
		"Świat, w którym się znalazłeś, skrywa mroczne tajemnice. Pradawne, monstrualne bestie (z moda Cataclysm) śpią głęboko w gigantycznych strukturach – w ruinach na dnie oceanów, w płonących zamkach w Netherze czy w pustkach Endu."
		""
		"Nie próbuj z nimi walczyć na początku gry. Bez pełnego netherytowego pancerza, potężnych mieczy i zapasu mikstur, te potwory zniszczą Cię jednym uderzeniem. Eksploruj ostrożnie, przygotuj się dobrze i dopiero wtedy ruszaj po ich legendarne dropy!"
	]
	quest.0961A1F2AC4E3A5B.title: "Ostrzeżenie: Cienie w ciemności"
	quest.243D55E17CC9B04A.quest_desc: [
		"Aby ułatwić sobie życie, zapamiętaj te cztery najważniejsze skróty klawiszowe:"
		""
		"[ M ] – Otwiera mapę świata (Xaero's lub JourneyMap)."
		"[ R ] / [ U ] – Najeżdżając myszką na przedmiot w ekwipunku, sprawdzisz jak go stworzyć (R) lub do czego służy (U)."
		"[ W ] - Objaśnienie za pomocą animacji działania i zastosowania danego komponentu create;"
		"[ ~ ] (Tylda) – Aktywuje FTB Ultimine. Przytrzymaj ten klawisz podczas kopania, aby wykopać całą żyłę surowców naraz!"
		"[ B ] – Szybki dostęp do plecaka (Sophisticated backpack)."
	]
	quest.243D55E17CC9B04A.quest_subtitle: "(Ważne Klawisze)"
	quest.243D55E17CC9B04A.title: "Podręcznik Przetrwania"
	quest.25DB44EB6E7DA3B0.quest_desc: ["To jest najważniejszy surowiec w całej Erze 0. Połączenie zwykłego andezytu z samorodkami żelaza (lub cynku) daje wyjątkowo plastyczny i wytrzymały stop. Będziesz go potrzebować w setkach, jeśli nie tysiącach sztuk. Zrób zapas!"]
	quest.25DB44EB6E7DA3B0.quest_subtitle: "8x Andesite Alloy"
	quest.25DB44EB6E7DA3B0.title: "Magiczne połączenie: Stop Andezytowy"
	quest.269AB30A3588E4CD.quest_desc: ["Każdy wielki inżynier zaczynał od ubrudzenia sobie rąk. Zanim zaczniesz budować fabryki parowe, musisz przetrwać pierwszą noc. Wydobądź trochę kamienia, zrób podstawowe narzędzia i przygotuj się na ciężką pracę."]
	quest.269AB30A3588E4CD.quest_subtitle: "16x Bruk (Cobblestone)"
	quest.269AB30A3588E4CD.title: "Podnieś ten kamień"
	quest.31FE06D7BD761156.quest_desc: [
		"W tej paczce pieniądze rządzą światem! Oficjalną walutą są monety z systemu Create Numismatics (te z nietypowymi nazwami, jak Shilling czy Crown)."
		""
		"Monety możesz zdobywać wykonując trudniejsze questy, pokonując bossów oraz sprzedając nadmiarowe surowce w specjalnych maszynach. Zarobioną gotówkę możesz wydać w sklepie questowym (zakładka Sklep, jeśli ją dodasz) lub w automatach vendingowych rozstawionych w świecie gry. Schowaj tę monetę głęboko do kieszeni!"
	]
	quest.31FE06D7BD761156.quest_subtitle: "(Zarabianie)"
	quest.31FE06D7BD761156.title: "Ekonomia i Ty"
	quest.36E78F8D9F91A5E0.quest_desc: ["Kamienne narzędzia są dobre do kopania dziur w ziemi, ale nie do budowania maszyn. Znajdź rudę żelaza i przetop ją w piecu. Żelazo będzie podstawą Twoich pierwszych mechanizmów, wałów korbowych i kół zębatych."]
	quest.36E78F8D9F91A5E0.quest_subtitle: "32x Sztabka żelaza (Iron Ingot)"
	quest.36E78F8D9F91A5E0.title: "Epoka Żelaza"
	quest.72B909D63ED0D8E0.quest_desc: ["Maszyny potrzebują ruchu, a w Create ruchem jest rotacja. Wały przenoszą moc na odległość, a koła zębate pozwalają zmieniać kierunek obrotu i jego prędkość. Stwórz te dwa podstawowe elementy ze stopu andezytowego i patyków."]
	quest.72B909D63ED0D8E0.quest_subtitle: "16x Wał korbowy (Shaft), 2x Małe koło zębate (Cogwheel), 2x Duże koło zębate (large Cogweel)"
	quest.72B909D63ED0D8E0.title: "Niech to się kręci!"
	quest.793CC4C42DE82B09.quest_subtitle: "2x andesite mechanism"
	quest.793CC4C42DE82B09.title: "Pierwszy mechanizm"
	quest.7C2AADE731F3CA8F.quest_desc: ["Aby zbudować obudowę maszyny, potrzebujesz gładkiego, obrobionego drewna. Użyj topora na postawionym drzewie, aby ściągnąć z niego korę. Tak przygotowane bale będą idealnym korpusem dla andezytowej obudowy."]
	quest.7C2AADE731F3CA8F.quest_subtitle: "8x Ociosana kłoda (Stripped Log)"
	quest.7C2AADE731F3CA8F.title: "Kora precz!"
	quest.7ED4C6E89007F931.quest_desc: [
		"Cieszymy się, że tu jesteś! Ta paczka modów została stworzona z myślą o płynnej rozgrywce, automatyzacji i eksploracji. Questy, które tu znajdziesz, nie są obowiązkowe, ale poprowadzą Cię przez najważniejsze etapy rozwoju – od rzemiosła, przez mechanikę Create, aż po starcia z potężnymi bossami."
		""
		"Kliknij przycisk poniżej, aby odebrać swój pakiet startowy i oficjalnie rozpocząć przygodę!"
	]
	quest.7ED4C6E89007F931.title: "Witaj w świecie przygody!"
	reward_table.05175241E52AD9A5.title: "spiwor"
	reward_table.4D95639F76398203.title: "jedzonko"
	task.12C479DA474A2170.title: "Any #c:stripped_logs"
}
