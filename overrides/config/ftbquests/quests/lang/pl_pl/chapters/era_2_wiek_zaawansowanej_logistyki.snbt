	quest.479018DD12B5D1DD.title: "Stacjonarny Bank 64k"
	quest.4AB3D19BB418DCD7.quest_desc: ["Centralna konsola zarządzająca wszystkimi Autocrafterami w Twojej bazie. Pozwala zdalnie wkładać i porządkować wzorce (Patterns) bez biegania po hali maszyn!"]
	quest.4AB3D19BB418DCD7.quest_subtitle: "1x Autocrafter Manager"
	quest.4AB3D19BB418DCD7.title: "Centrum Dowodzenia: Autocrafter Manager"
	quest.4C247BF978FA7AEE.quest_desc: ["Złoty Autocrafter oferuje znacznie większą prędkość przetwarzania oraz więcej miejsca na karty wzorców niż wariant żelazny."]
	quest.4C247BF978FA7AEE.quest_subtitle: "1x Gold Crafter"
	quest.4C247BF978FA7AEE.title: "Złoty Autocrafter"
	quest.54A9CBBFC0236AC9.quest_desc: ["Zbierz 32 Odłamki Ametystu – będą kluczowym surowcem do kalibracji kryształów i zaawansowanej optyki w kolejnych etapach."]
	quest.54A9CBBFC0236AC9.quest_subtitle: "32x Amethyst Shard"
	quest.54A9CBBFC0236AC9.title: "Krystaliczny Urobek: Odłamki Ametystu"
	quest.54BC4B2395B82D1B.quest_desc: ["Komplet narzędzi do inteligentnego zarządzania fabryką: Smart Chute filtruje zrzucane przedmioty, Content Observer i Stockpile Switch badają stan zapasów, a Sequenced Gearshift programuje precyzyjne ruchy maszyn!"]
	quest.54BC4B2395B82D1B.quest_subtitle: "Zestaw Automatyki Mosiężnej"
	quest.54BC4B2395B82D1B.title: "Inteligentna Logistyka Create"
	quest.574A358ADA1BC26D.quest_desc: ["Połączenie zwykłego terminala ze stołem rzemieślniczym! Pozwala tworzyć przedmioty bezpośrednio z surowców zgromadzonych na dyskach sieci Refined Storage."]
	quest.574A358ADA1BC26D.quest_subtitle: "1x Crafting Grid"
	quest.574A358ADA1BC26D.title: "Wygodne Rzemiosło: Crafting Grid"
	quest.5B56BCBD12170E53.quest_desc: ["Koniec z ręcznym składaniem podzespołów! Włóż zaprogramowany wzorzec (Pattern) do Autocraftera, aby sieć sama produkowała potrzebne przedmioty na żądanie lub zasilała zewnętrzne maszyny."]
	quest.5B56BCBD12170E53.quest_subtitle: "1x Autocrafter"
	quest.5B56BCBD12170E53.title: "Produkcja na Żądanie: Autocrafter"
	quest.63CB5961BE31AA90.quest_desc: ["Połączenie mosiężnej obudowy z precyzyjnymi mechanizmami tworzy Brass Machine – fundament pod ciężkie maszyny montażowe, kruszarki oraz zaawansowaną logistykę Ery 2."]
	quest.63CB5961BE31AA90.quest_subtitle: "1x Brass Machine"
	quest.63CB5961BE31AA90.title: "Mosiężny Fundament: Brass Machine"
	quest.6842600FC1293062.quest_desc: ["Zejdź pod ziemię, odnajdź naturalną geodę ametystową i spójrz bezpośrednio na blok Kiełkującego Ametystu (Budding Amethyst) znajdujący się w jej wnętrzu."]
