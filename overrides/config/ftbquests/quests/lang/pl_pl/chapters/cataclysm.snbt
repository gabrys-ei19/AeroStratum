{
	quest.01AFC11EAAB6CB3B.quest_desc: ["&eBone Reptile Armor&r wykuty z kości, Starożytnego Metalu oraz czaszki Kobolediatora zapewnia wysoką obronę i odporność na odrzut."]
	quest.01AFC11EAAB6CB3B.title: "&eBone Reptile Armor"
	quest.0496E8E786262464.quest_desc: ["Nadziemny świat (&2Overworld&r) skrywa aż 5 monumentalnych struktur zamieszkiwanych przez pradawnych bossów Cataclysm."]
	quest.0496E8E786262464.title: "&2Overworld&r: Kraina 5 Bossów"
	quest.04B40BB107F14330.quest_desc: ["&4Meat Shredder&r to mechaniczna piła tarczowa zadająca błyskawiczne obrażenia ciągłe przy przytrzymaniu prawego przycisku myszy."]
	quest.04B40BB107F14330.quest_subtitle: "Ciężka piła mechaniczna"
	quest.04B40BB107F14330.title: "&4Meat Shredder"
	quest.05DE9E1CDFBC22DE.quest_desc: ["&dVoid Scatter Arrows&r przy trafieniu w cel rozpadają się na deszcz odłamków raniących wszystkich wrogów wokół."]
	quest.05DE9E1CDFBC22DE.title: "&dVoid Scatter Arrows"
	quest.060CAF1582B83918.quest_desc: ["&eOccupied Village&r to pustynna wioska przejęta przez &eKoboletony&r oraz &eWadjeta&r. Uwolnij uwięzionych osadników i przeszukaj skrzynie!"]
	quest.060CAF1582B83918.title: "&eOccupied Village"
	quest.0741FABE57CA1A7D.quest_desc: ["&9Hippocamtus&r to opancerzony wojownik z tarczą i włócznią strzegący Akropolu. Podobnie jak Cindaria, upuszcza &9Lacrima&r."]
	quest.0741FABE57CA1A7D.title: "&9Hippocamtus"
	quest.0853917693A259C2.quest_desc: ["&3The Annihilator&r to ciężki młot bojowy – trzymając po jednym w każdej dłoni i przytrzymując PPM, wykonasz potężne uderzenie sejsmiczne w ziemię!"]
	quest.0853917693A259C2.title: "&3The Annihilator"
	quest.0894EB1F3FCFCECA.quest_desc: ["&3Draugrowie&r (zwykli, Royal oraz Elite) to nieumarli wojownicy północy posługujący się orężem i tarczami z Czarnej Stali (Black Steel)."]
	quest.0894EB1F3FCFCECA.title: "&3Draugrs"
	quest.0A43D38D27CF4304.quest_desc: ["&3Abandoned Spire&r to mniejsza mroźna warownia zamieszkiwana przez nieumarłych &3Draugrów&r oraz potężnego &3Aptrgangra&r."]
	quest.0A43D38D27CF4304.title: "&3Abandoned Spire"
	quest.0B7F2B63D867D221.quest_desc: ["W bocznych komnatach szybu prowadzącego na dno piramidy użyj Pędzla (Brush) na Podejrzanym Piasku, aby wydobyć &eNecklace of the Desert&r i przebudzić nim bossa!"]
	quest.0B7F2B63D867D221.quest_subtitle: "Przebudzenie Ancient Remnant"
	quest.0B7F2B63D867D221.title: "&eNecklace of the Desert"
	quest.0E1BC2AE1BE0BDFA.quest_desc: ["W Bujnych Jaskiniach (Lush Caves) możesz natknąć się na &2Amethyst Nest&r – gniazdo zamieszkiwane przez gigantycznego kraba ametystowego."]
	quest.0E1BC2AE1BE0BDFA.title: "&2Amethyst Nest"
	quest.0E1BC2AE1BE1BDFA.quest_desc: ["W Bujnych Jaskiniach (Lush Caves) możesz natknąć się na &2Amethyst Nest&r – gniazdo zamieszkiwane przez gigantycznego kraba ametystowego."]
	quest.0EE0946240B41A00.quest_desc: ["&bIgnitium Armor&r zapewnia widzenie pod lawą (hełm), możliwość połączenia z Elytrą (napierśnik), szybsze gaśnięcie płomieni (nogawice) oraz chodzenie po powierzchni lawy (buty)!"]
	quest.0EE0946240B41A00.title: "&bIgnitium Armor"
	quest.0F8F0F7880235BA2.quest_desc: ["&cSoul Blacksmith&r to monumentalna kuźnia w Netherze pełna złota i czernitu, której pilnuje kolosalny &c&lNetherite Monstrosity&r."]
	quest.0F8F0F7880235BA2.title: "&cSoul Blacksmith&f: Siedziba &c&lNetherite Monstrosity&r"
	quest.1178E4123E8818E2.quest_desc: ["&eSandstorm in a Bottle&r po użyciu przyzywa wokół Ciebie wirujące trąby powietrzne raniące i odrzucające wrogów."]
	quest.1178E4123E8818E2.title: "&eSandstorm in a Bottle"
	quest.13D5F689E6884281.quest_desc: ["&eKobolediator&r to jeden z dwóch mini-bossów piramidy – potężny gladiator wywołujący zmęczenie górnicze i szarżujący na graczy."]
	quest.13D5F689E6884281.title: "&eKobolediator"
	quest.1695917695648018.quest_desc: ["&3Abandoned Temple&r to mroźna świątynia strzeżona przez &3Draugrów&r – na jej szczycie znajdziesz skrzynie z cennym łupem."]
	quest.1695917695648018.title: "&3Abandoned Temple"
	quest.1744E700CF742CE2.quest_desc: ["&5Coralssus&r to potężny koralowy kolos strzegący więzień w Zatopionym Mieście. Upuszcza &5Coral Chunk&r wymagany do stworzenia Abyssal Sacrifice."]
	quest.1744E700CF742CE2.title: "&5Coralssus&r"
	quest.17CA9D80D8EC3EF7.quest_desc: ["&4&lThe Harbinger&r to latająca machina zagłady napędzana Gwiazdą Netheru. Ostrzeliwuje arenę samonaprowadzającymi rakietami Withera, moździerzami oraz potężnym promieniem lasera (wskazówka: impulsy EMP potrafią go chwilowo ogłuszyć!)."]
	quest.17CA9D80D8EC3EF7.title: "&4&lThe Harbinger&r"
	quest.18EB86F91CBBCCC6.quest_desc: [
		"Struktury z moda Cataclysm są rozrzucone po całym świecie na ogromnych dystansach."
		""
		"Przekucie Oka Endera w dedykowane Oko danego bossa wskaże Ci dokładną drogę do jego siedziby (oczy te bardzo rzadko ulegają zniszczeniu przy rzucie)."
	]
	quest.18EB86F91CBBCCC6.title: "Oczy Przeznaczenia"
	quest.1A8F438DB8508276.quest_desc: ["&3Frosted Prison&r to ogromna lodowa forteca w górach skrywająca zbrojownie, cele więzienne oraz Przeklęty Nagrobek (&3Cursed Tombstone&r)."]
	quest.1A8F438DB8508276.title: "&3Frosted Prison&r: Siedziba &3&lMaledictusa"
	quest.1B4ED65C614B102F.quest_desc: ["&bIgnited Revenant&r osłania się wirującymi tarczami – poczekaj, aż uniesie gardę, i pokonaj go, by zdobyć &bBurning Ashes&r."]
	quest.1B4ED65C614B102F.title: "&bIgnited Revenant&r"
	quest.1B7A15730657ED30.quest_desc: ["&eDesert Site&r to rozległe wykopaliska pustynne strzeżone przez &eKoboletony&r i &eWadjeta&r – uważaj na ukryte pułapki przy skrzyniach!"]
	quest.1B7A15730657ED30.title: "&eDesert Site"
	quest.1C5EA7D62BAF2108.quest_desc: ["Aby przebudzić &5&lThe Leviathan&r, musisz złożyć w ołtarzu &5Abyssal Sacrifice&r – przedmiot wykuty z bloków metali, ametystu, muszli łodzika, Serca Morza, sztyletu Athame oraz fragmentów koralu."]
	quest.1C5EA7D62BAF2108.quest_subtitle: "Przebudzenie Lewiatana"
	quest.1C5EA7D62BAF2108.title: "&5Abyssal Sacrifice"
	quest.1D56D3B444A4B2D4.quest_desc: ["Fuzja &dGauntlet of Guard&r oraz &bBulwark of the Flame&r – odpycha pobliskich wrogów, nakłada na nich ogniste piętno i pozwala wykonać płomienną szarżę!"]
	quest.1D56D3B444A4B2D4.title: "&dGauntlet of &bBulwark"
	quest.2011638351B67396.quest_desc: ["Włócznia &9Astrape&r wykuta z Essence of the Storm i Lacrima zapewnia duży zasięg w walce wręcz oraz pozwala ciskać piorunami po przytrzymaniu prawego przycisku myszy!"]
	quest.2011638351B67396.title: "&9Astrape"
	quest.21A0FD474FBB49F7.quest_desc: ["&dRuined Citadel&r to forteca z obsydianu i purpuru na wyspach Endu, strzeżona przez Shulkery, &dEndermaptery&r oraz &dEnder Golemy&r."]
	quest.21A0FD474FBB49F7.title: "&dRuined Citadel&r: Siedziba &d&lEnder Guardiana&r"
	quest.236EA8D18ECD5FE8.quest_desc: ["&bIgnited Berserker&r pojawia się w Fortecach Netheru i upuszcza &bDying Embers&r (4 sztuki złożysz w 1 Burning Ashes)."]
	quest.236EA8D18ECD5FE8.title: "&bIgnited Berserker"
	quest.2542D8A6894816C6.quest_desc: ["&eEye of Desert&r wskaże na pustyni drogę do &eCursed Pyramid&r, w której uśpiony jest &e&lAncient Remnant&r."]
	quest.2542D8A6894816C6.title: "&eEye of Desert&r"
	quest.25ACB08E4F12CE79.quest_desc: ["Postaw &cNetherite Effigy&r i nakarm go ogniwem &cLava Power Cell&r, aby ożywić własnego, oswojonego mini-kolosa z 15 slotami ekwipunku!"]
	quest.25ACB08E4F12CE79.title: "&cNetherite Ministrosity"
	quest.2790EB2E347D28DE.quest_desc: ["Pokonałeś wszystkich ośmiu pradawnych władców Cataclysm w każdym zakątku świata! Odbierz zasłużoną nagrodę pogromcy."]
	quest.2790EB2E347D28DE.quest_subtitle: "Pokonaj wszystkich 8 bossów Cataclysm"
	quest.2790EB2E347D28DE.title: "Pogromca Kataklizmu"
	quest.291C76140DE97E3C.quest_desc: ["Sztabki &bIgnitium&r zdobywane z pokonanego Ignisa służą do wykuwania pancerza wyższego tieru niż Netheryt oraz potężnego oręża ognia."]
	quest.291C76140DE97E3C.quest_subtitle: "Potężniejszy niż Netheryt"
	quest.291C76140DE97E3C.title: "&bIgnitium"
	quest.2A196974431FCC42.quest_desc: ["&cInfernal Forge&r to gigantyczny młoto-kilof wypadający z Netherite Monstrosity – kopie na poziomie netherytu, nie ma paska zużycia, a prawym przyciskiem myszy uderza w ziemię falą uderzeniową!"]
	quest.2A196974431FCC42.title: "&cInfernal Forge"
	quest.2B115519A21F9CB7.quest_desc: ["&d&lEnder Guardian&r czeka na samym dole Cytadeli. Przyciąga graczy grawitacją próżni, wyzwala fale runiczne, a po utracie połowy zdrowia rozbija swoją maskę i niszczy podłogę areny!"]
	quest.2B115519A21F9CB7.title: "&d&lEnder Guardian&r"
	quest.2B50E9FC93812730.quest_desc: ["&eDesert Temple&r z moda Cataclysm kryje we wnętrzu mini-bossa &eKobolediatora&r oraz bogate skrzynie ukryte w wieżach."]
	quest.2B50E9FC93812730.title: "&eDesert Temple"
	quest.2BCB788924BBD849.quest_desc: ["&bThe Incinerator&r to gigantyczny miecz dwuręczny – naładowanie ataku prawym przyciskiem myszy wyzwala spod ziemi linię eksplodujących słupów ognia!"]
	quest.2BCB788924BBD849.title: "&bThe Incinerator"
	quest.2C0DF8D6ED259E5F.quest_desc: ["Połączenie młota &cInfernal Forge&r z włócznią &9Astrape&r tworzy &cBron&9tes&r – oręż miotany przyzywający burzę piorunów w miejscu trafienia!"]
	quest.2C0DF8D6ED259E5F.title: "&cBron&9tes"
	quest.2C9C4BFF1D89EF82.quest_desc: ["&3Abandoned Village&r to opuszczona osada opanowana przez &3Draugrów&r, pełna skrzyń ukrytych w poszczególnych chatach."]
	quest.2C9C4BFF1D89EF82.title: "&3Abandoned Village"
	quest.2CD58FC229BC0C28.quest_desc: ["&dGauntlet of Guard&r to trofeum z Ender Guardiana – przytrzymanie prawego przycisku myszy zasysa wszystkich pobliskich wrogów prosto przed Twoje oblicze!"]
	quest.2CD58FC229BC0C28.title: "&dGauntlet of Guard"
	quest.2D69B48F1EFCC9A5.quest_desc: ["&3Sturdy Boots&r pozwalają swobodnie chodzić po powierzchni sypkiego śniegu bez zapadania się."]
	quest.2D69B48F1EFCC9A5.title: "&3Sturdy Boots"
	quest.2F62C290A5CE50F8.quest_desc: ["&eAncient Spear&r ma daleki zasięg i wystrzeliwuje przy atakach niszczycielskie trąby piaskowe!"]
	quest.2F62C290A5CE50F8.title: "&eAncient Spear"
	quest.30C5D432C810F904.quest_desc: ["&9Eye of Storm&r wskaże podniebną drogę nad oceanem do &9Acropolis&r, gdzie włada &9&lScylla&r."]
	quest.30C5D432C810F904.title: "&9Eye of Storm"
	quest.33B1D3FD4C0B5514.quest_desc: ["&e&lAncient Remnant&r to kolosalny szkielet prehistorycznego drapieżnika władającego burzami piaskowymi i falami uderzeniowymi."]
	quest.33B1D3FD4C0B5514.title: "&e&lAncient Remnant&r"
	quest.3459CAEB59CBD60E.quest_desc: ["&4The Prowler&r to ciężki gąsienicowy mini-boss fabryki uzbrojony w piłę tarczową, wyrzutnię rakiet oraz laser."]
	quest.3459CAEB59CBD60E.title: "&4The Prowler&r"
	quest.35E42F7925CA097A.quest_desc: ["&dVoid Core&r pozwala przyzywać z ziemi linię kłów i run próżni oraz służy jako kluczowy komponent w Kowadle Fuzji."]
	quest.35E42F7925CA097A.title: "&dVoid Core"
	quest.37E4DECFB6526969.quest_desc: ["&3Soul Render&r pozwala wykonywać błyskawiczne szarże (PPM), pozostawiając za sobą deszcz widmowych halabard spadających z nieba!"]
	quest.37E4DECFB6526969.title: "&3Soul Render"
	quest.392EAE8BE71510C1.quest_desc: ["Poza Smokiem Endu, w pustce &5The End&r wznosi się zrujnowana cytadela skrywająca strażnika próżni."]
	quest.392EAE8BE71510C1.title: "&5The End&r: Strażnik Próżni"
	quest.3B577572FA7A413E.quest_desc: ["Połączenie &3Cursed Bow&r oraz &eSandstorm in a Bottle&r tworzy łuk, który nie wymaga strzał i wystrzeliwuje po trzy przeklęte trąby piaskowe naraz!"]
	quest.3B577572FA7A413E.title: "&3Wrath of the &eDesert"
	quest.3C0F8EB779E56F2A.quest_desc: ["&9Chitin Claw&r zdobywany z Clawdiana zwiększa zasięg stawiania bloków oraz zasięg ataku wręcz!"]
	quest.3C0F8EB779E56F2A.title: "&9Chitin Claw"
	quest.3DD71B6C4B80FB44.quest_desc: ["&3Eye of Curse&r poprowadzi Cię w ośnieżone szczyty do &3Frosted Prison&r, gdzie spoczywa &3&lMaledictus&r."]
	quest.3DD71B6C4B80FB44.title: "&3Eye of Curse"
	quest.3E8C7D92F99496BE.quest_desc: ["&5Eye of Abyss&r poprowadzi Cię w głębiny oceanu do &5Sunken City&r, będącego leżem &5&lThe Leviathan&r."]
	quest.3E8C7D92F99496BE.title: "&5Eye of Abyss&r"
	quest.43A5B83862D9E94C.quest_desc: ["&bEye of Flame&r wskaże drogę w Netherze do &bBurning Arena&r, gdzie czeka &b&lIgnis&r."]
	quest.43A5B83862D9E94C.title: "&bEye of Flame&r"
	quest.445C9117198936B6.quest_desc: ["Naramienna wyrzutnia rakiet &4W.A.S.W.&r wystrzeliwuje samonaprowadzające pociski (PPM) lub ciężką salwę moździerzową (Shift + PPM)."]
	quest.445C9117198936B6.title: "&4W.A.S.W. (Wither Assault Shoulder Weapon)"
	quest.45FBEABEBA7CC09E.quest_desc: ["&5Sunken City&r to ogromna podwodna metropolia z centralną kopułą mieszczącą &5Altar of the Abyss&r, zamieszkiwana przez rasę &5Deeplingów&r oraz strażników koralowych."]
	quest.45FBEABEBA7CC09E.title: "&5Sunken City&r: Siedziba &5&lThe Leviathan&r"
	quest.462D173D576A8D91.quest_desc: ["&eAncient Metal&r pozyskiwany ze strażników piramidy pozwala wykuć gadzi pancerz oraz Starożytną Włócznię."]
	quest.462D173D576A8D91.title: "&eAncient Metal"
	quest.465B08461B460DAC.quest_desc: ["&dEndermaptera&r to opancerzone insekty Endu zamieszkujące Zrujnowaną Cytadelę. Zabijaj je szybko, zanim zniszczą własne żuwaczki (&dVoid Jaw&r)!"]
	quest.465B08461B460DAC.quest_subtitle: "Insekty Próżni"
	quest.465B08461B460DAC.title: "&dEndermaptera"
	quest.46CC8E7ED59F51D2.quest_desc: ["&5Tidal Claws&r to gwarantowany łup z Lewiatana. Lewy przycisk myszy wystrzeliwuje łańcuchowy atak przez maks. 5 celów, a prawy działa jak kotwiczka przyciągająca Cię do bloków i wrogów!"]
	quest.46CC8E7ED59F51D2.title: "&5Tidal Claws"
	quest.4BF5EB050EC14C80.quest_desc: ["&4The Watchers&r to latające drony strażnicze w Pradawnej Fabryce, atakujące wiązkami laserowymi i ostrzami."]
	quest.4BF5EB050EC14C80.title: "&4The Watchers&r"
	quest.4CCEC13CC5A5772D.quest_desc: ["Wszystkie trzy oswojone mini-stworzenia z Cataclysm (Modern Remnant, Baby Leviathan oraz Netherite Ministrosity) możesz wygodnie przenosić w wiadrze!"]
	quest.4CCEC13CC5A5772D.title: "Kieszonkowe Bestie"
	quest.4D644A9829C240CB.quest_desc: ["&bBulwark of the Flame&r to tarcza Ignisa – przytrzymanie Shift + PPM i puszczenie wyzwala ognistą szarżę taranującą i ogłuszającą wrogów!"]
	quest.4D644A9829C240CB.title: "&bBulwark of the Flame"
	quest.4D822D92492E1F53.quest_desc: ["&3Aptrgangr&r to potężny mini-boss Mroźnego Więzienia dzierżący olbrzymi topór. Pokonaj go, aby zdobyć klucz do komnaty głównego bossa!"]
	quest.4D822D92492E1F53.title: "&3Aptrgangr"
	quest.4E2C589C7638390F.quest_desc: ["&3Cursed Bow&r wystrzeliwuje salwę kilku strzał jednocześnie bez zużywania dodatkowej amunicji."]
	quest.4E2C589C7638390F.title: "&3Cursed Bow"
	quest.4FA156C383C9C438.quest_desc: ["&eKoboletony&r to szkieletowi strażnicy piramidy uzbrojeni w zakrzywione miecze Khopesh."]
	quest.4FA156C383C9C438.quest_subtitle: "Strażnicy pustyni"
	quest.4FA156C383C9C438.title: "&eKoboletons"
	quest.4FA7774D89171BB3.quest_desc: ["&eRemnant Skull&r przyzywa małego Modern Remnanta, którego możesz oswoić za pomocą Jajka Niuchacza (Sniffer Egg) i leczyć kośćmi Koboletonów!"]
	quest.4FA7774D89171BB3.title: "&eRemnant Skull"
	quest.50C9CB8FB16E453D.quest_desc: ["&bBurning Arena&r to gigantyczny koloseum w Netherze. Na drugim piętrze pokonaj strażników &bIgnited Revenant&r, aby zdobyć popioły do wywołania bossa na szczycie areny!"]
	quest.50C9CB8FB16E453D.title: "&bBurning Arena&r: Siedziba &b&lIgnisa&r"
	quest.53154550397E9704.quest_desc: ["&c&lNetherite Monstrosity&r to ważący setki ton kolos z netherytu i lawy. Wywołuje trzęsienia ziemi, zasysa lawę do regeneracji i ostrzeliwuje arenę kulami magmy!"]
	quest.53154550397E9704.title: "&c&lNetherite Monstrosity&r"
	quest.55278DDC31951DA5.quest_desc: ["&3Strange Key&r zdobyty z Aptrgangra otwiera zapieczętowane wrota prowadzące do nagrobka Maledictusa."]
	quest.55278DDC31951DA5.quest_subtitle: "Otwarcie wrót do Maledictusa"
	quest.55278DDC31951DA5.title: "&3Strange Key"
	quest.565376084F05ED6E.quest_desc: ["Piekielne głębiny &4Netheru&r są domem dla dwóch niszczycielskich władców ognia i netherytu."]
	quest.565376084F05ED6E.title: "&4Nether&r: Kraina 2 Bossów"
	quest.573DD5834B321D0A.quest_desc: ["&9Acropolis&r to monumentalne greckie miasto zawieszone w chmurach wysoko nad oceanem, zbudowane z Azure Seastone oraz pryzmarynu."]
	quest.573DD5834B321D0A.title: "&9Acropolis&f: Siedziba &9&lScylli"
	quest.5BD22081ED81BCC6.quest_desc: ["&9Urchinkin&r to małe, kolczaste stworzenia toczące się w stronę intruzów i wystrzeliwujące kolce na wszystkie strony."]
	quest.5BD22081ED81BCC6.title: "&9Urchinkin"
	quest.5C6C4AD0F60BECCA.quest_desc: ["&eKhopesh&r to zakrzywiony miecz pustynnych szkieletów, wykorzystywany również do dalszego rzemiosła."]
	quest.5C6C4AD0F60BECCA.title: "&eKhopesh"
	quest.5D74D73092ACD2F2.quest_desc: ["&5Coral Golem&r to mniejszy koralowy strażnik Zatopionego Miasta, z którego zdobędziesz &5Crystallized Coral Fragments&r."]
	quest.5D74D73092ACD2F2.title: "&5Coral Golem"
	quest.5E3263ACE170A8E3.quest_desc: ["Fuzja &dGauntlet of Guard&r oraz &eSandstorm in a Bottle&r – pozwala tworzyć w miejscu celowania wir próżni zasysający wrogów i eksplodujący po kilku sekundach!"]
	quest.5E3263ACE170A8E3.title: "&dGauntlet of &eMaelstrom"
	quest.5EDB5A2D744CE415.quest_desc: ["&4Laser Gatling&r to szybkostrzelne działko obrotowe zasilane proszkiem Redstone z ekwipunku (1 Redstone wystarcza na 50 strzałów laserowych)."]
	quest.5EDB5A2D744CE415.quest_subtitle: "Technologia laserowa"
	quest.5EDB5A2D744CE415.title: "&4Laser Gatling"
	quest.5FBA199E0B7F1585.quest_desc: ["&9Octohost&r to symbiotyczny duet: ośmiornica &9Symbiocto&r oślepiająca atramentem z góry oraz kontrolowany przez nią utopiec &9Drowned Host&r atakujący wręcz."]
	quest.5FBA199E0B7F1585.title: "&9Octohost"
	quest.62089E9E6D596DA7.quest_desc: ["Przekucie młota &3The Annihilator&r ze sztabką &bIgnitium&r tworzy &3The &bImmolator&r – broń zadającą ogromne obrażenia celom naznaczonym płomieniem i wywołującą eksplozje ognia!"]
	quest.62089E9E6D596DA7.title: "&3The &bImmolator"
	quest.62C32905C33E2D88.quest_desc: ["&dEye of Void&r zaprowadzi Cię w pustce Endu do &dRuined Citadel&r, której strzeże &d&lEnder Guardian&r."]
	quest.62C32905C33E2D88.title: "&dEye of Void&r"
	quest.62DF58D36B739EA0.quest_desc: ["&eWadjet&r to drugi mini-boss piramidy, ciskający burzami piaskowymi i zrzucający bloki piasku ze stropu."]
	quest.62DF58D36B739EA0.title: "&eWadjet"
	quest.631796E7615C04FA.quest_desc: ["&2Amethyst Crab&r to neutralny mini-boss z Bujnych Jaskiń. Po pokonaniu upuszcza mięso (które można pobłogosławić na ołtarzu ametystu) oraz skorupę do wykucia naramienników Bloom Stone Pauldrons."]
	quest.631796E7615C04FA.title: "&2Amethyst Crab&r"
	quest.655FF7295B688354.quest_desc: ["&9Clawdian&r to potężny mini-boss Akropolu – gigantyczny homar dzierżący wielki topór i wywołujący fale uderzeniowe."]
	quest.655FF7295B688354.title: "&9Clawdian"
	quest.680D49E2B3929322.quest_desc: ["&eVitality Ankh&r wzmacnia naturalną regenerację i leczenie podczas starć z bossami."]
	quest.680D49E2B3929322.title: "&eVitality Ankh"
	quest.683C260C854C5AA3.quest_desc: ["&4Mechanical Fusion Anvil&r to niezniszczalne kowadło pozwalające łączyć ze sobą trofea i bronie z różnych bossów Cataclysm w ostateczny oręż hybrydowy!"]
	quest.683C260C854C5AA3.title: "&4Mechanical Fusion Anvil"
	quest.689F32883C4E9502.quest_desc: [
		"&4&lCataclysm&r wprowadza potężnych bossów, rozbudowane lochy oraz legendarny ekwipunek bojowy."
		""
		"Nie ma sztywnej kolejności pokonywania bossów, jednak niektórzy są znacznie groźniejsi od pozostałych. Wykorzystaj specjalne Oczy, aby zlokalizować ukryte w świecie fortece i świątynie!"
	]
	quest.689F32883C4E9502.title: "&4&lCataclysm"
	quest.69439426534EBDC4.quest_desc: ["&bBlazing Grips&r nakładają na trafionych wrogów efekt &bBlazing Brand&r, który osłabia ich pancerz i wytrzymałość."]
	quest.69439426534EBDC4.title: "&bBlazing Grips"
	quest.696A33E7D91A487E.quest_desc: ["&9Cindaria&r to strażniczki Akropolu ciskające odbijającymi się od ścian włóczniami piorunów. Po śmierci upuszczają cenny surowiec &9Lacrima&r."]
	quest.696A33E7D91A487E.title: "&9Cindaria"
	quest.69EA17CEB4203C96.quest_desc: ["&3Berserker Soul Amulet&r zwiększa zadawane przez Ciebie obrażenia o 10%, ale jednocześnie obniża Twój pancerz o 25%."]
	quest.69EA17CEB4203C96.title: "&3Berserker Soul Amulet"
	quest.69ECE13A6E5503CD.quest_desc: [
		"W świecie możesz natknąć się również na pomniejsze struktury powiązane z &eCursed Pyramid&r oraz &3Frosted Prison&r."
		""
		"Skrywają one unikalne akcesoria bojowe – część z nich wymaga założenia pasa &6Belt of Beginner&r, aby odblokować dodatkowe sloty ekwipunku!"
	]
	quest.69ECE13A6E5503CD.title: "Mniejsze Struktury i Akcesoria"
	quest.6B5BC33667C782EC.quest_desc: ["&dEnder Golem&r to mini-boss strzegący Cytadeli, wywołujący z ziemi runy próżni. Koniecznie go pokonaj, aby zdobyć cenny &dVoid Core&r!"]
	quest.6B5BC33667C782EC.title: "&dEnder Golem&r"
	quest.6BC3CF8937DEDE89.quest_desc: ["Połączenie &cInfernal Forge&r z &dVoid Core&r tworzy &dVoid &cForge&r – młoto-kilof wywołujący wachlarz run próżni przy uderzeniu w ziemię!"]
	quest.6BC3CF8937DEDE89.title: "&dVoid &cForge"
	quest.6CB8D3919B16784B.quest_desc: ["&9Ceraunus&r to potężna kotwica samej Scylli – pozwala rzucać kotwicą w przeciwników lub wyzwalać niszczycielskie fale uderzeniowe."]
	quest.6CB8D3919B16784B.title: "&9Ceraunus"
	quest.6DC633B4D09185A5.quest_desc: ["Sztabki &3Cursium&r zdobyte z Maledictusa pozwalają przekuć netherytowy rynsztunek w przeklętą zbroję i broń duchową."]
	quest.6DC633B4D09185A5.title: "&3Cursium Ingot"
	quest.6E08D4E6BC3FB99F.quest_desc: ["&5Deeplingi&r to podwodni strażnicy Zatopionego Miasta dzielący się na kasty: zwykłych wojowników z włóczniami, wędkarzy (Anglers), berserkerów (Brutes) oraz kapłanów i czarnoksiężników upuszczających sztylet &5Athame&r."]
	quest.6E08D4E6BC3FB99F.title: "&5Deeplings&r"
	quest.6E12C5DDF81DE88F.quest_desc: ["&eUnbreakable Skull&r chroni Cię przed efektami ogłuszenia (Stun) nakładanymi przez potężne ataki bossów."]
	quest.6E12C5DDF81DE88F.title: "&eUnbreakable Skull"
	quest.6ED61438A8A1EAA4.quest_desc: ["&4Witherite&r zdobywany z Harbingera służy do budowy zaawansowanego uzbrojenia maszynowego oraz &4Mechanical Fusion Anvil&r."]
	quest.6ED61438A8A1EAA4.quest_subtitle: "= Witherite"
	quest.6ED61438A8A1EAA4.title: "Wither + Netheryt = ...?"
	quest.6FC4146E534C51DA.quest_desc: ["&cMonstrous Helm&r wykuty z rogu bossa odrzuca pobliskich wrogów i wzmacnia Twoją obronę, gdy Twoje zdrowie spadnie poniżej połowy."]
	quest.6FC4146E534C51DA.title: "&cMonstrous Helm"
	quest.70CDA5F1593DB4B2.quest_desc: ["&eCursed Pyramid&r to gigantyczna piramida na pustyni pełna pułapek, podejrzanego piasku oraz starożytnych strażników."]
	quest.70CDA5F1593DB4B2.title: "&eCursed Pyramid&r: Siedziba &e&lAncient Remnant&r"
	quest.71055E7BBB337C4D.quest_desc: ["Kliknij na Przeklęty Nagrobek, aby wezwać &3&lMaledictusa&r – uskrzydlonego upiora północy władającego na przemian dwoma młotami Annihilator, halabardą Soul Render oraz Przeklętym Łukiem!"]
	quest.71055E7BBB337C4D.title: "&3&lMaledictus"
	quest.713006AB89E43C6D.quest_desc: ["Na samym szczycie Akropolu czeka &9&lScylla&r – władczyni sztormu dzierżąca kotwicę &9Ceraunus&r, ciskająca gromami i falami oceanicznymi. Po pokonaniu upuszcza &9Essence of the Storm&r oraz &9Lacrima&r."]
	quest.713006AB89E43C6D.title: "&9&lScylla"
	quest.7270FA5C48AF7280.quest_desc: ["&3Cursium Armor&r pozwala podświetlać wrogów przez ściany (klawisz C), zapewnia wbudowany efekt Totemu Nieśmiertelności na napierśniku oraz odrzutowy odskok na butach (klawisz V)!"]
	quest.7270FA5C48AF7280.title: "&3Cursium Armor"
	quest.73A56DD4AC1B9590.quest_desc: ["Noszenie &3Ring of Grudged&r znacząco zwiększa obrażenia zadawane podczas ataków krytycznych (z wyskoku)."]
	quest.73A56DD4AC1B9590.title: "&3Ring of Grudged"
	quest.746DE905D45A396C.quest_desc: [
		"&5&lThe Leviathan&r to gigantyczny morski drapieżnik władający głębinami!"
		""
		"Tworzy podwodne miny, wiry wodne zasysające graczy oraz niszczycielskie promienie próżni. Pamiętaj, że poza wodą staje się niewrażliwy na obrażenia!"
	]
	quest.746DE905D45A396C.title: "&5&lThe Leviathan&r"
	quest.747B62A955D0C629.quest_desc: ["&4Ancient Factory&r to podziemny kompleks przemysłowy pełen mechanizmów redstone, impulsatorów EMP oraz bojowych automatów (&4The Watchers&r i &4The Prowler&r)."]
	quest.747B62A955D0C629.title: "&4Ancient Factory&r: Siedziba &4&lThe Harbinger&r"
	quest.74ACCEB6DC9EF6F7.quest_desc: ["Połączenie wyrzutni &4W.A.S.W.&r z &dVoid Core&r tworzy &dV.&4A.S.W.&r, wystrzeliwującą pociski próżniowe wywołujące erupcję run pod stopami wrogów!"]
	quest.74ACCEB6DC9EF6F7.title: "&dV.&4A.S.W. &d(Void &4Assault Shoulder Weapon)"
	quest.775AB10F8196F27B.quest_desc: ["&4Eye of Mech&r poprowadzi Cię pod ziemię do &4Ancient Factory&r, gdzie spoczywa &4&lThe Harbinger&r."]
	quest.775AB10F8196F27B.title: "&4Eye of Mech&r"
	quest.7AED8FD7FB023AD8.quest_desc: ["Aby uruchomić głównego bossa fabryki – &4&lThe Harbinger&r – musisz zasilić jego rdzeń za pomocą &fGwiazdy Netheru (Nether Star)&r!"]
	quest.7AED8FD7FB023AD8.quest_subtitle: "Zasilenie Harbingera"
	quest.7AED8FD7FB023AD8.title: "Nether Star"
	quest.7AEE4BE3AB41ED3E.quest_desc: ["Połączenie &bIgnitium Chestplate&r z Elytrą w Kowadle Fuzji daje pełną ochronę pancerza połączoną ze swobodnym lotem!"]
	quest.7AEE4BE3AB41ED3E.title: "&bIgnitium Elytra Chestplate"
	quest.7C848C7011726470.quest_desc: ["&cEye of Monstrous&r wskaże lokalizację &cSoul Blacksmith&r w Netherze, gdzie przebywa &c&lNetherite Monstrosity&r."]
	quest.7C848C7011726470.title: "&cEye of Monstrous&r"
	quest.7CBEBBCB9D95D11A.quest_desc: ["Postaw &5Abyssal Egg&r i poczekaj, aż wykluje się z niego młody Lewiatan, którego możesz oswoić za pomocą Tropikalnych Ryb!"]
	quest.7CBEBBCB9D95D11A.title: "Abyssal Egg"
	quest.7D57A14810BC0CBE.quest_desc: ["&b&lIgnis&r to mistrzowsko opancerzony rycerz płomieni dzierżący gigantyczny miecz i tarczę. W drugiej fazie walki jego ogień zmienia barwę na błękitną, a jego ataki przebijają blok i kradną zdrowie!"]
	quest.7D57A14810BC0CBE.title: "&b&lIgnis&r"
	quest.7F4963FCAE5337EC.quest_desc: ["Użyj &bBurning Ashes&r na Ołtarzu Ognia (Altar of Fire) na najwyższym piętrze Płonącej Areny, aby wezwać &b&lIgnisa&r!"]
	quest.7F4963FCAE5337EC.quest_subtitle: "Rozpalenie ołtarza"
	quest.7F4963FCAE5337EC.title: "&bBurning Ashes"
	task.01063DC98BCE5A91.title: "Pogromca Kataklizmu"
}