{
	quest.035A4D63CB792F6E.quest_desc: ["Precyzyjne przeguby wykute z blachy cynkowej pozwalają naśladować ruch ludzkiej dłoni. To kluczowy element każdego automatycznego ramienia montażowego."]
	quest.035A4D63CB792F6E.quest_subtitle: "1x Zinc Hand",
	quest.035A4D63CB792F6E.title: "Mechaniczny Chwyt: Cynkowa Dłoń",
	quest.037A93600E70561C.quest_desc: ["Unikalny moduł integrujący fizyczną pojemność szuflad ze strukturą dysków i bloków pamięci Refined Storage. Niezbędny komponent do zamknięcia każdego nośnika danych."]
	quest.037A93600E70561C.quest_subtitle: "1x Digital Drawer",
	quest.037A93600E70561C.title: "Hybrydowy Bufor: Digital Drawer",
	quest.04C59391A677A292.quest_desc: ["Pusta, pancerna kaseta ochronna gotowa na przyjęcie rdzenia pamięci. Chroni delikatne układy kwarcowe przed uszkodzeniem."]
	quest.04C59391A677A292.quest_subtitle: "1x Storage Housing",
	quest.04C59391A677A292.title: "Kieszeń na Dane: Storage Housing",
	quest.061307A9C70E47B4.quest_desc: ["Podgrzana kadź z mikserem pozwala stopić miedź i cynk w szlachetny mosiądz. Ten stop otwiera drogę do filtrowania, inteligentnych maszyn oraz precyzyjnej automatyki."]
	quest.061307A9C70E47B4.quest_subtitle: "1x Brass Ingot",
	quest.061307A9C70E47B4.title: "Złoto Inżynierów: Stop Mosiądzu",
	quest.093786ED188CB158.quest_desc: ["Czterokrotnie większa gęstość upakowania danych. Idealny wybór, gdy urobek z automatycznych kopalni zaczyna liczyć się w tysiącach."]
	quest.093786ED188CB158.quest_subtitle: "1x 4k Storage Part",
	quest.093786ED188CB158.title: "Gęstszy Zapis: Rdzeń 4k",
	quest.0B98C898071F3C33.quest_desc: ["Zwykłe ognisko nie wystarczy do wytopu szlachetnych stopów. Wykuj żelazny kosz palnika, udaj się do Netheru i schwytaj w niego Płomyka (Blaze'a), aby zyskać kontrolowane źródło ekstremalnej temperatury."]
	quest.0B98C898071F3C33.quest_subtitle: "1x Empty Blaze Burner",
	quest.0B98C898071F3C33.title: "Klatka na Żywioł",
	quest.0C16D28641468295.quest_desc: ["Automatyczny konstruktor (Constructor) pobiera bloki z sieci Refined Storage i stawia je w świecie przed sobą."]
	quest.0C16D28641468295.quest_subtitle: "1x Constructor",
	quest.0C16D28641468295.title: "Automatyczny Budowniczy: Constructor",
	quest.0C6ADA0C7F766E65.quest_desc: ["Ciemna skała wulkaniczna wytwarzana na żądanie bez wypraw do Netheru."],
	quest.0C6ADA0C7F766E65.quest_subtitle: "64x Basalt"
	quest.0C6ADA0C7F766E65.title: "Ekstruzja: Bazalt",
	quest.1136FE2A46C13302.quest_desc: ["Zajezdnia (Depot) przytrzymuje przedmioty w idealnej pozycji pod prasą lub ramieniem Deployera. W połączeniu z lejami tworzy najprostszą stację obróbki sekwencyjnej."],
	quest.1136FE2A46C13302.quest_subtitle: "Najważniejsze elementy na taśmie",
	quest.1136FE2A46C13302.title: "Podstawowe narzędzia taśmowe",
	quest.179A2967D712CE85.quest_desc: ["Nasycenie kwarcu netherowego ogromną ilością czerwonego proszku tworzy kryształ zdolny do przewodzenia i wzmacniania impulsów energetycznych."],
	quest.179A2967D712CE85.quest_subtitle: "1x Rose Quartz",
	quest.179A2967D712CE85.title: "Krystaliczna Rezonancja: Różowy Kwarc",
	quest.18B025CA634BFF11.quest_desc: ["Samodzielny blok pamięci 1k, który możesz postawić bezpośrednio w świecie i podpiąć kablem do sieci bez użycia stacji Disk Drive."],
	quest.18B025CA634BFF11.quest_subtitle: "1x 1k Storage Block",
	quest.18B025CA634BFF11.title: "Stacjonarny Bank 1k",
	quest.1B93CC74B13084E5.quest_desc: ["Wysuszone wodorosty po obróbce stanowią zaskakująco elastyczny i wytrzymały surowiec, przypominający gumę przemysłową. Zbierz solidny zapas z dna oceanu – bez niego żadna taśma produkcyjna nie ruszy z miejsca."],
	quest.1B93CC74B13084E5.quest_subtitle: "32x Kelp",
	quest.1B93CC74B13084E5.title: "Zbiór z Głębin: Wodorosty",
	quest.1C22288B92135426.quest_desc: ["Wolnostojąca szafa serwerowa o pojemności 4096 przedmiotów. Świetnie sprawdza się jako dedykowany magazyn podpięty bezpośrednio pod linię produkcyjną."],
	quest.1C22288B92135426.quest_subtitle: "1x 4k Storage Block",
	quest.1C22288B92135426.title: "Stacjonarny Bank 4k",
	quest.1E3C2E5663DE1F3F.quest_desc: [
		"Szczytowe osiągnięcie mechaniki precyzyjnej! Zestaw rząd Deployerów nad taśmą montażową i zautomatyzuj produkcję Precision Mechanism."
		""
		"Opanowanie tego procesu otwiera przed Tobą wrota do zaawansowanej logistyki, maszyn mosiężnych oraz pełnej automatyzacji. Witaj w Erze 2!"
	],
	quest.1E3C2E5663DE1F3F.quest_subtitle: "Kamień Milowy Ery 1",
	quest.1E3C2E5663DE1F3F.title: "Złote Serce Automatyzacji: Precision Mechanism",
	quest.200DFE86A1BCAE00.quest_desc: ["Automatyczny destruktor (Destructor) niszczy bloki znajdujące się przed nim i przesyła urobek prosto na dyski sieciowe."],
	quest.200DFE86A1BCAE00.quest_subtitle: "1x Destructor",
	quest.200DFE86A1BCAE00.title: "Automatyczny Górnik: Destructor",
	quest.24E0B7BE9E8CAF99.quest_desc: ["Stacja dokująca mieszcząca aż 8 dysków pamięci. Podłącz ją do Kontrolera, włóż dyski i ciesz się scentralizowanym magazynem."],
	quest.24E0B7BE9E8CAF99.quest_subtitle: "1x Disk Drive",
	quest.24E0B7BE9E8CAF99.title: "Szafa Serwerowa: Disk Drive",
	quest.24F68B7E8A51E6FD.quest_desc: ["Specjalistyczny rdzeń obliczeniowy odpowiedzialny za materializację obiektów z postaci cyfrowej."],
	quest.24F68B7E8A51E6FD.quest_subtitle: "1x Construction Core",
	quest.24F68B7E8A51E6FD.title: "Rdzeń Budowlany: Construction Core",
	quest.267ABF42F9628FEA.quest_desc: ["Serce każdego systemu Refined Storage. Dostarcz mu energię elektryczną (FE), a ożywi wszystkie podłączone terminale, napędy oraz interfejsy."],
	quest.267ABF42F9628FEA.quest_subtitle: "1x Controller",
	quest.267ABF42F9628FEA.title: "Mózg Operacji: Kontroler Sieci",
	quest.2A02D797F5CABAD6.quest_desc: ["Nieskończone źródło andezytu pod masową produkcję stopu andezytowego (Andesite Alloy)."],
	quest.2A02D797F5CABAD6.quest_subtitle: "64x Andesite",
	quest.2A02D797F5CABAD6.title: "Ekstruzja: Andezyt",
	quest.2E5D835D2B5D7078.quest_desc: ["Andezyt świetnie znosi naprężenia kinetyczne, ale przy kontakcie z cieczami i wysokim ciśnieniem szybko zawodzi. Pokrycie drewna miedzią otwiera drzwi do równoległej gałęzi inżynierii płynów (Era 1.5)!"],
	quest.2E5D835D2B5D7078.quest_subtitle: "1x Copper Casing",
	quest.2E5D835D2B5D7078.title: "Szczelna Konstrukcja: Miedziana Obudowa",
	quest.31AA7117F83F8B86.quest_desc: ["Niestrudzony pracownik Twojej fabryki. Deployer potrafi osadzać podzespoły na taśmie, używać narzędzi i składać wieloetapowe mechanizmy z idealną powtarzalnością."],
	quest.31AA7117F83F8B86.quest_subtitle: "1x Deployer",
	quest.31AA7117F83F8B86.title: "Ramię Montażowe: Deployer",
	quest.34B798B9DF328A6F.quest_desc: ["Wyszlifuj surowy kryształ papierem ściernym (lub automatycznie za pomocą Deployera), aby wydobyć jego pełne właściwości elektronowe i optyczne."],
	quest.34B798B9DF328A6F.quest_subtitle: "1x Polished Rose Quartz",
	quest.34B798B9DF328A6F.title: "Optyczna Gładkość: Szlifowany Kwarc",
	quest.34D17EBBA4F9CA1F.quest_desc: ["Jasna skała głębinowa, świetna zarówno do budownictwa, jak i dalszego kruszenia w młynach."],
	quest.34D17EBBA4F9CA1F.quest_subtitle: "64x Diorite",
	quest.34D17EBBA4F9CA1F.title: "Ekstruzja: Dioryt",
	quest.35CB6AFD283E9A43.quest_desc: ["Centralny węzeł dla systemu szuflad Functional Storage. Pozwala jednym kliknięciem deponować setki stacków surowców z całej fabryki do przypisanych szuflad."],
	quest.35CB6AFD283E9A43.quest_subtitle: "1x Storage Controller",
	quest.35CB6AFD283E9A43.title: "Mistrz Magazynu: Storage Controller",
	quest.3C31D3F9E8A8F756.quest_desc: ["Złocista skała osadowa, z której po zmieleniu i płukaniu odzyskasz samorodki złota."],
	quest.3C31D3F9E8A8F756.quest_subtitle: "64x Ochrum",
	quest.3C31D3F9E8A8F756.title: "Ekstruzja: Ochrum (Złoto)",
	quest.3D88E2FFB342DE22.quest_desc: ["Podstawowy procesor sterujący przesyłem prostych sygnałów i wyświetlaniem danych w terminalach sieciowych."],
	quest.3D88E2FFB342DE22.quest_subtitle: "1x Basic Processor",
	quest.3D88E2FFB342DE22.title: "Układ Logiczny: Basic Processor",
	quest.3ECDF40CC01FA01E.quest_desc: ["Wzbogacenie żelaza oraz miedzi czystym kwarcem nadaje metalom właściwości półprzewodnikowe. To podstawowy budulec obudów, kabli i podzespołów sieci Refined Storage."],
	quest.3ECDF40CC01FA01E.quest_subtitle: "Quartz Enriched Iron & Copper",
	quest.3ECDF40CC01FA01E.title: "Stopy Kwarcowe",
	quest.400E5AD3B2378A9F.quest_desc: ["Pozwala zarządzać kartami bezpieczeństwa i określać, którzy gracze mają prawo wglądu, modyfikacji lub rozbudowy Twojej sieci Refined Storage."],
	quest.400E5AD3B2378A9F.quest_subtitle: "1x Security Manager",
	quest.400E5AD3B2378A9F.title: "Zapora Sieciowa: Security Manager",
	quest.40D92BD3F935D0E8.quest_desc: ["Stałe źródło chłodu i lodu dla procesów termicznych."]
	quest.40D92BD3F935D0E8.quest_subtitle: "64x Snow Block",
	quest.40D92BD3F935D0E8.title: "Ekstruzja: Blok Śniegu",
	quest.42E44B6C8CDF031D.quest_desc: ["Każdy szanujący się inżynier potrzebuje zapasu arkuszy z cynku, andezytu, miedzi, żelaza oraz złota. Ustaw prasę nad taśmą lub zajezdnią i przygotuj partię pod budowę zaawansowanych podzespołów."],
	quest.42E44B6C8CDF031D.quest_subtitle: "Zestaw Blach Przemysłowych",
	quest.42E44B6C8CDF031D.title: "Walcownia Pełną Parą",
	quest.43D13FD7FDF29A61.quest_desc: ["Ręczne przenoszenie urobku między maszynami to strata cennego czasu. Połącz stanowiska pasami transmisyjnymi (Belts), zsypami (Chutes) oraz lejami (Funnels), by surowce płynęły same."],
	quest.43D13FD7FDF29A61.quest_subtitle: "Belt, Chute & Funnel",
	quest.43D13FD7FDF29A61.title: "Krwioobieg Fabryki: Taśmy i Zsypy",
	quest.4494D77B49C5F925.quest_desc: ["Zielonkawa skała miedzionośna. Po skruszeniu zasili Twoją fabrykę stałym dopływem miedzi."],
	quest.4494D77B49C5F925.quest_subtitle: "64x Veridium",
	quest.4494D77B49C5F925.title: "Ekstruzja: Veridium (Miedź)",
	quest.466DCFD1A0975A61.quest_desc: ["Standardowa rama konstrukcyjna dla wszystkich urządzeń cyfrowych Refined Storage. Od teraz Twoje maszyny zyskują dostęp do epoki informacyjnej."],
	quest.466DCFD1A0975A61.quest_subtitle: "1x Machine Casing",
	quest.466DCFD1A0975A61.title: "Fundament Sieci: Machine Casing",
	quest.4CA9892CF7949738.quest_desc: ["Najtwardsze szkliwo wulkaniczne produkowane automatycznie – idealne pod pył obsydianowy i wytrzymałe blachy (Sturdy Sheets)!"],
	quest.4CA9892CF7949738.quest_subtitle: "64x Obsidian",
	quest.4CA9892CF7949738.title: "Ekstruzja: Obsydian",
	quest.4DA40DA3D1519118.quest_desc: ["Gęsty łupek z najniższych warstw świata, gotowy do obróbki na powierzchni."]
	quest.4DA40DA3D1519118.quest_subtitle: "64x Deepslate",
	quest.4DA40DA3D1519118.title: "Ekstruzja: Łupek Głębinowy",
	quest.4DF90C1AA6BF4543.quest_desc: ["Gotowy dysk twardy 1k przeznaczony do montażu w stacji dysków (Disk Drive). Jeden mały kartridż zastępuje cały rząd drewnianych skrzyń."],
	quest.4DF90C1AA6BF4543.quest_subtitle: "1x 1k Storage Disk",
	quest.4DF90C1AA6BF4543.title: "Dysk Danych 1k",
	quest.5052424165D93DE0.quest_desc: ["Młot kowalski odchodzi do lamusa. Podłącz Mechanical Press do wału napędowego, aby błyskawicznie kuć sztabki metali w cienkie i wytrzymałe arkusze blachy."],
	quest.5052424165D93DE0.quest_subtitle: "1x Mechanical Press",
	quest.5052424165D93DE0.title: "Siła Nacisku: Prasa Mechaniczna",
	quest.51D3919CC88C4DC9.quest_desc: ["Podstawowa matryca pamięci zdolna zapisać strukturę 1024 przedmiotów w postaci czystych impulsów energetycznych."],
	quest.51D3919CC88C4DC9.quest_subtitle: "1x 1k Storage Part",
	quest.51D3919CC88C4DC9.title: "Pierwszy Kilobajt: Rdzeń 1k",
	quest.51F6702B4F6B62C7.quest_desc: ["Karmazynowa ruda bogata w żelazo. Zautomatyzuj jej kruszenie, a nigdy więcej nie zabraknie Ci stali i żelaza."],
	quest.51F6702B4F6B62C7.quest_subtitle: "64x Crimsite",
	quest.51F6702B4F6B62C7.title: "Ekstruzja: Crimsite (Żelazo)",
	quest.52773B62C578E4EF.quest_desc: ["Jasny wapień niezastąpiony w procesach hutniczych, chemicznych i architekturze przemysłowej."],
	quest.52773B62C578E4EF.quest_subtitle: "64x Limestone",
	quest.52773B62C578E4EF.title: "Ekstruzja: Wapień (Limestone)",
	quest.54E3834447E5148B.quest_desc: ["Magistrala przesyłowa łącząca odległe maszyny, interfejsy i terminale z głównym Kontrolerem sieci."],
	quest.54E3834447E5148B.quest_subtitle: "1x Cable",
	quest.54E3834447E5148B.title: "Światłowody i Przewody: Cable",
	quest.567698BFB097C64A.quest_desc: ["Rdzeń konwertujący rozbijane bloki i przedmioty bezpośrednio na zapis cyfrowy."],
	quest.567698BFB097C64A.quest_subtitle: "1x Destruction Core",
	quest.567698BFB097C64A.title: "Rdzeń Demontażu: Destruction Core",
	quest.61C0DE1432691045.quest_desc: ["Podstawowy urobek z połączenia wody i lawy. Fundament pod mielenie na żwir, piasek oraz żelazo."],
	quest.61C0DE1432691045.quest_subtitle: "64x Cobblestone",
	quest.61C0DE1432691045.title: "Ekstruzja: Bruk",
	quest.6313CA2B81D9D8A3.quest_desc: ["Pojemny nośnik 4k do stacji dysków. Zapewnia solidny bufor magazynowy dla rozrastającej się fabryki."],
	quest.6313CA2B81D9D8A3.quest_subtitle: "1x 4k Storage Disk",
	quest.6313CA2B81D9D8A3.title: "Dysk Danych 4k",
	quest.6416431155E7BCAB.quest_desc: ["Po co ryć pod ziemią, skoro możesz wytwarzać skały na powierzchni? Odpowiednie połączenie cieczy i bloków sąsiadujących z Ekstruderem pozwala generować niezliczone odmiany kamienia i rud mineralnych bez kiwnięcia kilofem!"],
	quest.6416431155E7BCAB.quest_subtitle: "Nieskończone Źródła Skał",
	quest.6416431155E7BCAB.title: "Kuźnia Geologiczna: Mechanical Extruder",
	quest.6A3A70C8DA59AFCF.quest_desc: ["Twarda skała magmowa pozyskiwana automatycznie bez niszczenia krajobrazu."],
	quest.6A3A70C8DA59AFCF.quest_subtitle: "64x Granite",
	quest.6A3A70C8DA59AFCF.title: "Ekstruzja: Granit",
	quest.6DB8129C82669E9C.quest_desc: ["Pierwszy sprawdzian Twojej linii montażowej. Połączenie miedzianych elementów za pomocą Deployera daje uszczelniony mechanizm niezbędny do budowy zaawansowanej aparatury płynowej."],
	quest.6DB8129C82669E9C.quest_subtitle: "1x Copper Mechanism"
	quest.6DB8129C82669E9C.title: "Miedziana Zębatka: Copper Mechanism",
	quest.70DF0552174AC3AB.quest_desc: ["Najwydajniejsza jednostka obliczeniowa, niezbędna do koordynowania całej sieci magazynowej i zarządzania jej zasilaniem."],
	quest.70DF0552174AC3AB.quest_subtitle: "1x Advanced Processor",
	quest.70DF0552174AC3AB.title: "Diamentowe Obliczenia: Advanced Processor",
	quest.711EF94B2C4CA981.quest_desc: ["Błękitna skała bogata w drobiny cynku. Przepuść ją przez młyny (Crushing Wheels), aby zyskać pasywne źródło cynku!"],
	quest.711EF94B2C4CA981.quest_subtitle: "64x Asurine",
	quest.711EF94B2C4CA981.title: "Ekstruzja: Asurine (Cynk)",
	quest.7490FF6AFDB54922.quest_desc: ["Odporna na korozję obudowa cynkowa to idealny fundament pod hybrydowe moduły magazynowe łączące mechanikę z cyfrowym zapisem danych."],
	quest.7490FF6AFDB54922.quest_subtitle: "1x Zinc Casing",
	quest.7490FF6AFDB54922.title: "Przemysłowa Rama: Obudowa Cynkowa",
	quest.752F142C980DF1DA.quest_desc: ["Układ o podwyższonej przepustowości, zdolny do równoczesnej obsługi wielu nośników pamięci w napędach dyskowych."],
	quest.752F142C980DF1DA.quest_subtitle: "1x Improved Processor",
	quest.752F142C980DF1DA.title: "Złota Architektura: Improved Processor",
	quest.76297780BCB4FB60.quest_desc: ["Twój pulpit dowodzenia zasobami. Pozwala jednym rzutem oka przeszukiwać, wkładać i wyciągać dowolne przedmioty zgromadzone na dyskach sieci."],
	quest.76297780BCB4FB60.quest_subtitle: "1x Grid",
	quest.76297780BCB4FB60.title: "Okno na Magazyn: Terminal (Grid)",
	quest.79ECF0D064F99464.quest_desc: ["Doskonałe źródło piasku i kwarcu po przepuszczeniu przez młyny kruszące."]
	quest.79ECF0D064F99464.quest_subtitle: "64x Sandstone",
	quest.79ECF0D064F99464.title: "Ekstruzja: Piaskowiec",
	quest.7C34541A2380C127.quest_desc: ["Złożony na taśmie mechanizm cynkowy stanowi pomost między prostą kinetyką a systemami magazynowymi wysokiej gęstości i pierwszymi układami cyfrowymi."],
	quest.7C34541A2380C127.quest_subtitle: "1x Zinc Mechanism",
	quest.7C34541A2380C127.title: "Cynkowy Rdzeń: Zinc Mechanism",
	quest.7EB9D1C19D161DF8.quest_desc: ["Indywidualna karta dostępu przypisywana konkretnemu inżynierowi w Menedżerze Bezpieczeństwa."],
	quest.7EB9D1C19D161DF8.quest_subtitle: "1x Security Card",
	quest.7EB9D1C19D161DF8.title: "Autoryzacja: Security Card"
}