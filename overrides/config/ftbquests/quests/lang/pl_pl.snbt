	quest.69439426534EBDC4.title: "&bBlazing Grips"
	quest.695889817162EFC7.quest_desc: ["Poddając &6Butelki Miodu&r rytuałowi &d&lInfuzji&r, przekształcisz je bezpośrednio w &aZaklęte Butelki z Doświadczeniem (Bottles o' Enchanting)&r!"]
	quest.695889817162EFC7.title: "Wytwarzanie &aEXP&r?"
	quest.696A33E7D91A487E.quest_desc: ["&9Cindaria&r to strażniczki Akropolu ciskające odbijającymi się od ścian włóczniami piorunów. Po śmierci upuszczają cenny surowiec &9Lacrima&r."]
	quest.696A33E7D91A487E.title: "&9Cindaria"
	quest.6996F3F5F20CC47C.quest_desc: ["Drugi obok miedzi najważniejszy metal Ery 1. Niezbędny do odlewania mosiądzu, cynkowych obudów oraz mechanicznych dłoni."]
