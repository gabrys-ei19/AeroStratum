	quest.6A452BFC8A967C39.quest_desc: ["&aFeral Claws&r zwiększają prędkość wyprowadzania ciosów każdą bronią oraz gołymi pięściami."]
	quest.6A452BFC8A967C39.quest_subtitle: "Dłonie"
	quest.6A452BFC8A967C39.title: "&aFeral Claws&r"
	quest.6A715F4AE22D2439.quest_desc: [
		"Widmowy płaszcz z pogranicza światów."
		""
		"• &7Grave Mist&r: Pozostawia za Tobą duszącą mgłę raniącą pościg."
		"• &bFrozen Gaze&r: Nakłada Osłabienie na wrogów, którzy patrzą prosto na Ciebie."
		"• &7Spectral Escape&r: Neguje śmiertelne uderzenie, wprowadzając Cię na kilka sekund w niematerialną formę!"
	]
	quest.6A715F4AE22D2439.quest_subtitle: "Pomiędzy światem żywych i umarłych"
