	quest.5F5E43B3F51CAE9E.quest_desc: ["&aSuperstitious Hat&r zapewnia dodatkowy poziom Grabieży (Looting) przy zabijaniu potworów – kumuluje się z zaklęciem na broni!"]
	quest.5F5E43B3F51CAE9E.quest_subtitle: "Głowa"
	quest.5F5E43B3F51CAE9E.title: "&aSuperstitious Hat"
	quest.5FBA199E0B7F1585.quest_desc: ["&9Octohost&r to symbiotyczny duet: ośmiornica &9Symbiocto&r oślepiająca atramentem z góry oraz kontrolowany przez nią utopiec &9Drowned Host&r atakujący wręcz."]
	quest.5FBA199E0B7F1585.title: "&9Octohost"
	quest.60850E717C747A78.quest_desc: ["Półki &9Sightshelf&r zwiększają liczbę widocznych zaklęć na liście podglądu przed zaklęciem przedmiotu."]
	quest.60850E717C747A78.title: "&3Wskazówki Zaklęć: Sightshelf"
	quest.60CECAAE2D43EC6E.quest_desc: [
		"Odłamek zatrzymanego czasu odnajdywany w ruinach Endu."
		""
		"• &dTransgression&r: Przytrzymanie klawisza aktywacji cofa Cię w czasie po Twojej własnej ścieżce sprzed kilku ostatnich sekund!"
	]
	quest.60CECAAE2D43EC6E.quest_subtitle: "Cofnij swoje ostatnie kroki"
	quest.60CECAAE2D43EC6E.title: "&5Clot of Time&r"
	quest.610A4F6E9A271976.quest_desc: ["Słoneczne monety (Suns) – najwyższa i najbardziej legendarna waluta w świecie AeroStratum."]
	quest.610A4F6E9A271976.quest_subtitle: "128x Sun"
	quest.610A4F6E9A271976.title: "Waluta: Słoneczne Suns"
	quest.61217D80BFF8A858.quest_desc: ["Trzeci, ostateczny wariant smyczy (&a75 Eterna&r, &c85% Quanta&r, &560–85% Arcana&r ze schwytaną Wiedźmą w środku). Jest całkowicie niezniszczalna i potrafi bezpośrednio przepisywać schwytane moby do spawnerów!"]
	quest.61217D80BFF8A858.quest_subtitle: "Bezpośredni zapis mobów do spawnera"
	quest.61217D80BFF8A858.title: "&5Occult Ender Lead"
	quest.61561E89EAFA3A4E.quest_desc: ["Sprzęg liniowy (&eTrack Coupler&r) pozwala na automatyczne łączenie i rozczepianie wagonów na wyznaczonych stacjach bez konieczności ręcznego manewrowania."]
	quest.61561E89EAFA3A4E.quest_subtitle: "1x Track Coupler"
	quest.61561E89EAFA3A4E.title: "Automatyczny Sprzęg: Track Coupler"
	quest.616551AAD11A8F3E.quest_desc: ["Cenne monety z brązu maszynowego (Cogs) dla zaawansowanych inwestorów i fabryk."]
	quest.616551AAD11A8F3E.quest_subtitle: "128x Cog"
	quest.616551AAD11A8F3E.title: "Waluta: Mosiężne Cogs"
	quest.61C0DE1432691045.quest_desc: ["Podstawowy urobek z połączenia wody i lawy. Fundament pod mielenie na żwir, piasek oraz żelazo."]
	quest.61C0DE1432691045.quest_subtitle: "64x Cobblestone"
	quest.61C0DE1432691045.title: "Ekstruzja: Bruk"
	quest.62089E9E6D596DA7.quest_desc: ["Przekucie młota &3The Annihilator&r ze sztabką &bIgnitium&r tworzy &3The &bImmolator&r – broń zadającą ogromne obrażenia celom naznaczonym płomieniem i wywołującą eksplozje ognia!"]
	quest.62089E9E6D596DA7.title: "&3The &bImmolator"
	quest.6220EDE42C813C1B.quest_desc: ["Masz dość zużywających się amuletów mikstur (&eCharms&r)? Przeprowadź ich &d&lInfuzję&r przy &a100 Eterna&r, &c8,5–13,5% Quanta&r oraz &532,5–37,5% Arcana&r, aby stały się całkowicie niezniszczalne!"]
	quest.6220EDE42C813C1B.title: "Niezniszczalne &eAmulety"
	quest.623796B1D7981E59.quest_desc: ["&4Crystal Heart&r na stałe zwiększa Twoje maksymalne zdrowie o dodatkowe serca, dopóki masz je założone."]
	quest.623796B1D7981E59.quest_subtitle: "Pas"
	quest.623796B1D7981E59.title: "&4Crystal Heart&r"
	quest.624F528C7A37B331.quest_desc: ["Skalibrowany, dostrojony kryształ (Tuned Crystal) – niezwykle precyzyjny komponent łączący zaawansowaną optykę z czystą energią rezonansową kryształów ametystu."]
	quest.624F528C7A37B331.quest_subtitle: "1x Tuned Crystal"
	quest.624F528C7A37B331.title: "Rezonator Kwarcowy: Tuned Crystal"
	quest.62622137648A4F56.quest_desc: ["Podczas noszenia &7Pickaxe Heater&r wykopywane rudy metali są automatycznie przetapiane na sztabki!"]
	quest.62622137648A4F56.quest_subtitle: "Dłonie"
	quest.62622137648A4F56.title: "&7Pickaxe Heater&r"
	quest.62C32905C33E2D88.quest_desc: ["&dEye of Void&r zaprowadzi Cię w pustce Endu do &dRuined Citadel&r, której strzeże &d&lEnder Guardian&r."]
	quest.62C32905C33E2D88.title: "&dEye of Void&r"
	quest.62D39F68DE6E44A4.quest_desc: ["&5Arcana&r (domyślnie 0%, maks. 100%) zwiększa liczbę otrzymywanych naraz zaklęć oraz sprawia, że rzadkie zaklęcia (takie jak Grabież czy Szczęście) pojawiają się znacznie częściej."]
	quest.62D39F68DE6E44A4.title: "Parametr: &5Arcana"
	quest.62DF58D36B739EA0.quest_desc: ["&eWadjet&r to drugi mini-boss piramidy, ciskający burzami piaskowymi i zrzucający bloki piasku ze stropu."]
	quest.62DF58D36B739EA0.title: "&eWadjet"
	quest.6313CA2B81D9D8A3.quest_desc: ["Pojemny nośnik 4k do stacji dysków. Zapewnia solidny bufor magazynowy dla rozrastającej się fabryki."]
	quest.6313CA2B81D9D8A3.quest_subtitle: "1x 4k Storage Disk"
	quest.6313CA2B81D9D8A3.title: "Dysk Danych 4k"
	quest.631796E7615C04FA.quest_desc: ["&2Amethyst Crab&r to neutralny mini-boss z Bujnych Jaskiń. Po pokonaniu upuszcza mięso (które można pobłogosławić na ołtarzu ametystu) oraz skorupę do wykucia naramienników Bloom Stone Pauldrons."]
	quest.631796E7615C04FA.title: "&2Amethyst Crab&r"
	quest.63CAD77A4488F2CE.quest_desc: ["Forma do odlewania głowicy Paxela – uniwersalnego narzędzia łączącego kilof, siekierę oraz łopatę w jednym!"]
	quest.63CAD77A4488F2CE.quest_subtitle: "Kilof + Siekiera + Łopata"
	quest.63CAD77A4488F2CE.title: "Forma: Paxel (Paxel Cast)"
	quest.63CB5961BE31AA90.quest_desc: ["Połączenie mosiężnej obudowy z precyzyjnymi mechanizmami tworzy Brass Machine – fundament pod ciężkie maszyny montażowe, kruszarki oraz zaawansowaną logistykę Ery 2."]
	quest.63CB5961BE31AA90.quest_subtitle: "1x Brass Machine"
	quest.63CB5961BE31AA90.title: "Mosiężny Fundament: Brass Machine"
	quest.64141B720662B652.quest_desc: [
		"Modyfikacja &6&lRelics&r wprowadza potężne artefakty rozwijające się wraz z Twoją postacią!"
		""
		"Przytrzymaj klawisz &e[ Shift ]&r na znalezionym relikcie, aby otworzyć &6Okno Badań (Research Window)&r. Możesz w nim odblokowywać umiejętności, przelosowywać ich początkową jakość za zwykłe XP oraz podnosić ich poziomy dzięki punktom doświadczenia reliktu!"
	]
	quest.64141B720662B652.title: "&l&6Relics: System Rozwoju"
	quest.6416431155E7BCAB.quest_desc: ["Po co ryć pod ziemią, skoro możesz wytwarzać skały na powierzchni? Odpowiednie połączenie cieczy i bloków sąsiadujących z Ekstruderem pozwala generować niezliczone odmiany kamienia i rud mineralnych bez kiwnięcia kilofem!"]
	quest.6416431155E7BCAB.quest_subtitle: "Nieskończone Źródła Skał"
	quest.6416431155E7BCAB.title: "Kuźnia Geologiczna: Mechanical Extruder"
	quest.648E38F45D52F906.quest_desc: ["Napędzana obrotami głowica miksująca. W połączeniu z kadzią (Basin) oraz palnikiem Płomyka pozwala wytwarzać kauczuk i wytapiać mosiądz."]
	quest.648E38F45D52F906.quest_subtitle: "1x Mechanical Mixer"
	quest.648E38F45D52F906.title: "Alchemia Obrotów: Mikser Mechaniczny"
	quest.655FF7295B688354.quest_desc: ["&9Clawdian&r to potężny mini-boss Akropolu – gigantyczny homar dzierżący wielki topór i wywołujący fale uderzeniowe."]
	quest.655FF7295B688354.title: "&9Clawdian"
	quest.657B3116A6419420.quest_desc: ["Forma do odlewania metalowych trzonków narzędziowych zastępujących zwykłe patyki."]
	quest.657B3116A6419420.quest_subtitle: "Solidny trzonek!"
	quest.657B3116A6419420.title: "Forma: Trzonek (Tool Rod Cast)"
	quest.6667638252DB9C74.quest_desc: ["&8Pieczęcie (Sigils)&r służą do modyfikowania ekwipunku z afiksami – pozwalają dodawać gniazda, wyciągać klejnoty oraz ulepszać statystyki w Stole Kowalskim, Stole Przekuwania lub Stole Augmentacji."]
	quest.6667638252DB9C74.quest_subtitle: "Baza pod pieczęcie"
	quest.6667638252DB9C74.title: "&8Gem-Fused Slate i Pieczęcie"
	quest.67216EC5274F08B9.quest_desc: ["Forma do odlewania wytrzymałych nożyc modułowych."]
