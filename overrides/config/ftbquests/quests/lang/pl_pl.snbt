	quest.680D49E2B3929322.quest_desc: ["&eVitality Ankh&r wzmacnia naturalną regenerację i leczenie podczas starć z bossami."]
	quest.680D49E2B3929322.title: "&eVitality Ankh"
	quest.683C260C854C5AA3.quest_desc: ["&4Mechanical Fusion Anvil&r to niezniszczalne kowadło pozwalające łączyć ze sobą trofea i bronie z różnych bossów Cataclysm w ostateczny oręż hybrydowy!"]
	quest.683C260C854C5AA3.title: "&4Mechanical Fusion Anvil"
	quest.6842600FC1293062.quest_desc: ["Zejdź pod ziemię, odnajdź naturalną geodę ametystową i spójrz bezpośrednio na blok Kiełkującego Ametystu (Budding Amethyst) znajdujący się w jej wnętrzu."]
	quest.6842600FC1293062.quest_subtitle: "Spójrz na Budding Amethyst"
	quest.6842600FC1293062.title: "Poszukiwacz Geod"
	quest.6852BEFDD4DE4E4B.quest_desc: ["Połączenie &9Deepshelf&r z latarnią dusz i blokami Sculku daje &9Soul-Touched Deepshelf&r (&c+15% Quanta&r oraz limit &a75 Eterna&r)."]
	quest.6852BEFDD4DE4E4B.title: "&9Soul-Touched Deepshelf"
	quest.6884E25641A1020C.quest_desc: [
		"&5Enchantment Library&r to najlepsze archiwum na zaklęte księgi!"
		""
		"Wrzucaj do niej wszystkie znalezione księgi – biblioteka zamieni je na punkty i pozwoli jednym kliknięciem wyciągać gotowe kombinacje zaklęć aż do najwyższego odkrytego przez Ciebie poziomu (mieści do 32 768 punktów na każde zaklęcie)."
	]
	quest.6884E25641A1020C.title: "&5Enchantment Library"
	quest.689F32883C4E9502.quest_desc: [
		"&4&lCataclysm&r wprowadza potężnych bossów, rozbudowane lochy oraz legendarny ekwipunek bojowy."
		""
		"Nie ma sztywnej kolejności pokonywania bossów, jednak niektórzy są znacznie groźniejsi od pozostałych. Wykorzystaj specjalne Oczy, aby zlokalizować ukryte w świecie fortece i świątynie!"
	]
	quest.689F32883C4E9502.title: "&4&lCataclysm"
	quest.6912C0E3D092DD27.quest_desc: ["Forma do odlewania płyt butów."]
