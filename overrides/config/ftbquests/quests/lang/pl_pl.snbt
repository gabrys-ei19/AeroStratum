	quest.6BBC440BD0AD0E93.quest_desc: [
		"W tej paczce modułowe narzędzia &9&lSilent Gear&r zostały połączone z wieloblokową odlewnią &c&lProductive Metalworks&r!"
		""
		"Zamiast wycinać części z papierowych szablonów, będziesz odlewać je z płynnych metali za pomocą stalowych form (&8Casts&r). Rozpocznij budowę odlewni od wytworzenia gliny ogniotrwałej (&cFire Clay&r)."
	]
	quest.6BBC440BD0AD0E93.title: "&9&lSilent Gear&r i &c&lProductive Metalworks"
	quest.6BC3CF8937DEDE89.quest_desc: ["Połączenie &cInfernal Forge&r z &dVoid Core&r tworzy &dVoid &cForge&r – młoto-kilof wywołujący wachlarz run próżni przy uderzeniu w ziemię!"]
	quest.6BC3CF8937DEDE89.title: "&dVoid &cForge"
	quest.6BD6050862596B7F.quest_desc: ["Wzmocnienie plecaka żelaznymi płytami znacząco powiększa jego pojemność podczas długich wypraw górniczych."]
