	quest.001C1881E9289566.quest_subtitle: "&9Rare"
	quest.001C1881E9289566.title: "&9Luminous Crystal Shard"
	quest.002D65E4D7E8F62B.quest_desc: ["Katalizator 2. poziomu do urządzenia Material Grader, pozwalający osiągać wyższe oceny surowców."]
	quest.002D65E4D7E8F62B.title: "Katalizator Gradera II: Blazing Dust"
	quest.0089A394566B0F3B.quest_desc: [
		"&aUncommon (Niepospolity)&r to druga klasa rzadkości, najczęstsza na poziomie świata &2Frontier&r."
		""
		"&aTimeworn Fabric&r pozyskasz poprzez rozbiórkę niepospolitego ekwipunku na &c&lStole Rozbiórki&r."
	]
	quest.0089A394566B0F3B.quest_subtitle: "&aUncommon"
	quest.0089A394566B0F3B.title: "&aTimeworn Fabric"
	quest.00A1223DAAEB28BD.quest_desc: ["Forma do odlewania metalowych prętów konstrukcyjnych."]
	quest.00A1223DAAEB28BD.title: "Forma: Pręt (Rod Cast)"
	quest.00C26068B55F4FD9.quest_desc: ["Runa Ciszy całkowicie wyłącza dźwięki wydawane przez spawner oraz przyzywane z niego stworzenia. Idealne rozwiązanie do głośnych hal produkcyjnych!"]
	quest.00C26068B55F4FD9.title: "Cisza na Hali!"
	quest.010607466D565B53.quest_desc: ["&aRooted Boots&r stojąc na trawie powoli odnawiają punkty głodu i zdrowia, pobierając składniki odżywcze z podłoża."]
	quest.010607466D565B53.quest_subtitle: "Stopy"
	quest.010607466D565B53.title: "&aRooted Boots"
	quest.01AFC11EAAB6CB3B.quest_desc: ["&eBone Reptile Armor&r wykuty z kości, Starożytnego Metalu oraz czaszki Kobolediatora zapewnia wysoką obronę i odporność na odrzut."]
	quest.01AFC11EAAB6CB3B.title: "&eBone Reptile Armor"
	quest.0223CC1700D49B6C.quest_desc: [
		"Połączenie mosiądzu z układami redstone tworzy zaawansowany moduł sterujący."
		""
		"To serce inteligentnej automatyki – od filtrujących zsypów i sekwenserów, aż po terminale rzemieślnicze i autocraftery Refined Storage."
	]
	quest.0223CC1700D49B6C.quest_subtitle: "1x Brass Redstone Machine"
	quest.0223CC1700D49B6C.title: "Mosiężna Logika: Brass Redstone Machine"
	quest.0251715AB65D8151.quest_desc: ["Forma do odlewania klejnotów i kryształów na stole odlewniczym."]
	quest.0251715AB65D8151.title: "Forma: Klejnot (Gem Cast)"
	quest.02E1E48521F85EF6.quest_desc: [
		"Potężne, zbrojone koła kruszące składane na Mechanicznym Crafterze."
		""
		"Obracając się naprzeciw siebie, mielą skały i rudy z ogromną prędkością, zapewniając dodatkowy uzysk surowców oraz dostęp do cennych pyłów."
	]
	quest.02E1E48521F85EF6.quest_subtitle: "2x Crushing Wheel"
	quest.02E1E48521F85EF6.title: "Ciężkie Kruszarki: Crushing Wheels"
	quest.035A4D63CB792F6E.quest_desc: ["Precyzyjne przeguby wykute z blachy cynkowej pozwalają naśladować ruch ludzkiej dłoni. To kluczowy element każdego automatycznego ramienia montażowego."]
	quest.035A4D63CB792F6E.quest_subtitle: "1x Zinc Hand"
	quest.035A4D63CB792F6E.title: "Mechaniczny Chwyt: Cynkowa Dłoń"
	quest.036D5767E07005BC.quest_desc: ["&bFoundry Drain&r pozwala wyprowadzać stopiony metal na zewnątrz pieca. Zamontuj na nim kranik (&7Foundry Tap&r) lub podłącz rury płynowe!"]
	quest.036D5767E07005BC.title: "&c&lFoundry&r &bDrains"
	quest.037A93600E70561C.quest_desc: ["Unikalny moduł integrujący fizyczną pojemność szuflad ze strukturą dysków i bloków pamięci Refined Storage. Niezbędny komponent do zamknięcia każdego nośnika danych."]
	quest.037A93600E70561C.quest_subtitle: "1x Digital Drawer"
	quest.037A93600E70561C.title: "Hybrydowy Bufor: Digital Drawer"
	quest.046B84EA84A40FA7.quest_desc: [
		"Kiełkujący Ametyst (Budding Amethyst) to żywe serce geody, na którym nieustannie odrastają nowe kryształy."
		""
		"Zabezpiecz go na miejscu lub stwórz własny za pomocą rytuału infuzji, aby zautomatyzować zbiory odłamków ametystu!"
	]
	quest.046B84EA84A40FA7.quest_subtitle: "1x Budding Amethyst"
	quest.046B84EA84A40FA7.title: "Serce Geody: Kiełkujący Ametyst"
	quest.047F3F99035CE623.quest_desc: ["Forma do odlewania młotka geologicznego wykrywającego złoża rud w ścianach jaskiń."]
	quest.047F3F99035CE623.quest_subtitle: "Poszukiwacz złóż"
	quest.047F3F99035CE623.title: "Forma: Młotek Geologa (Prospector Hammer)"
	quest.0496E8E786262464.quest_desc: ["Nadziemny świat (&2Overworld&r) skrywa aż 5 monumentalnych struktur zamieszkiwanych przez pradawnych bossów Cataclysm."]
	quest.0496E8E786262464.title: "&2Overworld&r: Kraina 5 Bossów"
	quest.04B40BB107F14330.quest_desc: ["&4Meat Shredder&r to mechaniczna piła tarczowa zadająca błyskawiczne obrażenia ciągłe przy przytrzymaniu prawego przycisku myszy."]
	quest.04B40BB107F14330.quest_subtitle: "Ciężka piła mechaniczna"
	quest.04B40BB107F14330.title: "&4Meat Shredder"
	quest.04C59391A677A292.quest_desc: ["Pusta, pancerna kaseta ochronna gotowa na przyjęcie rdzenia pamięci. Chroni delikatne układy kwarcowe przed uszkodzeniem."]
	quest.04C59391A677A292.quest_subtitle: "1x Storage Housing"
	quest.04C59391A677A292.title: "Kieszeń na Dane: Storage Housing"
	quest.0518551637F76C50.quest_desc: ["Ulepszenie &9Deepshelf&r świecami oraz Odłamkami Echa (Echo Shards) zapewnia &5+15% Arcana&r i podnosi limit Eterna do &a75&r."]
	quest.0518551637F76C50.title: "&9Echoing Deepshelf"
	quest.05DD778297C6611B.quest_desc: ["Diamentowe wzmocnienia dają ogromną przestrzeń ładunkową i miejsce na zaawansowane moduły ulepszeń. Z takim plecakiem możesz przenieść pół fabryki na własnych plecach."]
	quest.05DD778297C6611B.quest_subtitle: "Najsilniejszy tragarz w ekipie"
	quest.05DD778297C6611B.title: "Diamentowy Plecak"
	quest.05DE9E1CDFBC22DE.quest_desc: ["&dVoid Scatter Arrows&r przy trafieniu w cel rozpadają się na deszcz odłamków raniących wszystkich wrogów wokół."]
	quest.05DE9E1CDFBC22DE.title: "&dVoid Scatter Arrows"
	quest.060CAF1582B83918.quest_desc: ["&eOccupied Village&r to pustynna wioska przejęta przez &eKoboletony&r oraz &eWadjeta&r. Uwolnij uwięzionych osadników i przeszukaj skrzynie!"]
	quest.060CAF1582B83918.title: "&eOccupied Village"
	quest.061307A9C70E47B4.quest_desc: ["Podgrzana kadź z mikserem pozwala stopić miedź i cynk w szlachetny mosiądz. Ten stop otwiera drogę do filtrowania, inteligentnych maszyn oraz precyzyjnej automatyki."]
	quest.061307A9C70E47B4.quest_subtitle: "1x Brass Ingot"
	quest.061307A9C70E47B4.title: "Złoto Inżynierów: Stop Mosiądzu"
	quest.061A51A0EC13CA0F.quest_desc: [
		"Aby zamknąć strukturę wieloblokową Odlewni:"
		""
		"1. Ułóż podłogę z bloków grzewczych &6Liquid Heating Coils&r."
		"2. Wznieś 4 ściany wokół podłogi (narożniki mogą pozostać puste) z cegieł &cFire Bricks&r lub okien &cFoundry Windows&r."
		"3. Wmontuj w ściany &aController&r, &4Tank&r oraz &bDrain&r."
		""
		"Gdy struktura jest poprawna, kontroler zapali się, a grzałki na dnie zmienią kolor na pomarańczowy!"
	]
	quest.061A51A0EC13CA0F.title: "Budowa &c&lOdlewni (Foundry)&r"
	quest.06F70F6CA37168CC.quest_desc: ["&6&oGem Case of House Fabergé&r powstaje przez infuzję zwykłego Gem Case i mieści do 2,1 miliarda sztuk każdego unikalnego klejnotu!"]
	quest.06F70F6CA37168CC.quest_subtitle: "Gustav Fabergé byłby dumny"
	quest.06F70F6CA37168CC.title: "&6&oGem Case of House Fabergé"
	quest.073D0D41BA5F219B.quest_desc: [
		"Tarcza wymagająca idealnego wyczucia czasu."
		""
		"• &4Retaliation&r: Aktywowana w ostatniej chwili całkowicie paruje nadchodzące uderzenie i kontratakuje napastnika (nieudana parada na chwilę zwiększa podatność na obrażenia)."
	]
	quest.073D0D41BA5F219B.quest_subtitle: "+ PAROWANIE"
	quest.073D0D41BA5F219B.title: "&cShield of Retaliation"
	quest.0741FABE57CA1A7D.quest_desc: ["&9Hippocamtus&r to opancerzony wojownik z tarczą i włócznią strzegący Akropolu. Podobnie jak Cindaria, upuszcza &9Lacrima&r."]
	quest.0741FABE57CA1A7D.title: "&9Hippocamtus"
	quest.0794B19AAB6261EF.quest_desc: ["Połącz ociosane drewno ze Stopem Andezytowym (Andesite Alloy), klikając stopem na postawione drewno lub łącząc je w stole rzemieślniczym. Gratulacje – masz oficjalny korpus, który potrafi utrzymać w miejscu koła zębate i tłoki bez rozpadania się konstrukcji."]
	quest.0794B19AAB6261EF.quest_subtitle: "5x Andesite Casing"
	quest.0794B19AAB6261EF.title: "Andezytowa Obudowa"
	quest.083ABBA1C45FF960.quest_desc: ["Forma do odlewania sierpa ścinającego plony i wysoką trawę na dużym obszarze."]
	quest.083ABBA1C45FF960.quest_subtitle: "Żniwa pełną parą"
	quest.083ABBA1C45FF960.title: "Forma: Sierp (Sickle Cast)"
	quest.083ED9A55CB6F690.quest_desc: [
		"Nie pozwól, aby Creepery zniszczyły Twoje ciężko zarobione maszyny i skrzynki. Może to też uchronić Cię przed kradzieżą, jeśli grasz ze znajomymi!"
		""
		"Otwórz mapę świata klawiszem [ M ]."
		""
		"Kliknij ikonę trzech nakładających się kwadratów w lewym górnym rogu (Claimed Chunks)."
		""
		"Klikaj lewym przyciskiem myszy na kwadraty (chunki), aby je zająć. Staną się bezpieczne."
		""
		"Przytrzymaj [ Shift ] + kliknij LPM na zajęty chunk, aby go załadować na stałe (Force Load). Dzięki temu Twoje farmy i maszyny będą działać, nawet gdy pójdziesz na daleką wyprawę!"
	]
	quest.083ED9A55CB6F690.quest_subtitle: "(Zabezpiecz bazę)"
	quest.083ED9A55CB6F690.title: "Moje na zawsze!"
	quest.0853917693A259C2.quest_desc: ["&3The Annihilator&r to ciężki młot bojowy – trzymając po jednym w każdej dłoni i przytrzymując PPM, wykonasz potężne uderzenie sejsmiczne w ziemię!"]
	quest.0853917693A259C2.title: "&3The Annihilator"
	quest.0864368D14D8B122.quest_desc: ["Czujnik torowy (&eTrack Observer&r) wysyła impuls Redstone, gdy przejeżdża nad nim pociąg, co pozwala w pełni zautomatyzować przejazdy, zwrotnice i automatykę stacyjną."]
	quest.0864368D14D8B122.quest_subtitle: "1x Track Observer"
	quest.0864368D14D8B122.title: "Sygnalizator Przejazdu: Track Observer"
	quest.0894EB1F3FCFCECA.quest_desc: ["&3Draugrowie&r (zwykli, Royal oraz Elite) to nieumarli wojownicy północy posługujący się orężem i tarczami z Czarnej Stali (Black Steel)."]
	quest.0894EB1F3FCFCECA.title: "&3Draugrs"
	quest.091957223C32B094.quest_desc: ["Aby wejść w etap półek głębinowych (Deepshelves), podnieś limit &aMax Eterna&r do &a60&r, aktywując poziom świata &e&lAscent&r."]
	quest.091957223C32B094.quest_subtitle: "Max Eterna: 60"
	quest.091957223C32B094.title: "&e&lAscent&r do 60 Eterna"
	quest.0931562098210538.quest_desc: ["Podaj Płomykowi słomkę, a zamiast paliw stałych będzie mógł pić płynne paliwa, oleje i lawę doprowadzone prosto rurociągiem!"]
	quest.0931562098210538.quest_subtitle: "4x Straw"
	quest.0931562098210538.title: "Płynne Paliwo: Słomki dla Płomyków"
	quest.093786ED188CB158.quest_desc: ["Czterokrotnie większa gęstość upakowania danych. Idealny wybór, gdy urobek z automatycznych kopalni zaczyna liczyć się w tysiącach."]
	quest.093786ED188CB158.quest_subtitle: "1x 4k Storage Part"
	quest.093786ED188CB158.title: "Gęstszy Zapis: Rdzeń 4k"
	quest.0947B4ED95B0267E.quest_desc: ["Powłoka ochronna (Coating) nakładana na wierzch gotowej broni lub narzędzia (np. powłoka z netherytu)."]
	quest.0947B4ED95B0267E.quest_subtitle: "Zewnętrzna warstwa ochronna"
	quest.0947B4ED95B0267E.title: "Szablon: Powłoka (Coating Blueprint)"
	quest.0961A1F2AC4E3A5B.quest_desc: [
		"Świat, w którym się znalazłeś, skrywa mroczne tajemnice. Pradawne, monstrualne bestie (z moda Cataclysm) śpią głęboko w gigantycznych strukturach – w ruinach na dnie oceanów, w płonących zamkach w Netherze czy w pustkach Endu."
		""
		"Nie próbuj z nimi walczyć na początku gry. Bez pełnego netherytowego pancerza, potężnych mieczy i zapasu mikstur, te potwory zniszczą Cię jednym uderzeniem. Eksploruj ostrożnie, przygotuj się dobrze i dopiero wtedy ruszaj po ich legendarne dropy!"
	]
	quest.0961A1F2AC4E3A5B.title: "Ostrzeżenie: Cienie w ciemności"
	quest.097FDC136BC843A7.quest_desc: [
		"Poziom &6&lSummit&r wymaga założenia pełnego rynsztunku rangi &9Rare&r (lub wyższej) oraz pokonania &0&lWithera&r."
		""
		"• Odblokowuje łupy &6Mythic&r oraz klejnoty &zPerfect&r!"
		"• Premie gracza: +75% XP, +50% Szczęścia, limit &a75 Eterna&r"
		"• Wzmocnienie potworów: +12 Pancerza, +10 Wytrzymałości Zbroi, +15 Przebicia"
	]
	quest.097FDC136BC843A7.title: "&lWorld Tier: &6Summit"
	quest.099C2A9B9CA138F8.quest_desc: [
		"&6Mythic (Mityczny)&r to najwyższa klasa przedmiotów, dostępna wyłącznie na poziomach świata &6Summit&r oraz &4Pinnacle&r!"
		""
		"&6Godforged Pearls&r pozyskasz z rozbiórki mitycznego rynsztunku na &c&lStole Rozbiórki&r."
	]
	quest.099C2A9B9CA138F8.quest_subtitle: "&6Mythic"
	quest.099C2A9B9CA138F8.title: "&6Godforged Pearl"
	quest.0A1D4228271DECA3.quest_desc: ["Zmniejsza rozmiar Twojej postaci o połowę, pozwalając swobodnie przechodzić przez szczeliny o wysokości 1 bloku."]
	quest.0A1D4228271DECA3.quest_subtitle: "Naszyjnik"
	quest.0A1D4228271DECA3.title: "&5Charm of Shrinking&r"
	quest.0A3C464EF7CDD5F6.quest_desc: [
		"&4Hellshelves&r wprowadzają parametr &cQuanta&r – każda daje &a+3 Eterna&r oraz &c+3% Quanta&r."
		""
		"Do kolejnego kroku potrzebujesz 15 takich półek ustawionych wokół stołu oraz 1 sztuki w ekwipunku do przeprowadzenia infuzji."
	]
	quest.0A3C464EF7CDD5F6.title: "&4Hellshelves"
	quest.0A43D38D27CF4304.quest_desc: ["&3Abandoned Spire&r to mniejsza mroźna warownia zamieszkiwana przez nieumarłych &3Draugrów&r oraz potężnego &3Aptrgangra&r."]
	quest.0A43D38D27CF4304.title: "&3Abandoned Spire"
	quest.0B7F2B63D867D221.quest_desc: ["W bocznych komnatach szybu prowadzącego na dno piramidy użyj Pędzla (Brush) na Podejrzanym Piasku, aby wydobyć &eNecklace of the Desert&r i przebudzić nim bossa!"]
	quest.0B7F2B63D867D221.quest_subtitle: "Przebudzenie Ancient Remnant"
	quest.0B7F2B63D867D221.title: "&eNecklace of the Desert"
	quest.0B98C898071F3C33.quest_desc: ["Zwykłe ognisko nie wystarczy do wytopu szlachetnych stopów. Wykuj żelazny kosz palnika, udaj się do Netheru i schwytaj w niego Płomyka (Blaze'a), aby zyskać kontrolowane źródło ekstremalnej temperatury."]
	quest.0B98C898071F3C33.quest_subtitle: "1x Empty Blaze Burner"
	quest.0B98C898071F3C33.title: "Klatka na Żywioł"
	quest.0BFD8B6ECABADB11.quest_desc: ["Metalowa trzepaczka montowana w mikserze mechanicznym. Pozwala błyskawicznie łączyć ciecze, żywice i roztopione metale."]
	quest.0BFD8B6ECABADB11.quest_subtitle: "1x Whisk"
	quest.0BFD8B6ECABADB11.title: "Wirujące Łopatki: Trzepaczka"
	quest.0C16D28641468295.quest_desc: ["Automatyczny konstruktor (Constructor) pobiera bloki z sieci Refined Storage i stawia je w świecie przed sobą."]
	quest.0C16D28641468295.quest_subtitle: "1x Constructor"
	quest.0C16D28641468295.title: "Automatyczny Budowniczy: Constructor"
	quest.0C6ADA0C7F766E65.quest_desc: ["Ciemna skała wulkaniczna wytwarzana na żądanie bez wypraw do Netheru."]
	quest.0C6ADA0C7F766E65.quest_subtitle: "64x Basalt"
	quest.0C6ADA0C7F766E65.title: "Ekstruzja: Bazalt"
	quest.0D26E5EF6CFCFDBF.quest_desc: ["Forma do odlewania ostrza noża – wysoka wytrzymałość i szybkie cięcia."]
	quest.0D26E5EF6CFCFDBF.quest_subtitle: "Krótkie ostrze"
	quest.0D26E5EF6CFCFDBF.title: "Forma: Nóż (Knife Cast)"
	quest.0DF4B01CC5B49E4E.quest_desc: ["Forma do odlewania klasycznej głowni miecza – zrównoważone obrażenia i prędkość ataku."]
	quest.0DF4B01CC5B49E4E.quest_subtitle: "Niezawodny klasyk"
	quest.0DF4B01CC5B49E4E.title: "Forma: Miecz (Sword Cast)"
	quest.0E02CE4469FCA4C9.quest_desc: ["Dodaje do spawnera wyłącznik zasilania. Po zaaplikowaniu tej runy spawner będzie działał wyłącznie wtedy, gdy doprowadzisz do niego sygnał Redstone."]
	quest.0E02CE4469FCA4C9.title: "Sterowanie Redstone"
	quest.0E1BC2AE1BE0BDFA.quest_desc: ["W Bujnych Jaskiniach (Lush Caves) możesz natknąć się na &2Amethyst Nest&r – gniazdo zamieszkiwane przez gigantycznego kraba ametystowego."]
	quest.0E1BC2AE1BE0BDFA.title: "&2Amethyst Nest"
	quest.0E1BC2AE1BE1BDFA.quest_desc: ["W Bujnych Jaskiniach (Lush Caves) możesz natknąć się na &2Amethyst Nest&r – gniazdo zamieszkiwane przez gigantycznego kraba ametystowego."]
	quest.0E716B90E60C486B.quest_desc: ["&4Panic Necklace&r zapewnia zastrzyk prędkości ruchu natychmiast po otrzymaniu obrażeń, pozwalając szybko wycofać się z zagrożenia."]
	quest.0E716B90E60C486B.quest_subtitle: "Naszyjnik"
	quest.0E716B90E60C486B.title: "&4Panic Necklace&r"
	quest.0E809204C288AAE9.quest_desc: ["Zwykły stół rzemieślniczy ma swoje granice. Zestawienie co najmniej 9 Mechanicznych Crafterów w jedną matrycę pozwala składać wielkogabarytowe części maszyn, takie jak Koła Kruszące!"]
	quest.0E809204C288AAE9.quest_subtitle: "9x Mechanical Crafter"
	quest.0E809204C288AAE9.title: "Matryca Montażowa: Mechanical Crafter"
	quest.0E90577AC72749C4.quest_desc: [
		"&6Thundering Spawner Upgrade Rune&r to czwarty, ostateczny poziom ulepszenia spawnera (wymaga klejnotu Endersurge z wymiaru Endu):"
		""
		"• Minimalne i maksymalne opóźnienie: 20 ticków (1 sekunda!)"
		"• Liczba mobów na cykl: 16"
		"• Limit pobliskich bytów: 32"
		"• Zasięg aktywacji gracza: 48 kratek"
	]
	quest.0E90577AC72749C4.title: "Runa Ulepszenia IV: Pinnacle"
	quest.0EE0946240B41A00.quest_desc: ["&bIgnitium Armor&r zapewnia widzenie pod lawą (hełm), możliwość połączenia z Elytrą (napierśnik), szybsze gaśnięcie płomieni (nogawice) oraz chodzenie po powierzchni lawy (buty)!"]
	quest.0EE0946240B41A00.title: "&bIgnitium Armor"
	quest.0EF9F10A2178451F.quest_desc: ["Wszystkie cegły i bloki konstrukcyjne odlewni można barwić na dowolny kolor – poszczególne kolory można też swobodnie mieszać w jednej strukturze!"]
	quest.0EF9F10A2178451F.title: "&zKolorowe Bloki &c&lOdlewni&r"
	quest.0F0E227FC3EC0D90.quest_desc: ["Alternatywne systemy przyzywania stworzeń oraz zestalania płynnego doświadczenia wspomagające automatyzację fabryki."]
	quest.0F0E227FC3EC0D90.title: "Przemysłowe Spawnowanie"
	quest.0F3A0A4DC18E5E55.quest_desc: [
		"&aEterna&r określa bazowy poziom zaklinania (siłę oferowanych zaklęć). Maksymalny limit Eterna zależy od Twojego aktualnego &lPoziomu Świata (World Tier)&r:"
		""
		"• &a30&r na poziomie &9&lHaven&r"
		"• &a45&r na poziomie &2&lFrontier&r"
		"• &a60&r na poziomie &e&lAscent&r"
		"• &a75&r na poziomie &6&lSummit&r"
		"• &a100&r na poziomie &4&lPinnacle&r"
	]
	quest.0F3A0A4DC18E5E55.title: "Parametr: &aEterna"
	quest.0F89BFD4A3F63A48.quest_desc: ["Sprawia, że spawner całkowicie ignoruje poziom oświetlenia – wrogie potwory będą pojawiać się nawet w pełnym świetle lamp, choć nadal obowiązują inne wymogi (np. trawa dla zwierząt hodowlanych)."]
	quest.0F89BFD4A3F63A48.title: "Ignorowanie Światła"
	quest.0F8F0F7880235BA2.quest_desc: ["&cSoul Blacksmith&r to monumentalna kuźnia w Netherze pełna złota i czernitu, której pilnuje kolosalny &c&lNetherite Monstrosity&r."]
	quest.0F8F0F7880235BA2.title: "&cSoul Blacksmith&f: Siedziba &c&lNetherite Monstrosity&r"
	quest.0FE2DBCBDD761DD0.quest_desc: ["Stacja Kolejowa (&eTrain Station&r) to serce każdej sieci logistycznej. Pozwala nadawać pociągom nazwy, zarządzać ich montażem oraz tworzyć rozkłady jazdy, dzięki którym składy będą kursować całkowicie autonomicznie między Twoimi fabrykami."]
	quest.0FE2DBCBDD761DD0.quest_subtitle: "1x Train Station"
	quest.0FE2DBCBDD761DD0.title: "Przystanek Logistyczny: Train Station"
	quest.0FEAD3CA2CC4A8B1.quest_desc: ["Katalizator 3. poziomu pozwalający nałożyć najwyższy stopień gwiezdnego naładowania."]
	quest.0FEAD3CA2CC4A8B1.title: "Katalizator Gwiezdny III: Starmetal Dust"
	quest.10407EB6CEA8C111.quest_desc: ["Przepuszczenie twardego obsydianu przez Koła Kruszące (Crushing Wheels) rozbija go na drobny pył obsydianowy – kluczowy półprodukt do wyrobu płyt kolejowych."]
	quest.10407EB6CEA8C111.quest_subtitle: "1x Powdered Obsidian"
	quest.10407EB6CEA8C111.title: "Pył Wulkaniczny: Powdered Obsidian"
	quest.105442DA79829777.quest_desc: ["Połączenie przedmiotu z &8Tome of Scrapping&r w kowadle pozwala odzyskać połowę jego zaklęć na księgę, niszcząc przy tym sam przedmiot."]
	quest.105442DA79829777.quest_subtitle: "Połowa zaklęć, niszczy przedmiot"
	quest.105442DA79829777.title: "&8Tome of Scrapping"
	quest.10630E102680BE46.quest_desc: ["Cyfrowa karta bankowa powiązana z Twoim kontem. Umożliwia dokonywanie płatności w automatach bez noszenia fizycznej gotówki w ekwipunku."]
	quest.10630E102680BE46.quest_subtitle: "1x Bank Card"
	quest.10630E102680BE46.title: "Karta Płatnicza: Bank Card"
	quest.1102B27CBF564127.quest_desc: ["Dodatkowy moduł nakładany na spawner, który zapobiega znikaniu (despawnowaniu) przyzwanych mobów, gdy oddalisz się od swojej fabryki."]
	quest.1102B27CBF564127.quest_subtitle: "Nie znikajcie mi stąd!"
	quest.1102B27CBF564127.title: "Agitator Spawnera"
	quest.1113BF457DB7F1DE.quest_desc: ["Poziom świata &6&lSummit&r podnosi Twój limit &aMax Eterna&r do &a75&r, co jest niezbędne do przeprowadzenia najtrudniejszych infuzji użytkowych."]
	quest.1113BF457DB7F1DE.quest_subtitle: "Max Eterna: 75"
	quest.1113BF457DB7F1DE.title: "Wspinaczka na &6&lSummit"
	quest.1136FE2A46C13302.quest_desc: ["Zajezdnia (Depot) przytrzymuje przedmioty w idealnej pozycji pod prasą lub ramieniem Deployera. W połączeniu z lejami tworzy najprostszą stację obróbki sekwencyjnej."]
	quest.1136FE2A46C13302.quest_subtitle: "Najważniejsze elementy na taśmie"
	quest.1136FE2A46C13302.title: "Podstawowe narzędzia taśmowe"
	quest.1178E4123E8818E2.quest_desc: ["&eSandstorm in a Bottle&r po użyciu przyzywa wokół Ciebie wirujące trąby powietrzne raniące i odrzucające wrogów."]
	quest.1178E4123E8818E2.title: "&eSandstorm in a Bottle"
	quest.11A6D020D6F411A8.quest_desc: [
		"Płaszcz zakrzywiający rzeczywistość i percepcję wrogów."
		""
		"• &2Perception Glitch&r: Daje szansę na całkowite uniknięcie ciosu."
		"• &9Glitchy Copy&r: Tworzy iluzorycznego klona, który ogłusza wrogów przy kontakcie."
		"• &bSurface Tear&r: Pozwala chodzić w powietrzu niczym po rusztowaniu (dopóki pozostajesz w ruchu)."
	]
	quest.11A6D020D6F411A8.quest_subtitle: "Zakrzywienie rzeczywistości"
	quest.11A6D020D6F411A8.title: "&2Glitchy Mantle"
	quest.11B0B93D725ABE43.quest_desc: [
		"Narzędzia z Silent Gear naprawisz w każdej chwili bez kowadła za pomocą &9Repair Kit&r!"
		""
		"Połącz zestaw naprawczy z surowcami w siatce rzemieślniczej, aby go napełnić, a następnie połącz go z uszkodzonym narzędziem."
	]
	quest.11B0B93D725ABE43.quest_subtitle: "Naprawa w terenie bez kowadła"
	quest.11B0B93D725ABE43.title: "Zestaw Naprawczy (Repair Kit)"
	quest.11C5F17C6BB1237B.quest_desc: ["Ataki wręcz z założoną &5Withered Bracelet&r mają szansę nałożyć na cel efekt Obumierania (Wither)."]
	quest.11C5F17C6BB1237B.quest_subtitle: "Nadgarstki (Dłonie)"
	quest.11C5F17C6BB1237B.title: "&5Withered Bracelet&r"
	quest.11DBC70D36451A8D.quest_desc: ["Cyfrowy kartridż zdolny pomieścić aż 64 wiadra cieczy wewnątrz napędu Disk Drive. Koniec z budowaniem całych hal pełnych zbiorników!"]
	quest.11DBC70D36451A8D.quest_subtitle: "1x 64b Fluid Storage Disk"
	quest.11DBC70D36451A8D.title: "Dysk Płynów 64b"
	quest.1204BCEDBE8D18EE.quest_desc: ["Wydajna, bezobsługowa produkcja obsydianu w mosiężnym ekstruderze – fundament pod masową produkcję Sturdy Sheets i zaawansowanych obudów."]
	quest.1204BCEDBE8D18EE.quest_subtitle: "64x Obsidian"
	quest.1204BCEDBE8D18EE.title: "Zaawansowana Ekstruzja: Obsydian"
	quest.122E6E7CABCB17E7.quest_desc: ["&7Kitty Slippers&r sprawiają, że wszystkie Creepery uciekają przed Tobą w popłochu, a Ty otrzymujesz mniejsze obrażenia od upadku."]
	quest.122E6E7CABCB17E7.quest_subtitle: "Stopy"
	quest.122E6E7CABCB17E7.title: "&7Kitty Slippers&r"
	quest.12449D23295CF9ED.quest_desc: [
		"Morski relikt odnajdywany w podwodnych ruinach i wrakach."
		""
		"• &bAquatic Regeneration&r: Zwiększa maksymalne zdrowie i regenerację podczas przebywania w wodzie lub na deszczu."
		"• &9Electric Discharge&r: Gromadzi ładunek elektryczny, który przy kontakcie z wrogiem wyzwala łańcuchowy impuls paraliżujący!"
	]
	quest.12449D23295CF9ED.quest_subtitle: "Elektryzujący uścisk głębin"
	quest.12449D23295CF9ED.title: "&9Jellyfish Necklace"
	quest.13D5F689E6884281.quest_desc: ["&eKobolediator&r to jeden z dwóch mini-bossów piramidy – potężny gladiator wywołujący zmęczenie górnicze i szarżujący na graczy."]
	quest.13D5F689E6884281.title: "&eKobolediator"
	quest.1403D677CF2815C3.quest_desc: ["Ulepszony &5&lReforging Table&r przełamuje ograniczenia podstawowego stołu, pozwalając przekuwać przedmioty z użyciem materiałów &5Epic&r oraz &6Mythic&r!"]
	quest.1403D677CF2815C3.title: "(Ulepszony) &5&lReforging Table&r"
	quest.145E7D1A88B83DDD.quest_desc: ["Otula właściciela aurą niewidzialności, utrudniając potworom wykrycie Twojej obecności."]
	quest.145E7D1A88B83DDD.quest_subtitle: "Szalik (Naszyjnik)"
	quest.145E7D1A88B83DDD.title: "&9Scarf of Invisibility&r"
	quest.148A33CC36B2563A.quest_desc: ["&dDraconic Endshelf&r wykuta z użyciem &dGłowy Smoka&r to jedyna półka pozwalająca osiągnąć ostateczny pułap &a100 Eterna&r!"]
	quest.148A33CC36B2563A.title: "&dDraconic Endshelf"
	quest.152852C93E3A82F4.quest_desc: ["Stacjonarny blok pamięci na płyny o pojemności 64 wiader, gotowy do bezpośredniego wpięcia w sieć Refined Storage."]
	quest.152852C93E3A82F4.quest_subtitle: "1x 64b Fluid Storage Block"
	quest.152852C93E3A82F4.title: "Stacjonarny Bank Płynów 64b"
	quest.157C30BEA13822AD.quest_desc: ["Drobne monety miedziane (Spurs) – podstawowa waluta rozliczeniowa w najprostszych transakcjach handlowych."]
	quest.157C30BEA13822AD.quest_subtitle: "128x Spur"
	quest.157C30BEA13822AD.title: "Waluta: Miedziane Spurs"
	quest.158B24939A269D83.quest_desc: ["Okucie końcówki (Tip Upgrade) pozwala podnieść poziom wydobycia gotowego narzędzia – np. nałożenie diamentowej końcówki na żelazny kilof pozwoli nim kopać obsydian!"]
	quest.158B24939A269D83.quest_subtitle: "Gdy masz tylko 1 diament"
	quest.158B24939A269D83.title: "Forma: Końcówka (Tip Cast)"
	quest.158F872A3A2C3650.quest_desc: [
		"Mając dostęp do &a80 Eterna&r, możesz poddać infuzji &dOddech Smoka (Dragon's Breath)&r!"
		""
		"Wymagane parametry (&a80 Eterna&r, &c25% Quanta&r, &5100% Arcana&r) uzyskasz za pomocą: 4x &9Echoing Sculkshelf&r, 4x &9Soul-Touched Sculkshelf&r oraz 6x &6Geode-Encased Bookshelf of Stability&r."
	]
	quest.158F872A3A2C3650.title: "&dInfused Dragon's Breath"
	quest.1617C1935F22FBD1.quest_desc: [
		"Infuzja mitycznej perły &6Godforged Pearl&r przy pełnych &a100 Eterna&r, &c9,65–11% Quanta&r oraz &558,75–60% Arcana&r."
		""
		"Wymagany układ: 1x &dDraconic Endshelf&r, 6x &6Geode-Encased Bookshelf&r, 1x &9Echoing Sculkshelf&r, 5x &9Soul-Touched Sculkshelf&r, 1x &7Stoneshelf&r oraz 1 Świeca."
	]
	quest.1617C1935F22FBD1.quest_subtitle: "Alchemia boskich pereł"
	quest.1617C1935F22FBD1.title: "&6God-Fused Pearl"
	quest.161A90E134592D0E.quest_desc: ["Przepalenie &cEverlasting Beef&r w piecu daje &4Eternal Steak&r – nieskończony stek odnawiający znacznie więcej punktów głodu i nasycenia!"]
	quest.161A90E134592D0E.quest_subtitle: "Unikalny"
	quest.161A90E134592D0E.title: "&4Eternal Steak"
	quest.16255FB20F35A9D9.quest_desc: ["&3Snorkel&r zapewnia zapas oddychania pod wodą po zanurzeniu, ułatwiając eksplorację podwodnych struktur."]
	quest.16255FB20F35A9D9.quest_subtitle: "Głowa"
	quest.16255FB20F35A9D9.title: "&3Snorkel"
	quest.166B94A48B3625D5.quest_desc: ["Podstawowe paliwo dla Twoich pierwszych pieców i kotłów. Zbierz solidny zapas węgla, zanim przejdziesz na paliwa płynne."]
	quest.166B94A48B3625D5.quest_subtitle: "32x Węgiel (Coal)"
	quest.166B94A48B3625D5.title: "Czarne Złoto: Węgiel"
	quest.166CE4243896A0CD.quest_desc: ["Chcesz zwiększyć moc swoich klejnotów? Na &a&lStole Szlifierskim (Gem Cutting Table)&r połączysz dwa identyczne klejnoty tej samej jakości z pyłem klejnotów i materiałami rzadkości, podnosząc ich czystość aż do rangi &zPerfect&r!"]
	quest.166CE4243896A0CD.title: "Szlifowanie &aKlejnotów"
	quest.167E1474644C9908.quest_desc: [
		"Kwarc pozwala odwrócić działanie dowolnej runy modyfikującej."
		""
		"Trzymając Kwarc w drugiej ręce (Offhand), a runę w głównej dłoni, zaaplikujesz odwrotny efekt – np. zmniejszysz zasięg przyzywania zamiast go zwiększać."
	]
	quest.167E1474644C9908.title: "Odwrócenie Efektu: Kwarc"
	quest.1695917695648018.quest_desc: ["&3Abandoned Temple&r to mroźna świątynia strzeżona przez &3Draugrów&r – na jej szczycie znajdziesz skrzynie z cennym łupem."]
	quest.1695917695648018.title: "&3Abandoned Temple"
	quest.16C74B5F99AD6724.quest_desc: [
		"&8Common (Zwykły)&r to najbardziej podstawowa klasa rzadkości, powszechna na poziomie świata &9Haven&r."
		""
		"&8Mysterious Scrap Metal&r pozyskasz, rozbierając zwykłe przedmioty na &c&lStole Rozbiórki&r."
	]
	quest.16C74B5F99AD6724.quest_subtitle: "&8Common"
	quest.16C74B5F99AD6724.title: "&8Mysterious Scrap Metal"
	quest.17410BE15A81DD96.quest_desc: [
		"&9Wayfarer's Spawner Upgrade Rune&r to drugi poziom ulepszenia spawnera (do jej stworzenia możesz użyć dowolnego jajka przyzywającego):"
		""
		"• Minimalne opóźnienie: 100 ticków"
		"• Maksymalne opóźnienie: 400 ticków"
		"• Liczba mobów na cykl: 10"
		"• Limit pobliskich bytów: 18"
		"• Zasięg aktywacji gracza: 32 kratki"
	]
	quest.17410BE15A81DD96.title: "Runa Ulepszenia II: Ascent"
	quest.1744E700CF742CE2.quest_desc: ["&5Coralssus&r to potężny koralowy kolos strzegący więzień w Zatopionym Mieście. Upuszcza &5Coral Chunk&r wymagany do stworzenia Abyssal Sacrifice."]
	quest.1744E700CF742CE2.title: "&5Coralssus&r"
	quest.177D8EE9F636BFB8.quest_desc: [
		"Fabryka pełna surowców to dopiero połowa sukcesu – prawdziwa potęga przemysłowa zaczyna się tam, gdzie nadwyżki produkcyjne zamieniają się w twardą walutę!"
		""
		"W świecie &6AeroStratum&r podstawą ekonomii są monety z systemu &eCreate: Numismatics&r (od drobnych &7Spurs&r i &7Bevels&r, aż po cenne &6Crowns&r oraz &bSuns&r). Zamiast gromadzić tysiące niepotrzebnych przedmiotów w magazynach, możesz wprowadzić je na rynek."
		""
		"&lJak zacząć zarabiać?&r"
		"• &aLokalny Handel i Wendorzy:&r W pierwszej części tego rozdziału nauczysz się zarządzać kontem bankowym, korzystać z kart płatniczych oraz stawiać własne automaty sprzedażowe (&eAndesite&r oraz &6Brass Vendors&r). Pozwolą Ci one bezobsługowo handlować z innymi graczami i czerpać zyski ze swojej oferty 24/7."
		"• &bKolej i Masowy Eksport:&r Gdy lokalny rynek przestanie Ci wystarczać, w drugiej części drzewka wkroczysz w erę ciężkiej logistyki kolejowej! Zbudujesz własną sieć pociągów towarowych, które umożliwią masowy transport i eksport dóbr na skalę światową."
		""
		"Kliknij poniższy znacznik, aby poznać tajniki ekonomii i otworzyć swój pierwszy punkt handlowy!"
	]
	quest.177D8EE9F636BFB8.quest_subtitle: "Zwiększenie zarobków na skalę światową"
	quest.177D8EE9F636BFB8.title: "HANDEL"
	quest.179A2967D712CE85.quest_desc: ["Nasycenie kwarcu netherowego ogromną ilością czerwonego proszku tworzy kryształ zdolny do przewodzenia i wzmacniania impulsów energetycznych."]
	quest.179A2967D712CE85.quest_subtitle: "1x Rose Quartz"
	quest.179A2967D712CE85.title: "Krystaliczna Rezonancja: Różowy Kwarc"
	quest.17C87EB8ED8A27AB.quest_desc: ["Runy Spawnera stanowią bazowy komponent rzemieślniczy wymagany do wytwarzania podstawowych ulepszeń spawnerów."]
	quest.17C87EB8ED8A27AB.quest_subtitle: "Podstawowe modyfikacje"
	quest.17C87EB8ED8A27AB.title: "Runa Spawnera"
	quest.17CA9D80D8EC3EF7.quest_desc: ["&4&lThe Harbinger&r to latająca machina zagłady napędzana Gwiazdą Netheru. Ostrzeliwuje arenę samonaprowadzającymi rakietami Withera, moździerzami oraz potężnym promieniem lasera (wskazówka: impulsy EMP potrafią go chwilowo ogłuszyć!)."]
	quest.17CA9D80D8EC3EF7.title: "&4&lThe Harbinger&r"
	quest.186593EBCE3FE8D8.quest_desc: ["Zwiększa promień wokół spawnera, w którym mogą pojawiać się potwory (lub zmniejsza go, jeśli trzymasz Kwarc w drugiej ręce, co ułatwia budowę ciasnych komór zrzutowych)."]
	quest.186593EBCE3FE8D8.title: "Zasięg Przyzywania"
	quest.1873205CF5247E3E.quest_desc: ["&dEndshelves&r tworzone z nasyconego oddechu smoka i cegieł Endu pozwalają podnieść poziom &aEterna&r aż do &a90&r!"]
	quest.1873205CF5247E3E.title: "&dEndshelves"
	quest.18A64670D9EE86E8.quest_desc: ["Szara, niepozorna skała, która stanowi fundament całej technologii Create. Wykop pełny stack andezytu – przyda się szybciej, niż myślisz!"]
	quest.18A64670D9EE86E8.quest_subtitle: "64x Andezyt (Andesite)"
	quest.18A64670D9EE86E8.title: "Fundament Inżynierii: Andezyt"
	quest.18AA64DF63F68762.quest_desc: ["Węzeł łączący ścieżkę Hellshelf i Seashelf przed przejściem na poziom Ascent."]
	quest.18AA64DF63F68762.title: "Kolejna Brama"
	quest.18B025CA634BFF11.quest_desc: ["Samodzielny blok pamięci 1k, który możesz postawić bezpośrednio w świecie i podpiąć kablem do sieci bez użycia stacji Disk Drive."]
	quest.18B025CA634BFF11.quest_subtitle: "1x 1k Storage Block"
	quest.18B025CA634BFF11.title: "Stacjonarny Bank 1k"
	quest.18DB8C875F2331B2.quest_desc: [
		"Pas kinetyczny manipulujący grawitacją i pędem."
		""
		"• &5Arsenal Expansion&r: Zwiększa liczbę slotów na amulety."
		"• &bGliding&r: Przytrzymanie Spacji zmniejsza grawitację i pozwala szybować w powietrzu (w połączeniu z &9Jellyfish Necklace&r tworzy synergię &eElectric Arc&r, pozostawiającą w locie elektryczny ślad!)."
	]
	quest.18DB8C875F2331B2.quest_subtitle: "Opanuj pęd powietrza"
	quest.18DB8C875F2331B2.title: "&dKinetic Belt&r"
	quest.18E0F5A78F696FA3.quest_desc: ["Runa Echa nakłada specjalny efekt na spawner – wszystkie przyzwane przez niego stworzenia upuszczają zwielokrotnioną ilość łupów po śmierci."]
	quest.18E0F5A78F696FA3.title: "Runa Echa (Echoing)"
	quest.191A7F3C9FBA4C13.quest_desc: [
		"Ulepszenie &bInfused Seashelf&r kryształami pryzmarynu daje &bCrystalline Seashelf&r (&a+5 Eterna&r, &5+5% Arcana&r, &c+3% Quanta&r)."
		""
		"12 takich półek wystarczy, aby nasycić &9Dormant Deepshelf&r!"
	]
	quest.191A7F3C9FBA4C13.title: "&bCrystalline Seashelf"
	quest.196312DF0D2E2CB6.quest_desc: [
		"&4Najeźdźcy (Invaders)&r to mini-bossowie Apotheosis pojawiający się w każdym wymiarze i upuszczający klejnoty oraz przedmioty z afiksami."
		""
		"Ich siła oraz jakość łupów zależą od wybranego &lPoziomu Świata (World Tier)&r! Menu Poziomów Świata otworzysz w każdej chwili skrótem &e[ CTRL + T ]&r."
	]
	quest.196312DF0D2E2CB6.title: "&4Najeźdźcy&r i &lPoziomy Świata"
	quest.19B393433FB0C62F.quest_desc: ["&4Strider Shoes&r pozwalają bezpiecznie chodzić po powierzchni lawy podczas skradania się oraz chronią przed obrażeniami od bloków magmy."]
	quest.19B393433FB0C62F.quest_subtitle: "Stopy"
	quest.19B393433FB0C62F.title: "&4Strider Shoes&r"
	quest.1A52D891F39B3956.quest_desc: ["Specjalistyczny moduł konwertujący ciśnienie cieczy na sygnał cyfrowy. Niezbędny do budowy dysków i bloków magazynowych na płyny."]
	quest.1A52D891F39B3956.quest_subtitle: "1x Digital Tank"
	quest.1A52D891F39B3956.title: "Cyfrowy Zbiornik: Digital Tank"
	quest.1A8F438DB8508276.quest_desc: ["&3Frosted Prison&r to ogromna lodowa forteca w górach skrywająca zbrojownie, cele więzienne oraz Przeklęty Nagrobek (&3Cursed Tombstone&r)."]
	quest.1A8F438DB8508276.title: "&3Frosted Prison&r: Siedziba &3&lMaledictusa"
	quest.1B344A2390B3E993.quest_desc: ["Prawdziwa potęga Wieku Pary! Zamontuj silniki parowe na rozgrzanym kotle z Fluid Tanków zasilanym palnikami Blaze Burner, aby wygenerować gigantyczne ilości jednostek naprężeń (SU) dla całej fabryki."]
	quest.1B344A2390B3E993.quest_subtitle: "4x Steam Engine"
	quest.1B344A2390B3E993.title: "Serce Elektrowni: Silniki Parowe"
	quest.1B4ED65C614B102F.quest_desc: ["&bIgnited Revenant&r osłania się wirującymi tarczami – poczekaj, aż uniesie gardę, i pokonaj go, by zdobyć &bBurning Ashes&r."]
	quest.1B4ED65C614B102F.title: "&bIgnited Revenant&r"
	quest.1B7A15730657ED30.quest_desc: ["&eDesert Site&r to rozległe wykopaliska pustynne strzeżone przez &eKoboletony&r i &eWadjeta&r – uważaj na ukryte pułapki przy skrzyniach!"]
	quest.1B7A15730657ED30.title: "&eDesert Site"
	quest.1B93CC74B13084E5.quest_desc: ["Wysuszone wodorosty po obróbce stanowią zaskakująco elastyczny i wytrzymały surowiec, przypominający gumę przemysłową. Zbierz solidny zapas z dna oceanu – bez niego żadna taśma produkcyjna nie ruszy z miejsca."]
	quest.1B93CC74B13084E5.quest_subtitle: "32x Kelp"
	quest.1B93CC74B13084E5.title: "Zbiór z Głębin: Wodorosty"
	quest.1C22288B92135426.quest_desc: ["Wolnostojąca szafa serwerowa o pojemności 4096 przedmiotów. Świetnie sprawdza się jako dedykowany magazyn podpięty bezpośrednio pod linię produkcyjną."]
	quest.1C22288B92135426.quest_subtitle: "1x 4k Storage Block"
	quest.1C22288B92135426.title: "Stacjonarny Bank 4k"
	quest.1C5EA7D62BAF2108.quest_desc: ["Aby przebudzić &5&lThe Leviathan&r, musisz złożyć w ołtarzu &5Abyssal Sacrifice&r – przedmiot wykuty z bloków metali, ametystu, muszli łodzika, Serca Morza, sztyletu Athame oraz fragmentów koralu."]
	quest.1C5EA7D62BAF2108.quest_subtitle: "Przebudzenie Lewiatana"
	quest.1C5EA7D62BAF2108.title: "&5Abyssal Sacrifice"
	quest.1C83657D7D6B7C2B.quest_desc: ["Wypycha wskazane przedmioty lub płyny z sieci cyfrowej bezpośrednio do podłączonej maszyny, kadzi lub zbiornika."]
	quest.1C83657D7D6B7C2B.quest_subtitle: "1x Exporter"
	quest.1C83657D7D6B7C2B.title: "Węzeł Wyjściowy: Exporter"
	quest.1C8C0210803B74A2.title: "Blast Furnace"
	quest.1CD05CB4A3DB112A.quest_desc: ["&c&lStół Rozbiórki (Salvaging Table)&r pozwala przetwarzać niepotrzebne klejnoty w pył oraz rozbierać znaleziony ekwipunek z afiksami na surowce rzemieślnicze odpowiadające jego rzadkości."]
	quest.1CD05CB4A3DB112A.title: "&c&lSalvaging Table"
	quest.1D1FAA2F86695781.quest_desc: [
		"Aby przejść na poziom &e&lAscent&r, cały Twój założony ekwipunek musi być rangi &aUncommon&r (lub wyższej), a ponadto musisz pokonać przynajmniej jednego &4Najeźdźcę (Invader)&r."
		""
		"• Premie gracza: +55% XP, +30% Szczęścia, limit &a60 Eterna&r"
		"• Wzmocnienie potworów: +8 Pancerza, +5 Przebicia Pancerza"
	]
	quest.1D1FAA2F86695781.title: "&lWorld Tier: &eAscent"
	quest.1D415EDA55BC810F.quest_desc: ["Diamentowy Autocrafter jeszcze bardziej przyspiesza pracę i udostępnia ogromną liczbę slotów na wzorce dla rozbudowanych linii produkcyjnych."]
	quest.1D415EDA55BC810F.quest_subtitle: "1x Diamond Crafter"
	quest.1D415EDA55BC810F.title: "Diamentowy Autocrafter"
	quest.1D56D3B444A4B2D4.quest_desc: ["Fuzja &dGauntlet of Guard&r oraz &bBulwark of the Flame&r – odpycha pobliskich wrogów, nakłada na nich ogniste piętno i pozwala wykonać płomienną szarżę!"]
	quest.1D56D3B444A4B2D4.title: "&dGauntlet of &bBulwark"
	quest.1E13E3DE5D69B61F.quest_desc: ["Czysta karta pamięci na schematy produkcyjne. Zapisz na niej recepturę rzemieślniczą lub proces przetapiania, a następnie umieść w Autocrafterze."]
	quest.1E13E3DE5D69B61F.quest_subtitle: "1x Pattern"
	quest.1E13E3DE5D69B61F.title: "Nośnik Schematu: Pattern"
	quest.1E2A9446594638E2.quest_desc: [
		"Kostur wykuty z owoców refrenu."
		""
		"• &dTeleportation&r: Pozwala błyskawicznie teleportować się przed siebie na krótki dystans, zużywając wewnętrzne ładunki odnawiające się z czasem."
	]
	quest.1E2A9446594638E2.quest_subtitle: "Mignięcie przez przestrzeń"
	quest.1E2A9446594638E2.title: "&dChorus Staff&r"
	quest.1E2F1E036716C031.quest_desc: ["Forma do odlewania widełek procy miotającej drobnymi kamykami."]
	quest.1E2F1E036716C031.title: "Forma: Proca (Slingshot Cast)"
	quest.1E3C2E5663DE1F3F.quest_desc: [
		"Szczytowe osiągnięcie mechaniki precyzyjnej! Zestaw rząd Deployerów nad taśmą montażową i zautomatyzuj produkcję Precision Mechanism."
		""
		"Opanowanie tego procesu otwiera przed Tobą wrota do zaawansowanej logistyki, maszyn mosiężnych oraz pełnej automatyzacji. Witaj w Erze 2!"
	]
	quest.1E3C2E5663DE1F3F.quest_subtitle: "Kamień Milowy Ery 1"
	quest.1E3C2E5663DE1F3F.title: "Złote Serce Automatyzacji: Precision Mechanism"
	quest.1E40ACF3E69A4100.quest_desc: ["&6Antidote Vessel&r drastycznie skraca czas trwania negatywnych efektów (takich jak Trucizna czy Wither)."]
	quest.1E40ACF3E69A4100.quest_subtitle: "Pas"
	quest.1E40ACF3E69A4100.title: "&6Antidote Vessel&r"
	quest.1E8357755479E259.quest_desc: ["Forma do odlewania korpusu kuszy o dużej sile przebicia."]
	quest.1E8357755479E259.title: "Forma: Kusza (Crossbow Cast)"
	quest.1F748ACA3976A92F.quest_desc: ["Węzeł łączący ścieżkę Hellshelf lub Seashelf z wymogiem odblokowania poziomu świata Frontier."]
	quest.1F748ACA3976A92F.title: "Wybór Ścieżki"
	quest.1FAFDB20F504688E.quest_desc: [
		"&5&lApothic Enchanting&r całkowicie przebudowuje mechanikę zaklinania."
		""
		"Zwykłe 15 biblioteczek to dopiero początek – nowe rodzaje półek pozwalają sterować trzema parametrami ołtarza (&aEterna&r, &cQuanta&r, &5Arcana&r) oraz przeprowadzać rytuały &d&lInfuzji&r!"
	]
	quest.1FAFDB20F504688E.title: "&5&lApothic Enchanting"
	quest.1FD7EB7910170E8D.quest_desc: ["Miedź to klucz do opanowania rurociągów, zbiorników ciśnieniowych oraz wytopu mosiądzu w nadchodzących erach."]
	quest.1FD7EB7910170E8D.quest_subtitle: "16x Sztabka miedzi (Copper Ingot)"
	quest.1FD7EB7910170E8D.title: "Rudy Przemysłowe: Miedź"
	quest.2002C7EB13626AE7.quest_desc: [
		"&6Sigil of Enhancement&r stanowi paliwo dla &6&lStołu Augmentacji&r."
		""
		"Każde przelosowanie pojedynczego afiksu kosztuje 1 pieczęć, a jego ulepszenie na wyższy poziom – 2 pieczęcie."
	]
	quest.2002C7EB13626AE7.title: "&6Sigil of Enhancement"
	quest.200DFE86A1BCAE00.quest_desc: ["Automatyczny destruktor (Destructor) niszczy bloki znajdujące się przed nim i przesyła urobek prosto na dyski sieciowe."]
	quest.200DFE86A1BCAE00.quest_subtitle: "1x Destructor"
	quest.200DFE86A1BCAE00.title: "Automatyczny Górnik: Destructor"
	quest.2011638351B67396.quest_desc: ["Włócznia &9Astrape&r wykuta z Essence of the Storm i Lacrima zapewnia duży zasięg w walce wręcz oraz pozwala ciskać piorunami po przytrzymaniu prawego przycisku myszy!"]
	quest.2011638351B67396.title: "&9Astrape"
	quest.2098D8BFADB55D2A.quest_desc: ["Szablon wyściółki pancerza dodającej miękką warstwę ochronną wewnątrz zbroi."]
	quest.2098D8BFADB55D2A.title: "Szablon: Wyściółka (Lining Blueprint)"
	quest.21234BB40DB05C78.quest_desc: ["Forma do odlewania bransolet wzmacniających statystyki postaci."]
	quest.21234BB40DB05C78.title: "Forma: Bransoleta (Bracelet Cast)"
	quest.213EB741245A7B27.quest_desc: ["Pojemny dysk twardy mieszczący 16 384 przedmiotów wewnątrz stacji Disk Drive."]
	quest.213EB741245A7B27.quest_subtitle: "1x 16k Storage Disk"
	quest.213EB741245A7B27.title: "Dysk Danych 16k"
	quest.2156C00E30424844.quest_desc: ["&4Foundry Tank&r to zbiornik paliwowy odlewni – wypełnij go &cLawą&r, aby zasilić grzałki w podłodze pieca."]
	quest.2156C00E30424844.title: "&l&cFoundry&r &4Tanks"
	quest.21A0FD474FBB49F7.quest_desc: ["&dRuined Citadel&r to forteca z obsydianu i purpuru na wyspach Endu, strzeżona przez Shulkery, &dEndermaptery&r oraz &dEnder Golemy&r."]
	quest.21A0FD474FBB49F7.title: "&dRuined Citadel&r: Siedziba &d&lEnder Guardiana&r"
	quest.21BEE9867796933A.quest_desc: [
		"Flet nomadów pozwalający bezpiecznie przechowywać we wnętrzu do &c2 oswojonych wierzchowców&r."
		""
		"• &6Stable&r: Kliknij PPM na wierzchowca, aby schować go do fletu lub przywołać z powrotem. Przełączaj między zapisanymi wierzchowcami za pomocą Shift + kółko myszy."
	]
	quest.21BEE9867796933A.quest_subtitle: "Przechowuj i przywołuj swoje wierzchowce"
	quest.21BEE9867796933A.title: "&cRider Flute&r"
	quest.2215FB0777D7029D.quest_desc: ["&7Steadfast Spikes&r chronią przed odrzutem od ciosów, eliminują poślizg na lodzie i pozwalają powoli zsuwać się po pionowych ścianach."]
	quest.2215FB0777D7029D.quest_subtitle: "Stopy"
	quest.2215FB0777D7029D.title: "&7Steadfast Spikes&r"
	quest.221C9EDA651144BA.quest_desc: ["Z &3Charm of Sinking&r poruszasz się po dnie oceanu tak swobodnie, jakby wokół nie było wody (pamiętaj jednak o zapasie tlenu!)."]
	quest.221C9EDA651144BA.quest_subtitle: "Naszyjnik"
	quest.221C9EDA651144BA.title: "&3Charm of Sinking&r"
	quest.222D08F43B995FED.quest_desc: ["Forma do odlewania głowicy modułowego trójzębu z wybranych stopów metali."]
	quest.222D08F43B995FED.quest_subtitle: "Władca mórz"
	quest.222D08F43B995FED.title: "Forma: Trójząb (Trident Cast)"
	quest.223A5BDB5056B781.quest_desc: ["Capturing to zaklęcie na miecze, które daje szansę (0,5% na każdy poziom zaklęcia, aż do poziomu VII) na wypadnięcie jajka przyzywającego z pokonanego potwora."]
	quest.223A5BDB5056B781.title: "Zaklęcie: Capturing"
	quest.224716A537F2FFA0.quest_desc: ["&8Armor Tomes&r losują wyłącznie zaklęcia przeznaczone dla konkretnego elementu pancerza (hełmu, napierśnika, nogawic lub butów)."]
	quest.224716A537F2FFA0.title: "&8Armor Tomes"
	quest.226FB6C7CF3FEFB3.quest_desc: ["Podczas tej przygody niezbędny do przetrwania będzie plecak. Zrób go tak szybko, jak tylko potrafisz (będziesz potrzebował skóry)."]
	quest.226FB6C7CF3FEFB3.quest_subtitle: "Największy przyjaciel zbieracza - PLECAK"
	quest.226FB6C7CF3FEFB3.title: "Najważniejsze akcesorium"
	quest.2289860C15742201.quest_desc: ["Nasączenie pyłu obsydianowego lawą i sprasowanie go prasą mechaniczną tworzy niezwykle odporny arkusz Sturdy Sheet, zdolny wytrzymać ogromne obciążenia składów kolejowych."]
	quest.2289860C15742201.quest_subtitle: "1x Sturdy Sheet"
	quest.2289860C15742201.title: "Pancerna Blacha: Sturdy Sheet"
	quest.22A0A9C81A5C85A1.quest_desc: ["Szablon wiązania spajającego głowicę narzędzia z trzonkiem."]
	quest.22A0A9C81A5C85A1.quest_subtitle: "Spaja wszystko w całość"
	quest.22A0A9C81A5C85A1.title: "Szablon: Wiązanie (Binding Blueprint)"
	quest.22C51025DC42CDE2.quest_desc: ["Forma do odlewania płyt nogawic."]
	quest.22C51025DC42CDE2.title: "Forma: Nogawice (Leggings Cast)"
	quest.22E57BF23B9BA2C5.quest_desc: ["Zgromadź zapas pyłu klejnotów potrzebny do zaawansowanego rzemiosła na wyższych poziomach świata."]
	quest.22E57BF23B9BA2C5.title: "Rezerwy Pyłu Klejnotów"
	quest.235E3C386E8D36A3.quest_desc: ["Tutaj ścieżki piekielna i morska łączą się w jedną! Wytwórz &9Dormant Deepshelf&r z łupku i książek, a następnie poddaj ją infuzji przy &a60 Eterna&r, &c40% Quanta&r i &540% Arcana&r (12x Crystalline Seashelf lub 13x Glowing Hellshelf)."]
	quest.235E3C386E8D36A3.title: "&9Deepshelf"
	quest.236EA8D18ECD5FE8.quest_desc: ["&bIgnited Berserker&r pojawia się w Fortecach Netheru i upuszcza &bDying Embers&r (4 sztuki złożysz w 1 Burning Ashes)."]
	quest.236EA8D18ECD5FE8.title: "&bIgnited Berserker"
	quest.24391162F4FF0587.quest_desc: [
		"Przy 15 półkach &bSeashelf&r wokół stołu przeprowadzisz infuzję tworzącą &bInfused Seashelf&r!"
		""
		"Każda daje &a+5 Eterna&r (do limitu &a60&r) oraz &5+5% Arcana&r."
	]
	quest.24391162F4FF0587.title: "&bInfused Seashelf"
	quest.243D55E17CC9B04A.quest_desc: [
		"Aby ułatwić sobie życie, zapamiętaj te najważniejsze skróty klawiszowe:"
		""
		"[ M ] – Otwiera mapę świata (Xaero's lub JourneyMap)."
		"[ R ] / [ U ] – Najeżdżając myszką na przedmiot w ekwipunku, sprawdzisz jak go stworzyć (R) lub do czego służy (U)."
		"[ W ] – Objaśnienie za pomocą animacji działania i zastosowania danego komponentu Create."
		"[ ~ ] (Tylda) – Aktywuje FTB Ultimine. Przytrzymaj ten klawisz podczas kopania, aby wykopać całą żyłę surowców naraz!"
		"[ B ] – Szybki dostęp do plecaka (Sophisticated Backpacks)."
	]
	quest.243D55E17CC9B04A.quest_subtitle: "(Ważne Klawisze)"
	quest.243D55E17CC9B04A.title: "Podręcznik Przetrwania"
	quest.24C757B8AA6841F6.quest_desc: ["Wytwórz &3Inert Trident&r i poddaj go &d&lInfuzji&r (min. &a40 Eterna&r, &c20–50% Quanta&r, &535% Arcana&r), aby uzyskać pełnoprawny &3Trójząb&r!"]
	quest.24C757B8AA6841F6.title: "Tworzenie &3Trójzębu"
	quest.24D11ED5F4EEDC48.quest_desc: [
		"Aby osadzić klejnot w broni lub zbroi, przedmiot musi posiadać wolne &9Gniazdo (Socket)&r."
		""
		"Połącz swój przedmiot z &9Sigil of Socketing&r w &8&lStole Kowalskim&r, aby odblokować w nim dodatkowe gniazdo na klejnot!"
	]
	quest.24D11ED5F4EEDC48.title: "&9Sigil of Socketing"
	quest.24E0B7BE9E8CAF99.quest_desc: ["Stacja dokująca mieszcząca aż 8 dysków pamięci. Podłącz ją do Kontrolera, włóż dyski i ciesz się scentralizowanym magazynem."]
	quest.24E0B7BE9E8CAF99.quest_subtitle: "1x Disk Drive"
	quest.24E0B7BE9E8CAF99.title: "Szafa Serwerowa: Disk Drive"
	quest.24F68B7E8A51E6FD.quest_desc: ["Specjalistyczny rdzeń obliczeniowy odpowiedzialny za materializację obiektów z postaci cyfrowej."]
	quest.24F68B7E8A51E6FD.quest_subtitle: "1x Construction Core"
	quest.24F68B7E8A51E6FD.title: "Rdzeń Budowlany: Construction Core"
	quest.24FCFF18296ED907.quest_desc: [
		"Wymaga bloków Sculku, katalizatora Sculku oraz trofeum &9Warden Tendril&r z pokonanego Wardena."
		""
		"Zapewnia aż &a+10 Eterna&r, &c+15% Quanta&r, &5+10% Arcana&r oraz podnosi limit Eterna do &a80&r!"
	]
	quest.24FCFF18296ED907.title: "&9Soul-Touched Sculkshelf"
	quest.2542D8A6894816C6.quest_desc: ["&eEye of Desert&r wskaże na pustyni drogę do &eCursed Pyramid&r, w której uśpiony jest &e&lAncient Remnant&r."]
	quest.2542D8A6894816C6.title: "&eEye of Desert&r"
	quest.25ACB08E4F12CE79.quest_desc: ["Postaw &cNetherite Effigy&r i nakarm go ogniwem &cLava Power Cell&r, aby ożywić własnego, oswojonego mini-kolosa z 15 slotami ekwipunku!"]
	quest.25ACB08E4F12CE79.title: "&cNetherite Ministrosity"
	quest.25DB44EB6E7DA3B0.quest_desc: ["To jest najważniejszy surowiec w całej Erze 0. Połączenie zwykłego andezytu z samorodkami żelaza (lub cynku) daje wyjątkowo plastyczny i wytrzymały stop. Będziesz go potrzebować w setkach, jeśli nie tysiącach sztuk. Zrób zapas!"]
	quest.25DB44EB6E7DA3B0.quest_subtitle: "8x Andesite Alloy"
	quest.25DB44EB6E7DA3B0.title: "Magiczne połączenie: Stop Andezytowy"
	quest.2607F3DC07049785.quest_desc: ["Praktyczny kask z uchwytami na napoje, który wyraźnie skraca czas jedzenia posiłków oraz picia mikstur."]
	quest.2607F3DC07049785.quest_subtitle: "Głowa"
	quest.2607F3DC07049785.title: "&6Plastic Drinking Hat"
	quest.26171E29A87D7516.quest_desc: ["Sterowniki pociągu (&eTrain Controls&r) montowane na lokomotywie pozwalają na ręczne prowadzenie składu, a także służą jako punkt zakotwiczenia dla maszynisty lub automatycznego rozkładu jazdy."]
	quest.26171E29A87D7516.quest_subtitle: "1x Train Controls"
	quest.26171E29A87D7516.title: "Pulpit Maszynisty: Train Controls"
	quest.262036FE8E87F50A.quest_desc: ["Forma do odlewania ciężkiego młota górniczego kopiącego skały w obszarze 3x3!"]
	quest.262036FE8E87F50A.quest_subtitle: "Kopanie 3x3"
	quest.262036FE8E87F50A.title: "Forma: Młot (Hammer Cast)"
	quest.2620887DD91A83FA.quest_desc: ["Wyszlifowany kwarc lawowy stabilizuje przepływy termiczne, stanowiąc kluczowy komponent do budowy nowoczesnych przewodów napędowych."]
	quest.2620887DD91A83FA.quest_subtitle: "1x Polished Lava Quartz"
	quest.2620887DD91A83FA.title: "Wyszlifowany Kwarc Lawowy"
	quest.267ABF42F9628FEA.quest_desc: ["Serce każdego systemu Refined Storage. Dostarcz mu energię elektryczną (FE), a ożywi wszystkie podłączone terminale, napędy oraz interfejsy."]
	quest.267ABF42F9628FEA.quest_subtitle: "1x Controller"
	quest.267ABF42F9628FEA.title: "Mózg Operacji: Kontroler Sieci"
	quest.269AB30A3588E4CD.quest_desc: ["Każdy wielki inżynier zaczynał od ubrudzenia sobie rąk. Zanim zaczniesz budować fabryki parowe, musisz przetrwać pierwszą noc. Wydobądź trochę kamienia, zrób podstawowe narzędzia i przygotuj się na ciężką pracę."]
	quest.269AB30A3588E4CD.quest_subtitle: "16x Bruk (Cobblestone)"
	quest.269AB30A3588E4CD.title: "Podnieś ten kamień"
	quest.26EB8490366CC44A.quest_desc: ["Zasysa gotowe produkty lub płyny ze skrzyń, zbiorników i maszyn prosto na dyski Twojej sieci Refined Storage."]
	quest.26EB8490366CC44A.quest_subtitle: "1x Importer"
	quest.26EB8490366CC44A.title: "Węzeł Wejściowy: Importer"
	quest.26F9DB31A835B69C.quest_desc: ["Zamontuj &7Foundry Tap&r na bloku odpływu (&bDrain&r), a bezpośrednio pod kranikiem ustaw &8Casting Table&r (do odlewania sztabek i części narzędzi) lub &8Casting Basin&r (do odlewania pełnych bloków metali)."]
	quest.26F9DB31A835B69C.title: "Stacje Odlewnicze"
	quest.2790EB2E347D28DE.quest_desc: ["Pokonałeś wszystkich ośmiu pradawnych władców Cataclysm w każdym zakątku świata! Odbierz zasłużoną nagrodę pogromcy."]
	quest.2790EB2E347D28DE.quest_subtitle: "Pokonaj wszystkich 8 bossów Cataclysm"
	quest.2790EB2E347D28DE.title: "Pogromca Kataklizmu"
	quest.27E951F4F4F6F847.quest_desc: ["&cFlame Pendant&r ma szansę podpalić atakującego Cię wroga i jednocześnie obdarzyć Cię odpornością na ogień."]
	quest.27E951F4F4F6F847.quest_subtitle: "Naszyjnik"
	quest.27E951F4F4F6F847.title: "&cFlame Pendant&r"
	quest.28D3A1D0B60D86C5.quest_desc: ["Mosiężny ekstruder pozwala generować Kamień Endu bezpośrednio w Twojej fabryce, bez konieczności ręcznego rozkopywania wysp w Endzie."]
	quest.28D3A1D0B60D86C5.quest_subtitle: "64x End Stone"
	quest.28D3A1D0B60D86C5.title: "Zaawansowana Ekstruzja: Kamień Endu"
	quest.290B16E2D899BB92.quest_desc: ["Zaawansowany przewód lawowy (Lava Tube) z modyfikacji silników to potężny komponent przesyłowy, odporny na ekstremalne temperatury roztopionych surowców."]
	quest.290B16E2D899BB92.quest_subtitle: "1x Lava Tube"
	quest.290B16E2D899BB92.title: "Magistrala Termiczna: Lava Tube"
	quest.29131C3532610ADF.quest_desc: ["Zwieńczenie filarów 2. poziomu (Tier 2 Pillar Cap) dla struktury Starlight Charger."]
	quest.29131C3532610ADF.title: "Głowica Filaru II: Azure Electrum"
	quest.291C76140DE97E3C.quest_desc: ["Sztabki &bIgnitium&r zdobywane z pokonanego Ignisa służą do wykuwania pancerza wyższego tieru niż Netheryt oraz potężnego oręża ognia."]
	quest.291C76140DE97E3C.quest_subtitle: "Potężniejszy niż Netheryt"
	quest.291C76140DE97E3C.title: "&bIgnitium"
	quest.29448D08C8777425.quest_desc: ["&cAngler's Hat&r przyspiesza branie ryb na wędkę oraz zwiększa szansę na wyłowienie rzadkich skarbów."]
	quest.29448D08C8777425.quest_subtitle: "Głowa"
	quest.29448D08C8777425.title: "&cAngler's Hat"
	quest.29EA8E178F8F8FDB.quest_desc: [
		"&9&lSimple Reforging Table&r pozwala nadawać nowe &eAfiksy&r na dowolną broń, narzędzie lub zbroję!"
		""
		"Umieść przedmiot na środku, materiał rzadkości po lewej stronie oraz &dSigil of Rebirth&r po prawej. Ten stół obsługuje materiały aż do rangi &9Rare&r."
	]
	quest.29EA8E178F8F8FDB.title: "&9&lSimple Reforging Table"
	quest.2A02D797F5CABAD6.quest_desc: ["Nieskończone źródło andezytu pod masową produkcję stopu andezytowego (Andesite Alloy)."]
	quest.2A02D797F5CABAD6.quest_subtitle: "64x Andesite"
	quest.2A02D797F5CABAD6.title: "Ekstruzja: Andezyt"
	quest.2A032EC573B5316C.quest_desc: [
		"Aby odblokować poziom &2&lFrontier&r, załóż pełny zestaw pancerza z afiksami oraz weź do ręki broń lub narzędzie z afiksem, a następnie aktywuj poziom w menu &e[ CTRL + T ]&r."
		""
		"• Premie gracza: +35% XP, +20% Szczęścia, limit &a45 Eterna&r"
		"• Wzmocnienie potworów: +4 Pancerza"
	]
	quest.2A032EC573B5316C.title: "&lWorld Tier: &2Frontier"
	quest.2A196974431FCC42.quest_desc: ["&cInfernal Forge&r to gigantyczny młoto-kilof wypadający z Netherite Monstrosity – kopie na poziomie netherytu, nie ma paska zużycia, a prawym przyciskiem myszy uderza w ziemię falą uderzeniową!"]
	quest.2A196974431FCC42.title: "&cInfernal Forge"
	quest.2AD78E22988A92D3.quest_desc: ["Założenie &2Night Vision Goggles&r zapewnia widzenie w ciemności podczas eksploracji jaskiń i podziemi."]
	quest.2AD78E22988A92D3.quest_subtitle: "Głowa"
	quest.2AD78E22988A92D3.title: "&2Night Vision Goggles"
	quest.2B08B19B35EEBCBA.quest_desc: ["Poniższe relikty odnajdziesz w Zrujnowanych Portalach, Fortecach Netheru oraz Bastionach na terenie &cNetheru&r!"]
	quest.2B08B19B35EEBCBA.quest_subtitle: "Skarby ognistego wymiaru"
	quest.2B08B19B35EEBCBA.title: "Relikty: &cThe Nether"
	quest.2B115519A21F9CB7.quest_desc: ["&d&lEnder Guardian&r czeka na samym dole Cytadeli. Przyciąga graczy grawitacją próżni, wyzwala fale runiczne, a po utracie połowy zdrowia rozbija swoją maskę i niszczy podłogę areny!"]
	quest.2B115519A21F9CB7.title: "&d&lEnder Guardian&r"
	quest.2B2222D49AE2002C.quest_desc: ["Obróbka termiczna surowego kauczuku daje wulkanizowaną gumę przemysłową. Od teraz możesz uszczelniać miedziane rurociągi i produkować pasy transmisyjne."]
	quest.2B2222D49AE2002C.quest_subtitle: "1x Cured Rubber"
	quest.2B2222D49AE2002C.title: "Wulkanizowana Guma: Cured Rubber"
	quest.2B50E9FC93812730.quest_desc: ["&eDesert Temple&r z moda Cataclysm kryje we wnętrzu mini-bossa &eKobolediatora&r oraz bogate skrzynie ukryte w wieżach."]
	quest.2B50E9FC93812730.title: "&eDesert Temple"
	quest.2BCB788924BBD849.quest_desc: ["&bThe Incinerator&r to gigantyczny miecz dwuręczny – naładowanie ataku prawym przyciskiem myszy wyzwala spod ziemi linię eksplodujących słupów ognia!"]
	quest.2BCB788924BBD849.title: "&bThe Incinerator"
	quest.2BF119DD5D977409.quest_desc: ["Katalizator 2. poziomu wymagany do gwiezdnego ładowania w Starlight Charger."]
	quest.2BF119DD5D977409.title: "Katalizator Gwiezdny II: Azure Silver Dust"
	quest.2C0DF8D6ED259E5F.quest_desc: ["Połączenie młota &cInfernal Forge&r z włócznią &9Astrape&r tworzy &cBron&9tes&r – oręż miotany przyzywający burzę piorunów w miejscu trafienia!"]
	quest.2C0DF8D6ED259E5F.title: "&cBron&9tes"
	quest.2C9C4BFF1D89EF82.quest_desc: ["&3Abandoned Village&r to opuszczona osada opanowana przez &3Draugrów&r, pełna skrzyń ukrytych w poszczególnych chatach."]
	quest.2C9C4BFF1D89EF82.title: "&3Abandoned Village"
	quest.2CD58FC229BC0C28.quest_desc: ["&dGauntlet of Guard&r to trofeum z Ender Guardiana – przytrzymanie prawego przycisku myszy zasysa wszystkich pobliskich wrogów prosto przed Twoje oblicze!"]
	quest.2CD58FC229BC0C28.title: "&dGauntlet of Guard"
	quest.2D69B48F1EFCC9A5.quest_desc: ["&3Sturdy Boots&r pozwalają swobodnie chodzić po powierzchni sypkiego śniegu bez zapadania się."]
	quest.2D69B48F1EFCC9A5.title: "&3Sturdy Boots"
	quest.2D8A7065F8CDDDDD.quest_desc: [
		"Najprostszy sposób na pozyskanie jajek przyzywających dzięki Mob Grinding Utils!"
		""
		"Kliknij prawym przyciskiem myszy na wybranego moba za pomocą wymazówki (Mob Swab), połącz ją z nasionami i wiadrem płynnego XP w paszę GM Chicken Feed, a następnie nakarm nią kurczaka, by uzyskać gotowe jajko przyzywające."
	]
	quest.2D8A7065F8CDDDDD.title: "Inżynieria Genetyczna: Mob Swab"
	quest.2DFE2B76C12BB770.quest_desc: ["Monety zębate (Sprockets) o wyższej wartości nominalnej, używane przy transakcjach o większej skali."]
	quest.2DFE2B76C12BB770.quest_subtitle: "128x Sprocket"
	quest.2DFE2B76C12BB770.title: "Waluta: Zębate Sprockets"
	quest.2E5D835D2B5D7078.quest_desc: ["Andezyt świetnie znosi naprężenia kinetyczne, ale przy kontakcie z cieczami i wysokim ciśnieniem szybko zawodzi. Pokrycie drewna miedzią otwiera drzwi do równoległej gałęzi inżynierii płynów (Era 1.5)!"]
	quest.2E5D835D2B5D7078.quest_subtitle: "1x Copper Casing"
	quest.2E5D835D2B5D7078.title: "Szczelna Konstrukcja: Miedziana Obudowa"
	quest.2E5E129F25707C5D.quest_desc: [
		"&6Sigil of Supremacy&r to korona kowalstwa Apotheosis!"
		""
		"W przeciwieństwie do Sigil of Malice, ta pieczęć wzmacnia JEDNOCZEŚNIE każdy afiks na wybranym przedmiocie i nie resetuje żadnej statystyki w trakcie procesu!"
	]
	quest.2E5E129F25707C5D.title: "&6Sigil of Supremacy"
	quest.2EB96FF06627FD9A.quest_desc: ["&6Salvager&r pozwala rozbierać niepotrzebne narzędzia i pancerze z powrotem na surowce oraz części składowe."]
	quest.2EB96FF06627FD9A.quest_subtitle: "Odzysk surowców!"
	quest.2EB96FF06627FD9A.title: "Salvager"
	quest.2EC2FA680076C07D.quest_desc: ["Druga z potężnych półek ze Sculku i &9Warden Tendril&r – zapewnia &a+10 Eterna&r, &c+10% Quanta&r, &5+15% Arcana&r oraz podnosi limit Eterna do &a80&r!"]
	quest.2EC2FA680076C07D.title: "&9Echoing Sculkshelf"
	quest.2F3529FE1972F011.quest_desc: [
		"Lokalne sklepiki mają ograniczony zasięg, a zwykłe taśmociągi czy rury przestają działać na niezaładowanych terenach. Gdy Twoja produkcja idzie w dziesiątki tysięcy sztuk, nadchodzi czas na &6ciężką logistykę kolejową&r!"
		""
		"Pociągi w &6Create&r posiadają unikalną właściwość: &apotrafią podróżować na ogromne odległości nawet przez niezaładowane chunki&r (o ile załadujesz same stacje docelowe), a dodatkowo mogą przejeżdżać przez portale do &cNetheru&r!"
		""
		"&lZastosowania sieci kolejowej:&r"
		"• &eDalekosiężny transport surowców:&r Przywóź rudy, lawę i egzotyczne skały z odległych kopalni prosto do głównej huty bez budowania kilometrowych linii z pasów transmisyjnych."
		"• &bCentralne Dworce Handlowe:&r Połącz dalekie fabryki ze wspólnym centrum handlowym – pociąg towarowy automatycznie rozładuje nadwyżki przez &ePortable Storage Interface&r prosto do rzędu Twoich Wendorów, zamieniając masową produkcję w nieprzerwany strumień monet!"
	]
	quest.2F3529FE1972F011.quest_subtitle: "Kolejowe imperium logistyczne"
	quest.2F3529FE1972F011.title: "EKSPORT NA MASOWĄ SKALĘ"
	quest.2F62C290A5CE50F8.quest_desc: ["&eAncient Spear&r ma daleki zasięg i wystrzeliwuje przy atakach niszczycielskie trąby piaskowe!"]
	quest.2F62C290A5CE50F8.title: "&eAncient Spear"
	quest.30C5D432C810F904.quest_desc: ["&9Eye of Storm&r wskaże podniebną drogę nad oceanem do &9Acropolis&r, gdzie włada &9&lScylla&r."]
	quest.30C5D432C810F904.title: "&9Eye of Storm"
	quest.30EB438C66324213.quest_desc: ["Runa Samotności sprawia, że spawner nie wymaga już obecności gracza w pobliżu. Dopóki chunk ze spawnerem jest załadowany (np. przez FTB Chunks), produkcja trwa bez przerwy!"]
	quest.30EB438C66324213.title: "Ignorowanie Gracza"
	quest.310969B8FE0A94DE.quest_desc: [
		"Dzięki modyfikacji Apothic Spawners możesz wydobyć dowolny spawner w świecie za pomocą kilofa z Jedwabnym Dotykiem (Silk Touch)."
		""
		"Wydobyty spawner można następnie ulepszać, klikając na niego prawym przyciskiem myszy z odpowiednimi runami modyfikującymi."
	]
	quest.310969B8FE0A94DE.title: "Inżynieria Spawnerów"
	quest.31AA7117F83F8B86.quest_desc: ["Niestrudzony pracownik Twojej fabryki. Deployer potrafi osadzać podzespoły na taśmie, używać narzędzi i składać wieloetapowe mechanizmy z idealną powtarzalnością."]
	quest.31AA7117F83F8B86.quest_subtitle: "1x Deployer"
	quest.31AA7117F83F8B86.title: "Ramię Montażowe: Deployer"
	quest.31E7F7464D79F881.quest_desc: ["Oprócz samych półek na książki, rytuałowi &d&lInfuzji&r możesz poddać także wiele przydatnych narzędzi, ksiąg i minerałów!"]
	quest.31E7F7464D79F881.title: "Pozostałe Przedmioty z &d&lInfuzji&r"
	quest.31FE06D7BD761156.quest_desc: [
		"W tej paczce pieniądze rządzą światem! Oficjalną walutą są monety z systemu Create Numismatics (od drobnych Spur i Bevel po Sprocket, Cog i Crown)."
		""
		"Monety możesz zdobywać wykonując trudniejsze questy, pokonując bossów oraz sprzedając nadmiarowe surowce w specjalnych maszynach. Zarobioną gotówkę możesz wydać w sklepie lub w automatach vendingowych rozstawionych w świecie gry. Schowaj tę monetę głęboko do kieszeni!"
	]
	quest.31FE06D7BD761156.quest_subtitle: "(Zarabianie)"
	quest.31FE06D7BD761156.title: "Ekonomia i Ty"
	quest.321C15EBBE2D3D30.quest_desc: [
		"Wysadzenie spawnera za pomocą TNT destabilizuje jego strukturę – przed zniszczeniem wyrzuci on z siebie falę potworów oraz pozostawi od 48 do 57 Łańcuchów Spawnera (Spawner Chains)."
		""
		"Łańcuchy te są podstawowym surowcem do wykuwania wszystkich run modyfikujących."
	]
	quest.321C15EBBE2D3D30.title: "Demontaż Wybuchowy: Łańcuchy"
	quest.321F16645640C462.quest_desc: ["&9Warp Drive&r sprawia, że rzucane Perły Endu nie zużywają się i nie zadają obrażeń od upadku, pobierając w zamian niewielką ilość głodu!"]
	quest.321F16645640C462.quest_subtitle: "Pas"
	quest.321F16645640C462.title: "&9Warp Drive&r"
	quest.3223B14E53AACFB5.quest_desc: ["Semafory z rozszerzenia *Steam 'n' Rails* dodają klimatyczne, klasyczne sygnalizatory świetlne i mechaniczne, które ułatwiają organizację ruchu w dużych węzłach kolejowych."]
	quest.3223B14E53AACFB5.quest_subtitle: "1x Semaphore"
	quest.3223B14E53AACFB5.title: "Kolejowa Semaforyka: Semaphore"
	quest.330DC46048D1DD2C.quest_desc: ["Miedziany wariant interfejsu przeładunkowego. Służy do bezprzewodowego wypompowywania i wpompowywania płynów (np. lawy lub oleju) z cystern pociągu w trakcie postoju na stacji."]
	quest.330DC46048D1DD2C.quest_subtitle: "1x Portable Fluid Interface"
	quest.330DC46048D1DD2C.title: "Przeładunek Płynów: Portable Fluid Interface"
	quest.3311B79A8F6C6ADD.quest_desc: ["&6&lEnchanting Table of the Raven&r to ostateczny stół do zaklinania, w którym możesz swobodnie ustawiać wartości &aEterna&r, &cQuanta&r oraz &5Arcana&r bez konieczności stawiania jakichkolwiek półek wokół!"]
	quest.3311B79A8F6C6ADD.quest_subtitle: "Rzekł Kruk: Nigdy więcej"
