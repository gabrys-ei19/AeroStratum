	quest.6A3841EB4433E273.title: "Dysk Danych 64k"
	quest.6A393C7A24899E3E.quest_desc: [
		"Umieszczenie surowca w &aMaterial Grader&r wraz z proszkiem katalitycznym nadaje materiałowi klasę jakości (od E aż do &6MAX&r)."
		""
		"Im wyższa klasa materiału, tym lepsze statystyki będzie miało wykute z niego narzędzie!"
