	quest.1C83657D7D6B7C2B.title: "Output Node: Exporter"
	quest.1C8C0210803B74A2.quest_desc: [
		"Time to build a full-scale &6Blast Furnace&r from &eTFMG&r! Prepare a &bBlast Furnace Output&r, a &bHatch&r, 19 fireproof brick blocks, and 20 corner reinforcements."
		""
		"Feed ores and coke in from the top through the hatch while molten metal or silicon flows out at the bottom into a casting basin."
	]
