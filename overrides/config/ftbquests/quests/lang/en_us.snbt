	quest.1204BCEDBE8D18EE.title: "Advanced Extrusion: Obsidian"
	quest.122E6E7CABCB17E7.quest_desc: ["&7Kitty Slippers&r make all Creepers flee from you in panic and reduce your fall damage."]
