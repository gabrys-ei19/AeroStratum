	quest.18B025CA634BFF11.title: "Stationary Bank 1k"
	quest.18DB8C875F2331B2.quest_desc: [
		"A kinetic belt manipulating gravity and momentum."
		""
		"• &5Arsenal Expansion&r: Increases the number of charm slots."
		"• &bGliding&r: Holding Space reduces gravity and lets you glide through the air (paired with &9Jellyfish Necklace&r it creates the &eElectric Arc&r synergy, leaving an electric trail in flight!)."
	]
	quest.18DB8C875F2331B2.quest_subtitle: "Master air momentum"
	quest.18DB8C875F2331B2.title: "&dKinetic Belt&r"
	quest.18E0F5A78F696FA3.quest_desc: ["The Echoing Rune applies a special effect to the spawner — all creatures summoned by it drop multiplied loot upon death."]
	quest.18E0F5A78F696FA3.title: "Echoing Rune"
	quest.191A7F3C9FBA4C13.quest_desc: [
