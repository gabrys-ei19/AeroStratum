	quest.38956DC28E317DEF.title: "&dSigil of Rebirth"
	quest.392EAE8BE71510C1.quest_desc: ["Beyond the Ender Dragon, in the void of &5The End&r rises a ruined citadel hiding a guardian of the void."]
