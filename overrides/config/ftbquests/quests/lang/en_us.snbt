	quest.1A52D891F39B3956.title: "Digital Tank"
	quest.1A8F438DB8508276.quest_desc: ["&3Frosted Prison&r is a massive mountain ice fortress hiding armories, prison cells, and the &3Cursed Tombstone&r."]
	quest.1A8F438DB8508276.title: "&3Frosted Prison&r: Lair of &3&lMaledictus"
	quest.1B344A2390B3E993.quest_desc: ["True power of the Age of Steam! Mount steam engines on a heated boiler made of Fluid Tanks powered by Blaze Burners to generate massive Stress Units (SU) for your entire factory."]
	quest.1B344A2390B3E993.quest_subtitle: "4x Steam Engine"
	quest.1B344A2390B3E993.title: "Heart of the Power Plant: Steam Engines"
	quest.1B4ED65C614B102F.quest_desc: ["&bIgnited Revenant&r shields itself with spinning shields — wait for it to drop its guard and defeat it to obtain &bBurning Ashes&r."]
