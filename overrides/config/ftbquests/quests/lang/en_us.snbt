	quest.002D65E4D7E8F62B.title: "Grader Catalyst II: Blazing Dust"
	quest.0089A394566B0F3B.quest_desc: [
		"&aUncommon&r is the second rarity tier, most common in the &2Frontier&r world tier."
		""
		"&aTimeworn Fabric&r is obtained by salvaging uncommon gear at the &c&lSalvaging Table&r."
	]
	quest.0089A394566B0F3B.quest_subtitle: "&aUncommon"
	quest.0089A394566B0F3B.title: "&aTimeworn Fabric"
	quest.00A1223DAAEB28BD.quest_desc: ["Cast used for pouring structural metal rods."]
	quest.00A1223DAAEB28BD.title: "Cast: Rod Cast"
	quest.00C26068B55F4FD9.quest_desc: ["The Silence Rune completely mutes sounds made by the spawner and the mobs summoned from it. Ideal for loud production halls!"]
	quest.00C26068B55F4FD9.title: "Silence in the Hall!"
	quest.010607466D565B53.quest_desc: ["&aRooted Boots&r slowly restore hunger and health when standing on grass, drawing nutrients from the ground."]
	quest.010607466D565B53.quest_subtitle: "Feet"
	quest.010607466D565B53.title: "&aRooted Boots"
	quest.01AFC11EAAB6CB3B.quest_desc: ["&eBone Reptile Armor&r forged from bones, Ancient Metal, and a Kobolediator Skull grants high defense and knockback resistance."]
	quest.01AFC11EAAB6CB3B.title: "&eBone Reptile Armor"
	quest.0223CC1700D49B6C.quest_desc: [
		"Combining brass with redstone circuitry creates an advanced control module."
		""
		"It is the heart of smart automation — from filtering chutes and sequencers to crafting terminals and Refined Storage autocrafters."
	]
	quest.0223CC1700D49B6C.quest_subtitle: "1x Brass Redstone Machine"
	quest.0223CC1700D49B6C.title: "Brass Logic: Brass Redstone Machine"
	quest.0251715AB65D8151.quest_desc: ["Cast used for pouring gems and crystals on a casting table."]
	quest.0251715AB65D8151.title: "Cast: Gem Cast"
	quest.02E1E48521F85EF6.quest_desc: [
		"Powerful, armored crushing wheels assembled in a Mechanical Crafter."
		""
		"Spinning opposite each other, they grind rocks and ores at high speed, granting extra resource yield and access to valuable dusts."
	]
	quest.02E1E48521F85EF6.quest_subtitle: "2x Crushing Wheel"
	quest.02E1E48521F85EF6.title: "Heavy Crushers: Crushing Wheels"
	quest.035A4D63CB792F6E.quest_desc: ["Precision joints forged from zinc sheet mimic the movement of a human hand. A key component for every automated assembly arm."]
	quest.035A4D63CB792F6E.quest_subtitle: "1x Zinc Hand"
	quest.035A4D63CB792F6E.title: "Mechanical Grip: Zinc Hand"
	quest.036D5767E07005BC.quest_desc: ["&bFoundry Drain&r lets you draw molten metal out of the furnace. Mount a tap (&7Foundry Tap&r) on it or attach fluid pipes!"]
	quest.036D5767E07005BC.title: "&c&lFoundry&r &bDrains"
	quest.037A93600E70561C.quest_desc: ["A unique module integrating the physical capacity of drawers with the structure of Refined Storage disks and storage blocks. An essential component for closing any storage drive."]
	quest.037A93600E70561C.quest_subtitle: "1x Digital Drawer"
	quest.037A93600E70561C.title: "Hybrid Buffer: Digital Drawer"
	quest.03926625AD63F168.quest_desc: ["Craft a &bNetwork Card&r and right-click a Network Receiver with it to record its exact coordinates before placing the card in a Network Transmitter."]
	quest.03926625AD63F168.quest_subtitle: "Addressing wireless bridges"
	quest.03926625AD63F168.title: "Connection Encoding: Network Card"
	quest.046B84EA84A40FA7.quest_desc: [
		"Budding Amethyst is the living heart of a geode where new crystals continuously grow."
		""
		"Secure it in place or craft your own via an infusion ritual to automate amethyst shard harvesting!"
	]
	quest.046B84EA84A40FA7.quest_subtitle: "1x Budding Amethyst"
	quest.046B84EA84A40FA7.title: "Heart of the Geode: Budding Amethyst"
	quest.047F3F99035CE623.quest_desc: ["Cast used for pouring a geological hammer that detects ore veins inside cave walls."]
	quest.047F3F99035CE623.quest_subtitle: "Ore vein prospector"
	quest.047F3F99035CE623.title: "Cast: Prospector Hammer"
	quest.0496E8E786262464.quest_desc: ["The &2Overworld&r hides up to 5 monumental structures inhabited by ancient Cataclysm bosses."]
	quest.0496E8E786262464.title: "&2Overworld&r: Land of 5 Bosses"
	quest.04B40BB107F14330.quest_desc: ["&4Meat Shredder&r is a mechanical rotary saw dealing rapid continuous damage when holding right-click."]
	quest.04B40BB107F14330.quest_subtitle: "Heavy mechanical saw"
	quest.04B40BB107F14330.title: "&4Meat Shredder"
	quest.04C59391A677A292.quest_desc: ["An empty armored protective casing ready to receive a storage core. Protects delicate quartz circuits from damage."]
	quest.04C59391A677A292.quest_subtitle: "1x Storage Housing"
	quest.04C59391A677A292.title: "Data Slot: Storage Housing"
	quest.0518551637F76C50.quest_desc: ["Upgrading a &9Deepshelf&r with candles and Echo Shards grants &5+15% Arcana&r and raises the Eterna cap to &a75&r."]
	quest.0518551637F76C50.title: "&9Echoing Deepshelf"
	quest.05BF22C32F17E9B5.quest_desc: ["Build the &6Huge Diesel Engine&r! This giant cylinder connected to a shaft via a connecting rod generates colossal amounts of SU when burning liquid fuels."]
	quest.05BF22C32F17E9B5.quest_subtitle: "Marine diesel engine with massive torque"
	quest.05BF22C32F17E9B5.title: "Piston Colossus: Huge Diesel Engine"
	quest.05DD778297C6611B.quest_desc: ["Diamond reinforcements provide huge cargo space and slots for advanced upgrade modules. With a backpack like this, you can carry half a factory on your back."]
	quest.05DD778297C6611B.quest_subtitle: "Strongest hauler in the crew"
	quest.05DD778297C6611B.title: "Diamond Backpack"
	quest.05DE9E1CDFBC22DE.quest_desc: ["&dVoid Scatter Arrows&r shatter upon hitting a target into a shower of shards that hurt all nearby enemies."]
	quest.05DE9E1CDFBC22DE.title: "&dVoid Scatter Arrows"
	quest.060CAF1582B83918.quest_desc: ["&eOccupied Village&r is a desert village taken over by &eKoboletons&r and &eWadjets&r. Free the trapped villagers and search the chests!"]
	quest.060CAF1582B83918.title: "&eOccupied Village"
	quest.061307A9C70E47B4.quest_desc: ["A heated basin with a mixer lets you melt copper and zinc into noble brass. This alloy opens the path to filtering, smart machines, and precision automation."]
	quest.061307A9C70E47B4.quest_subtitle: "1x Brass Ingot"
	quest.061307A9C70E47B4.title: "Engineers' Gold: Brass Alloy"
	quest.061A51A0EC13CA0F.quest_desc: [
		"To complete the Foundry multiblock structure:"
		""
		"1. Lay down a floor of &6Liquid Heating Coils&r."
		"2. Build 4 walls around the floor (corners can remain empty) using &cFire Bricks&r or &cFoundry Windows&r."
		"3. Install a &aController&r, &4Tank&r, and &bDrain&r in the walls."
		""
		"When the structure is valid, the controller lights up and the coils at the bottom turn orange!"
	]
	quest.061A51A0EC13CA0F.title: "Building the &c&lFoundry&r"
	quest.06F70F6CA37168CC.quest_desc: ["&6&oGem Case of House Fabergé&r is crafted by infusing a regular Gem Case and holds up to 2.1 billion of each unique gem!"]
	quest.06F70F6CA37168CC.quest_subtitle: "Gustav Fabergé would be proud"
	quest.06F70F6CA37168CC.title: "&6&oGem Case of House Fabergé"
	quest.073D0D41BA5F219B.quest_desc: [
		"A shield demanding split-second timing."
		""
		"• &4Retaliation&r: Activated at the last moment, it completely parries an incoming hit and counters the attacker (a failed parry briefly increases damage taken)."
	]
	quest.073D0D41BA5F219B.quest_subtitle: "+ PARRY"
	quest.073D0D41BA5F219B.title: "&cShield of Retaliation"
	quest.0741FABE57CA1A7D.quest_desc: ["&9Hippocamtus&r is an armored warrior with a shield and spear guarding the Acropolis. Like Cindaria, it drops &9Lacrima&r."]
	quest.0741FABE57CA1A7D.title: "&9Hippocamtus"
	quest.0794B19AAB6261EF.quest_desc: ["Combine stripped wood with Andesite Alloy by right-clicking placed wood with the alloy or crafting them together. Congratulations — you now have an official casing that holds gears and pistons in place without the contraption falling apart."]
	quest.0794B19AAB6261EF.quest_subtitle: "5x Andesite Casing"
	quest.0794B19AAB6261EF.title: "Andesite Casing"
	quest.083ABBA1C45FF960.quest_desc: ["Cast used for pouring a sickle that harvests crops and tall grass over a wide area."]
	quest.083ABBA1C45FF960.quest_subtitle: "Full-steam harvesting"
	quest.083ABBA1C45FF960.title: "Cast: Sickle Cast"
	quest.083ED9A55CB6F690.quest_desc: [
		"Don't let Creepers blow up your hard-earned machines and chests. This can also protect you from theft if you play with friends!"
		""
		"Open the world map with [ M ]."
		""
		"Click the icon of three overlapping squares in the top-left corner (Claimed Chunks)."
		""
		"Left-click squares (chunks) to claim them. They will become safe."
		""
		"Hold [ Shift ] + left-click a claimed chunk to Force Load it permanently. That way your farms and machines keep running even when you go on a long expedition!"
	]
	quest.083ED9A55CB6F690.quest_subtitle: "(Secure your base)"
	quest.083ED9A55CB6F690.title: "Mine Forever!"
	quest.0853917693A259C2.quest_desc: ["&3The Annihilator&r is a heavy warhammer — holding one in each hand and holding right-click unleashes a powerful seismic slam into the ground!"]
	quest.0853917693A259C2.title: "&3The Annihilator"
	quest.0864368D14D8B122.quest_desc: ["A &eTrack Observer&r emits a Redstone pulse when a train passes over it, letting you fully automate crossings, switches, and station logic."]
	quest.0864368D14D8B122.quest_subtitle: "1x Track Observer"
	quest.0864368D14D8B122.title: "Crossing Sensor: Track Observer"
	quest.0894EB1F3FCFCECA.quest_desc: ["&3Draugrs&r (regular, Royal, and Elite) are undead northern warriors wielding Black Steel weapons and shields."]
	quest.0894EB1F3FCFCECA.title: "&3Draugrs"
	quest.08FA7FE5154E54E0.quest_desc: [
		"Hand mining and simple minecart drills are a thing of the past. Using a Transmitter and advanced engineering, build a &6Create Quarry&r!"
		""
		"Once supplied with enough rotational power and bounded with stakes, the machine systematically mines out ores and stone all the way down to bedrock."
	]
	quest.08FA7FE5154E54E0.quest_subtitle: "Full automation of deep mining"
	quest.08FA7FE5154E54E0.title: "World Eater: Create Quarry"
	quest.091957223C32B094.quest_desc: ["To enter the Deepshelves stage, raise your &aMax Eterna&r cap to &a60&r, activating the &e&lAscent&r world tier."]
	quest.091957223C32B094.quest_subtitle: "Max Eterna: 60"
	quest.091957223C32B094.title: "&e&lAscent&r to 60 Eterna"
	quest.0931562098210538.quest_desc: ["Give a Blaze a Straw and instead of solid fuels it can drink liquid fuels, oils, and lava piped straight in!"]
	quest.0931562098210538.quest_subtitle: "4x Straw"
	quest.0931562098210538.title: "Liquid Fuel: Blaze Straws"
	quest.093786ED188CB158.quest_desc: ["Four times higher data packing density. A great choice when output from automated mines starts counting in the thousands."]
	quest.093786ED188CB158.quest_subtitle: "1x 4k Storage Part"
	quest.093786ED188CB158.title: "Denser Storage: 4k Core"
	quest.0947B4ED95B0267E.quest_desc: ["A protective coating applied on top of a finished weapon or tool (such as a netherite coating)."]
	quest.0947B4ED95B0267E.quest_subtitle: "Outer protective layer"
	quest.0947B4ED95B0267E.title: "Blueprint: Coating Blueprint"
	quest.0961A1F2AC4E3A5B.quest_desc: [
		"The world you find yourself in hides dark secrets. Ancient, monstrous beasts (from the Cataclysm mod) sleep deep inside giant structures — in ocean ruins, blazing castles in the Nether, or the voids of the End."
		""
		"Don't try to fight them early on. Without full netherite armor, strong swords, and plenty of potions, these monsters can wipe you out in a single hit. Explore carefully, prepare well, and only then go after their legendary drops!"
	]
	quest.0961A1F2AC4E3A5B.title: "Warning: Shadows in the Dark"
	quest.097FDC136BC843A7.quest_desc: [
		"The &6&lSummit&r tier requires wearing full &9Rare&r (or higher) gear and defeating the &0&lWither&r."
		""
		"• Unlocks &6Mythic&r loot and &zPerfect&r gems!"
		"• Player bonuses: +75% XP, +50% Luck, &a75 Eterna&r cap"
		"• Monster boosts: +12 Armor, +10 Armor Toughness, +15 Pierce"
	]
	quest.097FDC136BC843A7.title: "&lWorld Tier: &6Summit"
	quest.099C2A9B9CA138F8.quest_desc: [
		"&6Mythic&r is the highest item tier, available only in the &6Summit&r and &4Pinnacle&r world tiers!"
		""
		"&6Godforged Pearls&r are obtained by salvaging mythic gear at the &c&lSalvaging Table&r."
	]
	quest.099C2A9B9CA138F8.quest_subtitle: "&6Mythic"
	quest.099C2A9B9CA138F8.title: "&6Godforged Pearl"
	quest.09B4714399F4EB9E.quest_desc: ["Use your cast iron reserves to cast or forge a solid &6Cast Iron Block&r, needed to reinforce the base of large structures from &eTFMG&r."]
	quest.09B4714399F4EB9E.quest_subtitle: "Heavy structural reinforcement"
	quest.09B4714399F4EB9E.title: "Cast Iron Block"
	quest.0A1D4228271DECA3.quest_desc: ["Shrinks your character's size in half, letting you easily slip through 1-block-tall gaps."]
	quest.0A1D4228271DECA3.quest_subtitle: "Necklace"
	quest.0A1D4228271DECA3.title: "&5Charm of Shrinking&r"
	quest.0A3C464EF7CDD5F6.quest_desc: [
		"&4Hellshelves&r introduce the &cQuanta&r stat — each grants &a+3 Eterna&r and &c+3% Quanta&r."
		""
		"For the next step you need 15 of these shelves placed around the table plus 1 in your inventory to perform the infusion."
	]
	quest.0A3C464EF7CDD5F6.title: "&4Hellshelves"
	quest.0A43D38D27CF4304.quest_desc: ["&3Abandoned Spire&r is a smaller frozen fortress inhabited by undead &3Draugrs&r and the mighty &3Aptrgangr&r."]
	quest.0A43D38D27CF4304.title: "&3Abandoned Spire"
	quest.0B7F2B63D867D221.quest_desc: ["In the side chambers of the shaft leading to the bottom of the pyramid, use a Brush on Suspicious Sand to unearth the &eNecklace of the Desert&r and awaken the boss with it!"]
	quest.0B7F2B63D867D221.quest_subtitle: "Awaken Ancient Remnant"
	quest.0B7F2B63D867D221.title: "&eNecklace of the Desert"
	quest.0B98C898071F3C33.quest_desc: ["A regular campfire isn't enough to smelt noble alloys. Forge an iron burner cage, head to the Nether, and capture a Blaze inside it to gain a controlled source of extreme heat."]
	quest.0B98C898071F3C33.quest_subtitle: "1x Empty Blaze Burner"
	quest.0B98C898071F3C33.title: "Elemental Cage"
	quest.0BFD8B6ECABADB11.quest_desc: ["A metal whisk mounted in a Mechanical Mixer. Lets you rapidly combine liquids, resins, and molten metals."]
	quest.0BFD8B6ECABADB11.quest_subtitle: "1x Whisk"
	quest.0BFD8B6ECABADB11.title: "Spinning Blades: Whisk"
	quest.0C16D28641468295.quest_desc: ["An automated &bConstructor&r pulls blocks from your Refined Storage network and places them in the world in front of itself."]
	quest.0C16D28641468295.quest_subtitle: "1x Constructor"
	quest.0C16D28641468295.title: "Automated Builder: Constructor"
	quest.0C5E0742698881F0.quest_desc: ["Build the &6Reactor Core&r — the central part of the multiblock structure where the chain reaction heats the assembly."]
	quest.0C5E0742698881F0.quest_subtitle: "Heart of the fission process"
	quest.0C5E0742698881F0.title: "Reaction Chamber: Reactor Core"
	quest.0C6ADA0C7F766E65.quest_desc: ["Dark volcanic rock produced on demand without trips to the Nether."]
	quest.0C6ADA0C7F766E65.quest_subtitle: "64x Basalt"
	quest.0C6ADA0C7F766E65.title: "Extrusion: Basalt"
	quest.0D26E5EF6CFCFDBF.quest_desc: ["Cast used for pouring a knife blade — high durability and fast slashes."]
	quest.0D26E5EF6CFCFDBF.quest_subtitle: "Short blade"
	quest.0D26E5EF6CFCFDBF.title: "Cast: Knife Cast"
	quest.0DF4B01CC5B49E4E.quest_desc: ["Cast used for pouring a classic sword blade — balanced damage and attack speed."]
	quest.0DF4B01CC5B49E4E.quest_subtitle: "Reliable classic"
	quest.0DF4B01CC5B49E4E.title: "Cast: Sword Cast"
	quest.0E02CE4469FCA4C9.quest_desc: ["Adds a power switch to the spawner. Once this rune is applied, the spawner only runs when supplied with a Redstone signal."]
	quest.0E02CE4469FCA4C9.title: "Redstone Control"
	quest.0E1BC2AE1BE0BDFA.quest_desc: ["In Lush Caves you can come across an &2Amethyst Nest&r — a nest inhabited by a giant amethyst crab."]
	quest.0E1BC2AE1BE0BDFA.title: "&2Amethyst Nest"
	quest.0E716B90E60C486B.quest_desc: ["&4Panic Necklace&r grants a burst of movement speed immediately after taking damage, helping you quickly pull back from danger."]
	quest.0E716B90E60C486B.quest_subtitle: "Necklace"
	quest.0E716B90E60C486B.title: "&4Panic Necklace&r"
	quest.0E809204C288AAE9.quest_desc: ["A regular crafting table has its limits. Arranging at least 9 Mechanical Crafters into a matrix lets you assemble large machine parts, such as Crushing Wheels!"]
	quest.0E809204C288AAE9.quest_subtitle: "9x Mechanical Crafter"
	quest.0E809204C288AAE9.title: "Assembly Matrix: Mechanical Crafter"
	quest.0E90577AC72749C4.quest_desc: [
		"&6Thundering Spawner Upgrade Rune&r is the fourth, final spawner upgrade tier (requires an Endersurge gem from the End):"
		""
		"• Min and max delay: 20 ticks (1 second!)"
		"• Mobs per cycle: 16"
		"• Nearby entity cap: 32"
		"• Player activation range: 48 blocks"
	]
	quest.0E90577AC72749C4.title: "Upgrade Rune IV: Pinnacle"
	quest.0E95E4B31FAAA302.quest_desc: ["Having mastered the &dFrequency Mechanism&r, you can say goodbye to walking up to a stationary terminal. Connect a &bWireless Transmitter&r to your &dRefined Storage&r network to broadcast your digital storage signal around your base."]
	quest.0E95E4B31FAAA302.quest_subtitle: "Free your storage from cables"
	quest.0E95E4B31FAAA302.title: "Signal in the Ether: Wireless Transmitter"
	quest.0EE0946240B41A00.quest_desc: ["&bIgnitium Armor&r grants lava vision (helmet), Elytra integration (chestplate), faster fire extinguishment (leggings), and walking on lava surfaces (boots)!"]
	quest.0EE0946240B41A00.title: "&bIgnitium Armor"
	quest.0EF9F10A2178451F.quest_desc: ["All foundry bricks and structural blocks can be dyed any color — you can also freely mix colors within a single structure!"]
	quest.0EF9F10A2178451F.title: "&zColored &c&lFoundry&r Blocks"
	quest.0F0E227FC3EC0D90.quest_desc: ["Alternative creature-summoning systems and liquid experience solidification supporting factory automation."]
	quest.0F0E227FC3EC0D90.title: "Industrial Spawning"
	quest.0F3A0A4DC18E5E55.quest_desc: [
		"&aEterna&r determines the base enchanting level (strength of offered enchantments). Your maximum Eterna cap depends on your current &lWorld Tier&r:"
		""
		"• &a30&r in &9&lHaven&r"
		"• &a45&r in &2&lFrontier&r"
		"• &a60&r in &e&lAscent&r"
		"• &a75&r in &6&lSummit&r"
		"• &a100&r in &4&lPinnacle&r"
	]
	quest.0F3A0A4DC18E5E55.title: "Stat: &aEterna"
	quest.0F89BFD4A3F63A48.quest_desc: ["Makes the spawner completely ignore light levels — hostile monsters will spawn even in bright lamp light, though other requirements (like grass for farm animals) still apply."]
	quest.0F89BFD4A3F63A48.title: "Ignore Light"
	quest.0F8F0F7880235BA2.quest_desc: ["&cSoul Blacksmith&r is a monumental forge in the Nether full of gold and blackstone, guarded by the colossal &c&lNetherite Monstrosity&r."]
	quest.0F8F0F7880235BA2.title: "&cSoul Blacksmith&f: Lair of &c&lNetherite Monstrosity&r"
	quest.0FE2DBCBDD761DD0.quest_desc: ["A &eTrain Station&r is the heart of any logistics network. It lets you name trains, manage their assembly, and create schedules so trains run completely autonomously between your factories."]
	quest.0FE2DBCBDD761DD0.quest_subtitle: "1x Train Station"
	quest.0FE2DBCBDD761DD0.title: "Logistics Stop: Train Station"
	quest.0FEAD3CA2CC4A8B1.quest_desc: ["Tier 3 catalyst allowing you to apply the highest level of star charge."]
	quest.0FEAD3CA2CC4A8B1.title: "Star Catalyst III: Starmetal Dust"
	quest.10407EB6CEA8C111.quest_desc: ["Running tough obsidian through Crushing Wheels breaks it down into fine obsidian powder — a key intermediate for making train casings."]
	quest.10407EB6CEA8C111.quest_subtitle: "1x Powdered Obsidian"
	quest.10407EB6CEA8C111.title: "Volcanic Powder: Powdered Obsidian"
	quest.105442DA79829777.quest_desc: ["Combining an item with a &8Tome of Scrapping&r on an anvil extracts half of its enchantments onto the tome, destroying the item in the process."]
	quest.105442DA79829777.quest_subtitle: "Half enchantments, destroys item"
	quest.105442DA79829777.title: "&8Tome of Scrapping"
	quest.10630E102680BE46.quest_desc: ["A digital bank card linked to your account. Lets you pay at vending machines without carrying physical cash in your inventory."]
	quest.10630E102680BE46.quest_subtitle: "1x Bank Card"
	quest.10630E102680BE46.title: "Payment Card: Bank Card"
	quest.1102B27CBF564127.quest_desc: ["An extra module applied to a spawner that prevents summoned mobs from despawning when you walk away from your factory."]
	quest.1102B27CBF564127.quest_subtitle: "Don't vanish on me!"
	quest.1102B27CBF564127.title: "Spawner Agitator"
	quest.1113BF457DB7F1DE.quest_desc: ["The &6&lSummit&r world tier raises your &aMax Eterna&r cap to &a75&r, which is required for the hardest utility infusions."]
