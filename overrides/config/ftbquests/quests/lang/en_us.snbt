	quest.001A348054127235.quest_desc: ["Through &d&lInfusion&r of a regular Amethyst Block (at &a60 Eterna&r, &c30–50% Quanta&r, and &550% Arcana&r) you can create a portable &5Budding Amethyst&r to grow crystals!"]
	quest.001A348054127235.title: "Creating &5Budding Amethyst"
	quest.001C1881E9289566.quest_desc: [
		"&9Rare&r is the middle rarity tier, dominant in the &eAscent&r world tier."
		""
		"&9Luminous Crystal Shards&r are obtained by salvaging rare items at the &c&lSalvaging Table&r."
	]
	quest.001C1881E9289566.quest_subtitle: "&9Rare"
	quest.001C1881E9289566.title: "&9Luminous Crystal Shard"
