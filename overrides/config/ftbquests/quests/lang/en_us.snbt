	quest.35CB6AFD283E9A43.title: "Storage Master: Storage Controller"
	quest.35E42F7925CA097A.quest_desc: ["&dVoid Core&r lets you summon a line of void fangs and runes from the ground and serves as a key component in the Fusion Anvil."]
