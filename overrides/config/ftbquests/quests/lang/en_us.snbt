	quest.1C22288B92135426.title: "Stationary Bank 4k"
	quest.1C5EA7D62BAF2108.quest_desc: ["To awaken &5&lThe Leviathan&r, you must place an &5Abyssal Sacrifice&r on the altar — an item forged from metal blocks, amethyst, nautilus shell, Heart of the Sea, Athame dagger, and coral chunks."]
	quest.1C5EA7D62BAF2108.quest_subtitle: "Awaken Leviathan"
	quest.1C5EA7D62BAF2108.title: "&5Abyssal Sacrifice"
