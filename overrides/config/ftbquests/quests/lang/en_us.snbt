	quest.33938479111093D4.title: "Precision Pouring: Spout"
	quest.33B1D3FD4C0B5514.quest_desc: ["&e&lAncient Remnant&r is a colossal skeleton of a prehistoric predator commanding sandstorms and shockwaves."]
	quest.33B1D3FD4C0B5514.title: "&e&lAncient Remnant&r"
	quest.33BDEE1D6D8C50A6.quest_desc: ["A noble metal with excellent conductivity. Useful in advanced electronic components and special alloys."]
	quest.33BDEE1D6D8C50A6.quest_subtitle: "16x Silver Ingot"
	quest.33BDEE1D6D8C50A6.title: "Industrial Ores: Silver"
