	quest.7D13FBCC2E4441CA.quest_desc: [
		"When building a flying fortress or mobile base, keep basic laws of aerodynamics and physics in mind:"
		""
		"• &bCenter of Gravity:&r Arrange heavy machines, fuel tanks, and storage symmetrically around the craft's axis."
		"• &bChunk Protection:&r Always install area protection aboard so your craft doesn't freeze mid-air when you fly away."
		"• &bIndependent Power:&r Stock enough fuel aboard before heading out over the End void!"
	]
	quest.7D13FBCC2E4441CA.quest_subtitle: "Guide: Mass balance, buoyancy, and thrust"
	quest.7D13FBCC2E4441CA.title: "Aeronautical Engineering and Ship Physics"
	quest.7D1B8B794806ED54.quest_desc: [
		"A true engineer doesn't unload an airship by hand! Equip your landing pad with docking ports and &6Portable Storage Interface&r / &6Portable Fluid Interface&r blocks."
		""
		"Once the craft docks in the hangar, the interfaces automatically pump hauled loot straight into your &dRefined Storage&r network and top off fuel tanks for the next run."
	]
	quest.7D1B8B794806ED54.quest_subtitle: "Guide: Automated unloading at an air port"
