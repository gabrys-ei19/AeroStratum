	// =========================================================================
	// EPILOGUE IN WELCOME CHAPTER (wstep)
	// =========================================================================
	quest.5A9C1E7D3B8F0001.title: "Epilogue: Thank You from the Creator of AeroStratum"
	quest.5A9C1E7D3B8F0001.quest_subtitle: "From the first water wheel to conquering dimensions"
	quest.5A9C1E7D3B8F0001.quest_desc: [
		"&6Thank you for the shared journey through the world of AeroStratum: Integrated Engineering!&r"
		""
		"You've traveled the full path of industrial evolution — from simple kinetic gears and manual cast-iron smelting, through assembly lines, refineries, railways, and skies, all the way to nuclear power, infinite drives, and the darkest depths guarded by ancient titans."
		""
		"I hope designing integrated factories, fighting bosses, and uncovering this world's secrets brought you as much satisfaction as creating this pack gave me."
		""
		"&eYour factory is now complete, yet the world lies open before you — build without limits!&r"
	]
	task.5A9C1E7D3B8F0002.title: "Read the thank-you note and claim a commemorative Sun"
	// =========================================================================
	// NEW QUESTS IN ERA 2 (era_2_wiek_zaawansowanej_logistyki)
	// =========================================================================
	quest.69B7E06793B75BAA.title: "Network Relay: Relay"
	quest.69B7E06793B75BAA.quest_subtitle: "Controlling signal and power flow in an RS network"
	quest.69B7E06793B75BAA.quest_desc: [
		"As you expand your &dRefined Storage&r network, you'll appreciate cleanly separating or controlling individual branches."
		""
		"Construct a &bRelay&r to manage network connections across your infrastructure."
	]

	quest.7EA09E5F90FC82E0.title: "Logistics Bridge: StockBridge Interface"
	quest.7EA09E5F90FC82E0.quest_subtitle: "Linking digital storage with physical logistics"
	quest.7EA09E5F90FC82E0.quest_desc: [
		"Craft a &6StockBridge Network Interface&r to integrate resources from your &dRefined Storage&r network with automated transfer and processing systems."
	]

	quest.2B3211457B2E7F04.title: "Empty Matrix: Empty Infinity Drive"
	quest.2B3211457B2E7F04.quest_subtitle: "Casing for drives with infinite capacity"
	quest.2B3211457B2E7F04.quest_desc: [
		"Prepare an &dEmpty Infinity Drive&r on a &6Create&r assembly line."
		""
		"This carrier serves as the base you'll combine in a Smithing Table with an era core and a 6x compressed block to get an inexhaustible source of material."
	]

	quest.578E62D92EBF947D.title: "Infinity Server: Infinity Storage Drive Block"
	quest.578E62D92EBF947D.quest_subtitle: "Station supporting infinite drives"
	quest.578E62D92EBF947D.quest_desc: [
		"Build an &dInfinity Storage Drive Block&r in a Smithing Table from a standard Disk Drive and an empty casing."
		""
		"Infinite drives placed inside give your network steady access to huge amounts of chosen materials."
	]

	quest.7CBF0E8A507DB4BB.title: "Infinite Ocean: Infinity Water Drive"
	quest.7CBF0E8A507DB4BB.quest_subtitle: "Inexhaustible water source in storage"
	quest.7CBF0E8A507DB4BB.quest_desc: [
		"Forge an &bInfinity Water Drive&r in a Smithing Table using a &6Precision Mechanism&r and compressed material."
		""
		"From now on, water for steam boilers, mixers, and cooling won't be a logistics bottleneck."
	]

	quest.66A5A22E72E19579.title: "Infinite Cobble: Infinity Cobblestone Drive"
	quest.66A5A22E72E19579.quest_subtitle: "Foundation for mass resource production"
	quest.66A5A22E72E19579.quest_desc: [
		"Prepare an &bInfinity Cobblestone Drive&r — a key drive for automated crushers, millstones, and gravel, sand, and ore producers."
	]

	quest.34A6709E4ACB59E2.title: "Infinite Desert: Infinity Sand Drive"
	quest.34A6709E4ACB59E2.quest_subtitle: "Inexhaustible sand for glass, concrete, and silica"
	quest.34A6709E4ACB59E2.quest_desc: [
		"Forge an &dInfinity Sand Drive&r in a Smithing Table using a &6Precision Mechanism&r and 6x compressed sand."
		""
		"Ideal support for continuous glass smelting and building material production."
	]

	quest.61823FDF90EBE70D.title: "Infinite Soil: Infinity Dirt Drive"
	quest.61823FDF90EBE70D.quest_subtitle: "Inexhaustible dirt for farms and compression"
	quest.61823FDF90EBE70D.quest_desc: [
		"Forge an &dInfinity Dirt Drive&r in a Smithing Table using a &6Precision Mechanism&r and 6x compressed dirt."
	]

	// =========================================================================
	// NEW QUESTS IN ERA 3 (era_3_wiek_balonw_i_lotnictwa)
	// =========================================================================
	quest.523AB77A2E804CDF.title: "Infinite Slate: Infinity Deepslate Drive"
	quest.523AB77A2E804CDF.quest_subtitle: "Deep structural material without limit"
	quest.523AB77A2E804CDF.quest_desc: [
		"Forge an &dInfinity Deepslate Drive&r in a Smithing Table using a &dFrequency Mechanism&r and &86x Compressed Deepslate&r."
	]

	quest.6FFA2284CDDEC6B0.title: "Infinite Netherrack: Infinity Netherrack Drive"
	quest.6FFA2284CDDEC6B0.quest_subtitle: "Fiery resource within reach"
	quest.6FFA2284CDDEC6B0.quest_desc: [
		"Forge an &dInfinity Netherrack Drive&r in a Smithing Table using a &dFrequency Mechanism&r and 6x compressed netherrack."
	]

	quest.000FB117B92126C4.title: "Infinite Basalt: Infinity Basalt Drive"
	quest.000FB117B92126C4.quest_subtitle: "Volcanic stone for heavy builds"
	quest.000FB117B92126C4.quest_desc: [
		"Forge an &dInfinity Basalt Drive&r in a Smithing Table using a &dFrequency Mechanism&r and 6x compressed basalt."
	]

	quest.77647D6BBDF67E19.title: "Infinite Magma: Infinity Lava Drive"
	quest.77647D6BBDF67E19.quest_subtitle: "Uninterrupted source of heat and liquid fuel"
	quest.77647D6BBDF67E19.quest_desc: [
		"Forge an &cInfinity Lava Drive&r in a Smithing Table using a &dFrequency Mechanism&r, ensuring a steady flow of lava to power machines, furnaces, and resource generation."
	]
	// =========================================================================
	// CHAPTER: ERA 4 - AGE OF WORLD CONQUEST (era_4_wiek_podpoju_wiata)
	// =========================================================================
	chapter.0A24069F4A6D554B.title: "Era 4: Age of World Conquest"

	quest.41D3439D7E8184D2.title: "Network Omnipotence: Dimension Card"
	quest.41D3439D7E8184D2.quest_subtitle: "Access to your Refined Storage network in any dimension"
	quest.41D3439D7E8184D2.quest_desc: [
		"Install a &dDimension Card&r in your wireless transmitter to use your main storage resources in the Nether, the End, and other dimensions."
		""
		"&eNote:&r Cross-dimensional links draw noticeably higher power (&cFE/t&r), so make sure your power supply is stable."
	]

	quest.02EB7BAD11591BC3.title: "Infinite End Stone"
	quest.02EB7BAD11591BC3.quest_subtitle: "Infinity Endstone Drive"
	quest.02EB7BAD11591BC3.quest_desc: [
		"Forge an &dInfinity Endstone Drive&r in a Smithing Table using a &6Calibrated Eye&r, an empty casing, and 6x compressed end stone."
		""
		"Placed inside a drive block, it provides an uninterrupted supply of End material for further builds and processing."
	]

	quest.661A1235E0C89214.title: "Infinite Dragon's Breath"
	quest.661A1235E0C89214.quest_subtitle: "Infinity Dragon's Breath Drive"
	quest.661A1235E0C89214.quest_desc: [
		"Create an &5Infinity Dragon's Breath Drive&r using a &6Calibrated Eye&r to gain an inexhaustible source of dragon's breath for advanced alchemy and infusion."
	]

	quest.433893AF906A8DBF.title: "Descent into the Depths: Deep Dark Expedition"
	quest.433893AF906A8DBF.quest_subtitle: "Preparing to harvest materials from the Deep Dark"
	quest.433893AF906A8DBF.quest_desc: [
		"You've calibrated the Eye of Destiny — time to descend into the shadows of the &3Deep Dark&r and Ancient Cities to gather materials for forging the strongest gear in the pack."
	]
	task.532247A98A6AB3F9.title: "Begin the Deep Dark expedition"

	quest.646EF888C6D39B09.title: "Smithing of the Depths: Echo Ingot and Template"
	quest.646EF888C6D39B09.quest_subtitle: "Key materials for Echo upgrades"
	quest.646EF888C6D39B09.quest_desc: [
		"Obtain an &3Echo Ingot&r and an &3Echo Upgrade Smithing Template&r from &3Create: Deep Dark&r."
		""
		"At a Smithing Table they let you upgrade netherite armor and weapons into &3Echo&r tier gear for facing &cCataclysm&r bosses."
	]

	quest.0D16D3E2CE3AD444.title: "Echo Helmet"
	quest.0D16D3E2CE3AD444.quest_subtitle: "Deep head protection"
	quest.0D16D3E2CE3AD444.quest_desc: [
		"Upgrade a netherite helmet at a Smithing Table using an Echo ingot and template to craft an &3Echo Helmet&r."
	]

	quest.5DCE15A8D3869361.title: "Echo Chestplate"
	quest.5DCE15A8D3869361.quest_subtitle: "Primary defense against heavy boss strikes"
	quest.5DCE15A8D3869361.quest_desc: [
		"Forge an &3Echo Chestplate&r — a sturdy armor foundation for the toughest encounters in &4Era 4&r."
	]

	quest.404FC96FD774299D.title: "Echo Leggings"
	quest.404FC96FD774299D.quest_subtitle: "Reinforced leg protection"
	quest.404FC96FD774299D.quest_desc: [
		"Upgrade netherite leggings at a Smithing Table into &3Echo Leggings&r."
	]

	quest.455738F7FC2E8490.title: "Echo Boots"
	quest.455738F7FC2E8490.quest_subtitle: "Final piece of the deep armor set"
	quest.455738F7FC2E8490.quest_desc: [
		"Complete your full deep armor set by crafting &3Echo Boots&r."
	]

	quest.7852E718281B2AA2.title: "Echo Sword"
	quest.7852E718281B2AA2.quest_subtitle: "Weapon forged from the essence of the depths"
	quest.7852E718281B2AA2.quest_desc: [
		"Reforge a netherite sword into an &3Echo Sword&r to gain a powerful blade for battling bosses."
	]

	quest.7F1A8E4B9C2D0001.title: "Era 4 Finale: World Conquest Complete"
	quest.7F1A8E4B9C2D0001.quest_subtitle: "Final completion of the main storyline"
	quest.7F1A8E4B9C2D0001.quest_desc: [
		"You've completed the key goals of &4Era 4&r — cross-dimensional connectivity, infinite storage media, full &3Echo&r gear, and defeating all &cCataclysm&r bosses."
		""
		"Click the checkmark to claim your final reward and unlock the &6Koniec Gry&r stage."
	]
	task.7F1A8E4B9C2D0002.title: "Claim the Era 4 finale reward"
}