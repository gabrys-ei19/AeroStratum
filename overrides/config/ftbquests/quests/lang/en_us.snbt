	quest.122E6E7CABCB17E7.title: "&7Kitty Slippers&r"
	quest.12449D23295CF9ED.quest_desc: [
		"A sea relic found in ocean ruins and shipwrecks."
		""
		"• &bAquatic Regeneration&r: Increases max health and regeneration while in water or rain."
		"• &9Electric Discharge&r: Builds up an electric charge that unleashes a chaining paralyzing shock on contact with an enemy!"
	]
	quest.12449D23295CF9ED.quest_subtitle: "Electrifying grasp of the depths"
	quest.12449D23295CF9ED.title: "&9Jellyfish Necklace"
	quest.12D103672723A875.quest_desc: [
		"Smelt quartz in the Blast Furnace to cast your first &bSilicon Ingot&r!"
