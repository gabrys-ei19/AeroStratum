	quest.7F4963FCAE5337EC.quest_subtitle: "Kindling the altar"
	quest.7F4963FCAE5337EC.title: "&bBurning Ashes"
	quest.7F6B66566C211735.quest_desc: ["The Weakening Rune lowers the starting health of summoned mobs (down to 20% of their max HP), greatly speeding up automated mob farms."]
	quest.7F6B66566C211735.title: "Health Reduction"
	quest.7F85B2BF7D561259.quest_desc: [
		"Before your factory reaches temperatures required to smelt industrial steel, you need a material with higher thermal resistance."
		""
		"Produce &616 Cast Iron Ingots&r. They will go toward building your first high-pressure pipes, blast furnace reinforcements, and magnetic alloys for alternators."
	]
	quest.7F85B2BF7D561259.quest_subtitle: "Foundation for heavy TFMG metallurgy"
	quest.7F85B2BF7D561259.title: "Early Metallurgy: Cast Iron"
	quest.7FF173A78D72F662.quest_desc: [
		"It's done. You've combined a casing, cogwheels, and Andesite Alloy into one working whole. This machine is your ticket to automation. It will let you effortlessly press iron into plates, make sheets, and process resources at a speed an ordinary miner can only dream of."
		""
		"Era 0 is officially complete. Welcome to the Age of Steam and Iron!"
	]
	quest.7FF173A78D72F662.quest_subtitle: "Era 0 Milestone"
	quest.7FF173A78D72F662.title: "Andesite Machine"
