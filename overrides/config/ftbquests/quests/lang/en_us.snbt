	quest.11DBC70D36451A8D.title: "64b Fluid Disk"
	quest.1204BCEDBE8D18EE.quest_desc: ["Efficient, hands-off obsidian production in a brass extruder — the foundation for mass-producing Sturdy Sheets and advanced casings."]
