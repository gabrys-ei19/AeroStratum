		""
		"12 of these shelves are enough to infuse a &9Dormant Deepshelf&r!"
	]
	quest.191A7F3C9FBA4C13.title: "&bCrystalline Seashelf"
	quest.196312DF0D2E2CB6.quest_desc: [
		"&4Invaders&r are Apotheosis mini-bosses that spawn in every dimension and drop gems and affix items."
