	quest.3ECDF40CC01FA01E.title: "Quartz Alloys"
	quest.3EE5013CCEC66EF8.quest_desc: ["An infinite source of Netherrack straight from a brass extruder — ideal for milling into Cinder Flour to make Blaze Cakes!"]
	quest.3EE5013CCEC66EF8.quest_subtitle: "64x Netherrack"
	quest.3EE5013CCEC66EF8.title: "Advanced Extrusion: Netherrack"
	quest.3F1430ADB648102F.quest_desc: [
		"&aFrontiersman's Spawner Upgrade Rune&r is the first tier of upgrade runes that set all spawner stats to fixed values:"
		""
		"• Min delay: 150 ticks"
		"• Max delay: 600 ticks"
		"• Mobs per cycle (Spawn Count): 7"
		"• Nearby entity cap (Max Entities): 12"
		"• Player activation range: 24 blocks"
	]
	quest.3F1430ADB648102F.title: "Upgrade Rune I: Frontier"
	quest.3F39BEB788175CEF.quest_desc: ["Cast used for pouring a heavy excavator that clears dirt, sand, and gravel in a 3x3 area!"]
	quest.3F39BEB788175CEF.quest_subtitle: "3x3 digging!"
	quest.3F39BEB788175CEF.title: "Cast: Excavator Cast"
	quest.3F56A5253D477B97.quest_desc: ["Blueprint for crafting fletching that stabilizes Silent Gear arrows."]
	quest.3F56A5253D477B97.title: "Blueprint: Fletching Blueprint"
	quest.40096ED0B04C3EC5.quest_desc: ["Makes the spawner ignore almost all environmental requirements: light level, ground type, and biome (only empty physical space for the mob to appear is still required)."]
	quest.40096ED0B04C3EC5.title: "Ignore Conditions"
	quest.400E5AD3B2378A9F.quest_desc: ["Lets you manage security cards and define which players are allowed to view, modify, or expand your Refined Storage network."]
	quest.400E5AD3B2378A9F.quest_subtitle: "1x Security Manager"
	quest.400E5AD3B2378A9F.title: "Network Firewall: Security Manager"
	quest.405DCD3E36232EEA.quest_desc: ["Cast used for pouring a spearhead — lower base damage, but significantly longer attack reach."]
	quest.405DCD3E36232EEA.quest_subtitle: "Phalanx reach"
	quest.405DCD3E36232EEA.title: "Cast: Spear Cast"
	quest.40AB457E37919ABE.quest_desc: [
		"A potent Nether ring granting its wearer &57 abilities&r corresponding to the seven deadly sins:"
		""
		"• &dPride&r: More damage when attacking a target below you."
		"• &aEnvy&r: More damage against enemies with more health than you."
		"• &4Wrath&r: A brief window of massive damage after your first strike."
		"• &8Sloth&r: Invulnerability while standing still at the cost of taking more damage while moving."
		"• &6Greed&r: Increases luck and loot."
		"• &2Gluttony&r: Boosts stats when your hunger bar is full."
		"• &5Lust&r: Chance for extra offspring when breeding animals."
	]
	quest.40AB457E37919ABE.quest_subtitle: "Seven blessings and seven curses"
	quest.40AB457E37919ABE.title: "&cRing of the Seven Deadly Sins"
	quest.40D92BD3F935D0E8.quest_desc: ["A steady source of cold and ice for thermal processes."]
	quest.40D92BD3F935D0E8.quest_subtitle: "64x Snow Block"
	quest.40D92BD3F935D0E8.title: "Extrusion: Snow Block"
	quest.40DD894C85D0FC54.quest_desc: [
		"Carrying pouches full of gold coins during cave dives or dungeon raids is asking for trouble. It's time to switch to modern electronic banking!"
		""
		"&lFinancial Tools:&r"
		"• &bBank Terminal:&r Lets you safely deposit and withdraw earned coins into your personal bank account from anywhere in the world."
		"• &aBank Card:&r Once linked to your account, you can pay directly at other players' Vendors without pulling out cash. You can also insert a card into your own Vendor so sales revenue goes straight into your account!"
		"• &6Blaze Banker:&r A special banker that lets you open a shared company account for your whole team and manage partner permissions via &eID Cards&r."
	]
	quest.40DD894C85D0FC54.quest_subtitle: "Safe capital on a card"
	quest.40DD894C85D0FC54.title: "Cashless Payments"
	quest.4119E115505036E5.quest_desc: ["Cast allowing you to pour small metal nuggets."]
	quest.4119E115505036E5.title: "Cast: Nugget Cast"
	quest.414FE7C3B16B1F76.quest_desc: ["The pinnacle of digital automation from ExtraStorage — the Netherite Autocrafter rapidly fulfills even the most complex crafting chains."]
	quest.414FE7C3B16B1F76.quest_subtitle: "1x Netherite Crafter"
	quest.414FE7C3B16B1F76.title: "Netherite Autocrafter"
	quest.41AF7613B31A51A4.quest_desc: [
		"Infinite-range wireless networks, automated &6Create Quarry&r rigs, and large-scale autocrafting consume colossal amounts of rotational power (SU) and electricity (FE)."
		""
		"Check this task to unlock &aSub-Era 3.5: Age of the Atom and Mass Expansion&r — a chapter entirely dedicated to massive combustion engines, turbines, and building a nuclear reactor!"
	]
	quest.41AF7613B31A51A4.quest_subtitle: "Gateway to Sub-Era 3.5"
	quest.41AF7613B31A51A4.title: "Threshold of the Atom and Heavy Power"
	quest.41B05A85F70439BD.quest_desc: ["Combining a copper casing with a copper mechanism creates a watertight base frame for building steam and pressurized apparatus."]
	quest.41B05A85F70439BD.quest_subtitle: "1x Copper Machine"
	quest.41B05A85F70439BD.title: "Core of Hydraulics: Copper Machine"
	quest.42238D09992C1B0D.quest_desc: ["Tamed Nether flame! Feed the Blaze coal or liquid fuel to heat basins for brass smelting and power massive steam boilers."]
	quest.42238D09992C1B0D.quest_subtitle: "1x Blaze Burner"
	quest.42238D09992C1B0D.title: "Heart of the Furnace: Blaze Burner"
	quest.427014BDE06DE631.quest_desc: ["&cFire Gauntlet&r sets every melee strike ablaze, igniting your opponent!"]
	quest.427014BDE06DE631.quest_subtitle: "Hands"
	quest.427014BDE06DE631.title: "&cFire Gauntlet&r"
	quest.42746659C66CF17F.quest_desc: ["&6&oLibrary of Alexandria&r is created by infusing a standard Enchantment Library and raises the storage limit of every enchantment from 32 thousand up to 1.1 billion points!"]
	quest.42746659C66CF17F.quest_subtitle: "If Alexandria had never burned..."
	quest.42746659C66CF17F.title: "&6&oLibrary of Alexandria"
	quest.427516AA3E8C9442.quest_desc: ["Cast used for pouring a mattock combining the functions of a hoe, axe, and shovel."]
	quest.427516AA3E8C9442.quest_subtitle: "All-in-one garden tool"
	quest.427516AA3E8C9442.title: "Cast: Mattock Cast"
	quest.4279865600998487.quest_desc: ["Rubber-sealed copper pipes let you transport water, steam, lava, and chemicals between tanks and machines."]
	quest.4279865600998487.quest_subtitle: "1x Fluid Pipe"
	quest.4279865600998487.title: "Copper Piping: Fluid Pipe"
	quest.42D7C8CD8E6F5CD7.quest_desc: ["The Stupor Rune completely disables the artificial intelligence (AI) of summoned creatures. Mobs won't move, teleport, or attack while waiting for belt transport."]
	quest.42D7C8CD8E6F5CD7.title: "Disable AI (No AI)"
	quest.42E44B6C8CDF031D.quest_desc: ["Every self-respecting engineer needs a stock of zinc, andesite, copper, iron, and gold sheets. Set up a press over a belt or depot and prepare a batch for building advanced components."]
	quest.42E44B6C8CDF031D.quest_subtitle: "Industrial Sheet Set"
	quest.42E44B6C8CDF031D.title: "Rolling Mill at Full Steam"
	quest.43167C59036E79A7.quest_desc: ["&8Tool \\& Fishing Tomes&r roll only mining enchantments (Efficiency, Fortune, Silk Touch) or fishing enchantments."]
	quest.43167C59036E79A7.title: "&8Tool Tomes"
	quest.435142F6D4B99460.quest_desc: ["Construct a &6Radial Engine&r. Its signature arrangement of cylinders around the crankshaft provides excellent air cooling and massive thrust for your Era 3 flying machines."]
	quest.435142F6D4B99460.quest_subtitle: "Powerful propulsion for heavy airships and aircraft"
	quest.435142F6D4B99460.title: "Star of Aviation: Radial Engine"
	quest.436E4E3515BCCDE9.quest_desc: ["&bCloud in a Bottle&r lets you perform a double jump in mid-air (press Space twice) and reduces fall damage."]
	quest.436E4E3515BCCDE9.quest_subtitle: "Belt"
	quest.436E4E3515BCCDE9.title: "&bCloud in a Bottle&r"
	quest.43A5B83862D9E94C.quest_desc: ["&bEye of Flame&r points across the Nether toward the &bBurning Arena&r, where &b&lIgnis&r awaits."]
	quest.43A5B83862D9E94C.title: "&bEye of Flame&r"
	quest.43B52BE28D14514D.quest_desc: ["The lifeblood of logic circuits, rose quartz, and Refined Storage memory cores. The more you mine, the better."]
	quest.43B52BE28D14514D.quest_subtitle: "64x Redstone"
	quest.43B52BE28D14514D.title: "Industrial Ores: Redstone"
	quest.43B5BA3A5CE95E7A.quest_desc: ["A heavy insulating metal that proves invaluable when building advanced accumulators and reactor shielding in later eras."]
	quest.43B5BA3A5CE95E7A.quest_subtitle: "16x Lead Ingot"
	quest.43B5BA3A5CE95E7A.title: "Industrial Ores: Lead"
	quest.43D13FD7FDF29A61.quest_desc: ["Moving materials between machines by hand wastes precious time. Connect stations with Belts, Chutes, and Funnels so resources flow automatically."]
	quest.43D13FD7FDF29A61.quest_subtitle: "Belt, Chute & Funnel"
	quest.43D13FD7FDF29A61.title: "Factory Lifeblood: Belts and Chutes"
	quest.43DA4C62DD1CD392.quest_desc: ["The hardest mineral in the game, essential for advanced processors and top-tier tools."]
	quest.43DA4C62DD1CD392.quest_subtitle: "16x Diamond"
	quest.43DA4C62DD1CD392.title: "Treasures of the Deep: Diamonds"
	quest.43F91487B5B6FD41.quest_desc: ["Break fireclay blocks into &6Fireclay Balls&r, ready to be fired in a furnace into specialized metallurgical ceramics."]
	quest.43F91487B5B6FD41.quest_subtitle: "Processing refractory clay"
	quest.43F91487B5B6FD41.title: "Shaping Fireclay"
	quest.445C9117198936B6.quest_desc: ["The shoulder-mounted &4W.A.S.W.&r rocket launcher fires homing missiles (right-click) or a heavy mortar barrage (Shift + right-click)."]
	quest.445C9117198936B6.title: "&4W.A.S.W. (Wither Assault Shoulder Weapon)"
	quest.4494D77B49C5F925.quest_desc: ["Greenish copper-bearing stone. Once crushed, it keeps your factory supplied with steady copper."]
	quest.4494D77B49C5F925.quest_subtitle: "64x Veridium"
	quest.4494D77B49C5F925.title: "Extrusion: Veridium (Copper)"
	quest.45161821C221EF0B.quest_desc: [
		"With 15 &4Hellshelf&r blocks around the table you reach &a45 Eterna&r and &c30% Quanta&r — the exact stats needed to create &4Infused Hellshelves&r!"
		""
		"Each infused shelf grants &a+5 Eterna&r (capped at &a60&r) and &c+5% Quanta&r."
	]
	quest.45161821C221EF0B.title: "&4Infused Hellshelves"
	quest.451788130D250037.quest_desc: ["Modular liquid tanks. Combine 16 of them into a large boiler above Blaze Burners and pipe in water with a pump to prepare the base for a steam power plant!"]
	quest.451788130D250037.quest_subtitle: "16x Fluid Tank"
	quest.451788130D250037.title: "Silos and Boilers: Fluid Tank"
	quest.45647395169978ED.quest_desc: [
		"To obtain &9Gem Dust&r, drop unwanted gems on the ground and let a falling &7&lAnvil&r crush them!"
		""
		"Use the resulting powder to craft the Salvaging Table, Reforging Table, and sigils."
	]
	quest.45647395169978ED.title: "&9Gem Dust"
	quest.4564B577CB4EC046.quest_desc: ["&cEverlasting Beef&r is an ultra-rare drop from cows — a piece of raw beef that isn't consumed when eaten (it only has a short cooldown and works with a backpack feeding upgrade!)."]
	quest.4564B577CB4EC046.quest_subtitle: "Unique"
	quest.4564B577CB4EC046.title: "&cEverlasting Beef&r"
	quest.45899579D9B92D91.quest_desc: ["The &aFoundry Controller&r is the heart of your multiblock foundry. In its interface you monitor temperature, molten metal levels, and load ores and ingots for smelting."]
	quest.45899579D9B92D91.title: "&c&lFoundry&r &aController"
	quest.45FBEABEBA7CC09E.quest_desc: ["&5Sunken City&r is a vast underwater metropolis with a central dome housing the &5Altar of the Abyss&r, inhabited by &5Deeplings&r and coral guardians."]
	quest.45FBEABEBA7CC09E.title: "&5Sunken City&r: Lair of &5&lThe Leviathan&r"
	quest.462C1F75A2FB9F02.quest_desc: ["Cast used for pouring a modular fishing rod."]
	quest.462C1F75A2FB9F02.quest_subtitle: "Gone fishing!"
	quest.462C1F75A2FB9F02.title: "Cast: Fishing Rod Cast"
	quest.462D173D576A8D91.quest_desc: ["&eAncient Metal&r obtained from pyramid guardians lets you forge reptile armor and the Ancient Spear."]
	quest.462D173D576A8D91.title: "&eAncient Metal"
	quest.465B08461B460DAC.quest_desc: ["&dEndermaptera&r are armored End insects inhabiting the Ruined Citadel. Slay them quickly before they shatter their own mandibles (&dVoid Jaw&r)!"]
	quest.465B08461B460DAC.quest_subtitle: "Void insects"
	quest.465B08461B460DAC.title: "&dEndermaptera"
	quest.465EB60C6F6DF7A3.quest_desc: [
		"With a &6Linked Controller&r and &6Linked Typewriter&r, you can build a full captain's cockpit:"
		""
		"1. Place &cRedstone Links&r in receiver mode (with antenna) next to gearshifts, clutches, and rudders."
		"2. Assign unique item pairs as frequency channels for main thrust, steering, and altitude control."
		"3. Sit in the pilot seat in front of the console to take full command of the craft!"
	]
	quest.465EB60C6F6DF7A3.quest_subtitle: "Guide: Configuring onboard frequencies"
	quest.465EB60C6F6DF7A3.title: "Telemetry and Control Mapping"
	quest.466DCFD1A0975A61.quest_desc: ["The standard structural frame for all Refined Storage digital devices. Your machines now step into the information age."]
	quest.466DCFD1A0975A61.quest_subtitle: "1x Machine Casing"
	quest.466DCFD1A0975A61.title: "Network Foundation: Machine Casing"
	quest.46C2B6B25AD1ED93.quest_desc: ["A specialized terminal (&bPattern Grid&r) that lets you transfer recipes from EMI onto blank Patterns with a single click."]
	quest.46C2B6B25AD1ED93.quest_subtitle: "1x Pattern Grid"
	quest.46C2B6B25AD1ED93.title: "Blueprint Programmer: Pattern Grid"
	quest.46CC8E7ED59F51D2.quest_desc: ["&5Tidal Claws&r are a guaranteed drop from The Leviathan. Left-click fires a chaining attack through up to 5 targets, while right-click acts as a grappling hook pulling you toward blocks and enemies!"]
	quest.46CC8E7ED59F51D2.title: "&5Tidal Claws"
	quest.474AF9F90C8E40A2.quest_desc: ["Blueprint for forging a mace head that deals massive fall-damage strikes."]
	quest.474AF9F90C8E40A2.title: "Blueprint: Mace Blueprint"
	quest.4768E04E1E7DC172.quest_desc: ["A diagnostic screen displaying real-time progress for all active autocrafting jobs and any missing materials."]
	quest.4768E04E1E7DC172.quest_subtitle: "1x Autocrafting Monitor"
	quest.4768E04E1E7DC172.title: "Production Control: Autocrafting Monitor"
	quest.479018DD12B5D1DD.quest_desc: ["A massive standalone server block holding up to 65,536 items directly on your network."]
	quest.479018DD12B5D1DD.quest_subtitle: "1x 64k Storage Block"
	quest.479018DD12B5D1DD.title: "Stationary Bank 64k"
	quest.48D358470A019E7A.quest_desc: ["Tier 1 catalyst required for star charging in the Starlight Charger."]
	quest.48D358470A019E7A.title: "Star Catalyst I: Blaze Gold Dust"
	quest.48DB0587E8C58888.quest_desc: [
		"Your own Vendor (&eAndesite&r or &6Brass Vendor&r) is a personal, fully automated shopkeeper that other players cannot break or rob."
		""
		"&lHow to set up a booth?&r"
		"1. Place a Vendor where you want it and right-click it (hold &e[ Shift ]&r to open the owner panel)."
		"2. Insert the item you're selling as the offer template and set its price in &eNumismatics&r coins (you can also switch the machine to buy items from other players!)."
		"3. Fill its internal inventory with stock to sell."
		""
		"&aSupply Automation:&r Vendors can be restocked from the back or bottom using hoppers, chutes, and &bRefined Storage&r exporters, keeping popular goods available around the clock!"
	]
	quest.48DB0587E8C58888.quest_subtitle: "Earn coins even while you sleep"
	quest.48DB0587E8C58888.title: "First Shop"
	quest.4933CF4675E77D50.quest_desc: ["Upon taking fire or lava damage, &5Obsidian Skull&r grants temporary Fire Resistance, giving you time to escape the flames."]
	quest.4933CF4675E77D50.quest_subtitle: "Belt"
	quest.4933CF4675E77D50.title: "&5Obsidian Skull&r"
	quest.49D9B3C76D4602B9.quest_desc: ["An advanced data carrier holding up to 256 buckets of fluids on a single disk inside a Disk Drive."]
	quest.49D9B3C76D4602B9.quest_subtitle: "1x 256b Fluid Storage Disk"
	quest.49D9B3C76D4602B9.title: "256b Fluid Disk"
	quest.49F862D08B166B87.quest_desc: [
		"Journey to the End dimension, defeat the Ender Dragon, and claim the ancient &5Dragon Egg&r!"
		""
		"&eEngineering Tip:&r In AeroStratum you don't have to stop at a single egg! Running a Dragon Egg through a dedicated &6Sequenced Assembly&r line with &dInfused Dragon's Breath&r and an &bEye of Ender&r duplicates it into &a2x Dragon Egg&r — giving you an infinite supply of draconic cores for late-game crafting!"
	]
	quest.49F862D08B166B87.quest_subtitle: "Bio-quantum matrix on a Create assembly line"
	quest.49F862D08B166B87.title: "Trophy from the End: Dragon Egg & Duplication"
	quest.4A24DA33BEE3A811.quest_desc: ["Craft a &bWireless Grid&r, charge it with FE energy, and bind it to your network controller (Shift + right-click). You now have full access to your items while expanding your factory."]
	quest.4A24DA33BEE3A811.quest_subtitle: "Storage access in your pocket"
	quest.4A24DA33BEE3A811.title: "Mobile Warehouse: Wireless Grid"
	quest.4A7AEBEB87CEC274.quest_desc: ["&cRunning Shoes&r increase sprint speed and let you automatically step up 1-block ledges without jumping."]
	quest.4A7AEBEB87CEC274.quest_subtitle: "Feet"
	quest.4A7AEBEB87CEC274.title: "&cRunning Shoes&r"
	quest.4AA48533372994DB.quest_desc: ["Mixing organic ingredients and fluids in a basin under a mixer yields raw rubber ready for vulcanization."]
	quest.4AA48533372994DB.quest_subtitle: "1x Rubber"
	quest.4AA48533372994DB.title: "Rubber Synthesis: Raw Rubber"
	quest.4AAC259DE9557E5B.quest_desc: ["Install a &6Reactor Output&r at the base of the reactor. This block converts nuclear energy into an unimaginable amount of Stress Units (&6SU&r) capable of driving your entire factory and a bank of heavy alternators!"]
	quest.4AAC259DE9557E5B.quest_subtitle: "Extracting colossal rotational power (SU)"
	quest.4AAC259DE9557E5B.title: "Atomic Turbine: Reactor Output"
	quest.4AB3D19BB418DCD7.quest_desc: ["A central console managing every Autocrafter in your base. Lets you remotely insert and organize Patterns without running across the machine floor!"]
	quest.4AB3D19BB418DCD7.quest_subtitle: "1x Autocrafter Manager"
	quest.4AB3D19BB418DCD7.title: "Command Center: Autocrafter Manager"
	quest.4AF4F5612CE4A30F.quest_desc: ["Gold reinforcements provide even more resource slots and extra pockets for upgrades."]
	quest.4AF4F5612CE4A30F.quest_subtitle: "Almost the best"
	quest.4AF4F5612CE4A30F.title: "Golden Backpack"
	quest.4AFA8BFE92464E0B.quest_desc: ["Super Glue binds blocks together into moving structures for trains, airships, or mining contraptions. Remember: glue only bonds blocks to one another — make sure the contraption isn't glued to the static ground before assembling!"]
	quest.4AFA8BFE92464E0B.quest_subtitle: "1x Super Glue"
	quest.4AFA8BFE92464E0B.title: "Structural Adhesive: Super Glue"
	quest.4B3016AA3B3A09F7.quest_desc: [
		"Oil refining from &eTFMG&r opens up an entire lineup of specialized combustion and turbine engines — from classic inline units and aviation radial engines to gas turbines."
		""
		"All quests in this branch are optional — choose the designs that best fit your power plant or vehicles!"
	]
	quest.4B3016AA3B3A09F7.quest_subtitle: "Catalog of advanced TFMG power units"
	quest.4B3016AA3B3A09F7.title: "Automotive & TFMG Industrial Engines"
	quest.4BADD8A0FD85DB33.quest_desc: ["&eGolden Tooth&r drops from enemies while wearing a Piglin Mask — barter with Piglins using it or smelt it down into pure gold!"]
	quest.4BADD8A0FD85DB33.quest_subtitle: "Bastion currency"
	quest.4BADD8A0FD85DB33.title: "&eGolden Tooth"
	quest.4BD783487E35F8A0.quest_desc: [
		"Building your first train in &6Create&r requires following the right sequence. Follow these steps to assemble your train cleanly:"
		""
		"&l1. Laying Track:&r Place a straight stretch of &eTrain Track&r and set down a &eTrain Station&r beside it by right-clicking the target track first."
		"&l2. Assembly Mode:&r Open the station UI and click &bCreate New Train&r. Blue bogey markers will appear on the rails."
		"&l3. Building Cars:&r Place a &6Train Casing&r on a blue marker to turn it into a bogey. Build your locomotive frame on top, mount &eTrain Controls&r facing forward, plus chests or fluid tanks and &ePortable Storage Interfaces&r."
		"&l4. Gluing & Finalizing:&r Bond all blocks of each car with &aSuper Glue&r (make sure not to glue the train to the ground!). Return to the station, name your train, and click &aAssemble Train&r."
		""
		"&eTip:&r Seat any mob or &6Blaze Burner&r at the controls and hand them a &eTrain Schedule&r so the train runs completely automatically!"
	]
	quest.4BD783487E35F8A0.quest_subtitle: "From loose blocks to a roaring locomotive"
	quest.4BD783487E35F8A0.title: "Assembling Your First Train"
	quest.4BF5EB050EC14C80.quest_desc: ["&4The Watchers&r are flying sentry drones inside the Ancient Factory attacking with laser beams and blades."]
	quest.4BF5EB050EC14C80.title: "&4The Watchers&r"
	quest.4C247BF978FA7AEE.quest_desc: ["The Gold Autocrafter offers much faster processing speed and more pattern slots than the iron variant."]
	quest.4C247BF978FA7AEE.quest_subtitle: "1x Gold Crafter"
	quest.4C247BF978FA7AEE.title: "Gold Autocrafter"
	quest.4CA9892CF7949738.quest_desc: ["The hardest volcanic glass produced automatically — ideal for obsidian powder and Sturdy Sheets!"]
	quest.4CA9892CF7949738.quest_subtitle: "64x Obsidian"
	quest.4CA9892CF7949738.title: "Extrusion: Obsidian"
	quest.4CCEC13CC5A5772D.quest_desc: ["All three tamed mini-creatures from Cataclysm (Modern Remnant, Baby Leviathan, and Netherite Ministrosity) can be conveniently carried in a bucket!"]
	quest.4CCEC13CC5A5772D.title: "Pocket Beasts"
	quest.4D3379D38237F830.quest_desc: ["&bAqua-Dashers&r let you sprint across water surfaces like solid ground for as long as you keep sprinting!"]
	quest.4D3379D38237F830.quest_subtitle: "Feet"
	quest.4D3379D38237F830.title: "&bAqua-Dashers&r"
	quest.4D644A9829C240CB.quest_desc: ["&bBulwark of the Flame&r is Ignis's shield — holding Shift + right-click and releasing unleashes a fiery ramming charge that stuns enemies!"]
	quest.4D644A9829C240CB.title: "&bBulwark of the Flame"
	quest.4D822D92492E1F53.quest_desc: ["&3Aptrgangr&r is a mighty mini-boss of the Frosted Prison wielding a giant axe. Defeat it to claim the key to the main boss chamber!"]
	quest.4D822D92492E1F53.title: "&3Aptrgangr"
	quest.4DA40DA3D1519118.quest_desc: ["Dense slate from the lowest layers of the world, ready for processing on the surface."]
