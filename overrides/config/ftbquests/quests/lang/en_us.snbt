	quest.1113BF457DB7F1DE.title: "Climb to &6&lSummit"
	quest.1136FE2A46C13302.quest_desc: ["A Depot holds items in the exact right spot under a press or Deployer arm. Combined with funnels, it forms the simplest sequential processing station."]
	quest.1136FE2A46C13302.quest_subtitle: "Essential belt tools"
	quest.1136FE2A46C13302.title: "Basic Belt Tools"
	quest.1178E4123E8818E2.quest_desc: ["&eSandstorm in a Bottle&r summons swirling whirlwinds around you on use that damage and knock back enemies."]
	quest.1178E4123E8818E2.title: "&eSandstorm in a Bottle"
	quest.11A6D020D6F411A8.quest_desc: [
		"A mantle warping reality and enemy perception."
		""
		"• &2Perception Glitch&r: Grants a chance to completely dodge a hit."
		"• &9Glitchy Copy&r: Creates an illusory clone that stuns enemies on contact."
		"• &bSurface Tear&r: Lets you walk on air like scaffolding (as long as you keep moving)."
	]
	quest.11A6D020D6F411A8.quest_subtitle: "Reality distortion"
	quest.11A6D020D6F411A8.title: "&2Glitchy Mantle"
	quest.11B0B93D725ABE43.quest_desc: [
		"Silent Gear tools can be repaired anytime without an anvil using a &9Repair Kit&r!"
		""
		"Craft the repair kit with materials in a crafting grid to refill it, then combine it with your damaged tool."
	]
	quest.11B0B93D725ABE43.quest_subtitle: "Field repairs without an anvil"
	quest.11B0B93D725ABE43.title: "Repair Kit"
	quest.11C5F17C6BB1237B.quest_desc: ["Melee attacks while wearing a &5Withered Bracelet&r have a chance to inflict the Wither effect on your target."]
	quest.11C5F17C6BB1237B.quest_subtitle: "Wrists (Hands)"
	quest.11C5F17C6BB1237B.title: "&5Withered Bracelet&r"
	quest.11DBC70D36451A8D.quest_desc: ["A digital cartridge capable of holding up to 64 buckets of fluid inside a Disk Drive. No more building entire halls full of tanks!"]
