	quest.035A4D63CB792F6E.title: "Mechanical Grip: Zinc Hand"
	quest.037A93600E70561C.quest_desc: ["A unique module integrating physical drawer capacity with Refined Storage disk and block structures. Essential for sealing any data storage medium."]
	quest.037A93600E70561C.quest_subtitle: "1x Digital Drawer"
	quest.037A93600E70561C.title: "Hybrid Buffer: Digital Drawer"
	quest.04C59391A677A292.quest_desc: ["An empty, armored protective cartridge ready to house a memory core. Protects delicate quartz circuitry from damage."]
	quest.04C59391A677A292.quest_subtitle: "1x Storage Housing"
	quest.04C59391A677A292.title: "Data Shell: Storage Housing"
	quest.061307A9C70E47B4.quest_desc: ["A heated basin with a mixer allows you to alloy copper and zinc into noble brass. This alloy unlocks smart filtering, advanced machinery, and precision automation."]
	quest.061307A9C70E47B4.quest_subtitle: "1x Brass Ingot"
	quest.061307A9C70E47B4.title: "Engineer's Gold: Brass Alloy"
	quest.093786ED188CB158.quest_desc: ["Four times the data packing density. The ideal choice when output from automated quarries starts counting in the thousands."]
	quest.093786ED188CB158.quest_subtitle: "1x 4k Storage Part"
	quest.093786ED188CB158.title: "Denser Storage: 4k Part"
	quest.0B98C898071F3C33.quest_desc: ["A regular campfire won't suffice for smelting noble alloys. Forge an iron burner cage, travel to the Nether, and capture a Blaze inside to gain a controlled source of extreme heat."]
	quest.0B98C898071F3C33.quest_subtitle: "1x Empty Blaze Burner"
	quest.0B98C898071F3C33.title: "Elemental Cage"
	quest.0C16D28641468295.quest_desc: ["The Constructor pulls blocks from your Refined Storage network and places them in the world directly in front of it."]
	quest.0C16D28641468295.quest_subtitle: "1x Constructor"
	quest.0C16D28641468295.title: "Automated Builder: Constructor"
	quest.0C6ADA0C7F766E65.quest_desc: ["Dark volcanic rock generated on demand without trips to the Nether."]
	quest.0C6ADA0C7F766E65.quest_subtitle: "64x Basalt"
	quest.0C6ADA0C7F766E65.title: "Extrusion: Basalt"
	quest.1136FE2A46C13302.quest_desc: ["A Depot holds items in the exact position under a press or Deployer arm. Combined with funnels, it forms the simplest sequential processing station."]
	quest.1136FE2A46C13302.quest_subtitle: "Essential belt components"
	quest.1136FE2A46C13302.title: "Basic Belt Tools"
	quest.179A2967D712CE85.quest_desc: ["Infusing Nether quartz with a heavy dose of redstone dust creates a crystal capable of conducting and amplifying energy pulses."]
	quest.179A2967D712CE85.quest_subtitle: "1x Rose Quartz"
	quest.179A2967D712CE85.title: "Crystalline Resonance: Rose Quartz"
	quest.18B025CA634BFF11.quest_desc: ["A standalone 1k memory block that can be placed directly in the world and connected via cable without needing a Disk Drive."]
	quest.18B025CA634BFF11.quest_subtitle: "1x 1k Storage Block"
	quest.18B025CA634BFF11.title: "Stationary Bank 1k"
	quest.1B93CC74B13084E5.quest_desc: ["Dried kelp acts as a surprisingly flexible and durable industrial rubber substitute. Harvest a solid supply from the ocean floor – no conveyor belt will move without it."]
	quest.1B93CC74B13084E5.quest_subtitle: "32x Kelp"
	quest.1B93CC74B13084E5.title: "Harvest from the Deep: Kelp"
	quest.1C22288B92135426.quest_desc: ["A freestanding server rack holding up to 4,096 items. Works great as dedicated buffer storage hooked directly to an assembly line."]
	quest.1C22288B92135426.quest_subtitle: "1x 4k Storage Block"
	quest.1C22288B92135426.title: "Stationary Bank 4k"
	quest.1E3C2E5663DE1F3F.quest_desc: [
		"The pinnacle of precision mechanics! Line up a row of Deployers above a conveyor belt and automate Precision Mechanism production."
		""
		"Mastering this process opens the gates to advanced logistics, brass machinery, and full-scale factory automation. Welcome to Era 2!"
	]
	quest.1E3C2E5663DE1F3F.quest_subtitle: "Era 1 Milestone"
	quest.1E3C2E5663DE1F3F.title: "Golden Heart of Automation: Precision Mechanism"
	quest.200DFE86A1BCAE00.quest_desc: ["The Destructor mines blocks directly in front of it and sends the drops straight into your network storage disks."]
	quest.200DFE86A1BCAE00.quest_subtitle: "1x Destructor"
	quest.200DFE86A1BCAE00.title: "Automated Miner: Destructor"
	quest.24E0B7BE9E8CAF99.quest_desc: ["A docking bay holding up to 8 storage disks. Connect it to a Controller, insert your disks, and enjoy centralized digital storage."]
	quest.24E0B7BE9E8CAF99.quest_subtitle: "1x Disk Drive"
	quest.24E0B7BE9E8CAF99.title: "Server Rack: Disk Drive"
	quest.24F68B7E8A51E6FD.quest_desc: ["A specialized computing core responsible for materializing digital data into physical blocks."]
