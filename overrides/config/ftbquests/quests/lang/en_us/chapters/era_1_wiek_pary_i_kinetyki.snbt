	quest.31AA7117F83F8B86.title: "Assembly Arm: Deployer"
	quest.34B798B9DF328A6F.quest_desc: ["Polish raw rose quartz with sandpaper (or automate it with a Deployer) to unlock its full optical and electronic properties."]
