	quest.24F68B7E8A51E6FD.title: "Construction Core"
	quest.267ABF42F9628FEA.quest_desc: ["The heart of every Refined Storage network. Supply it with Forge Energy (FE), and it will power all connected terminals, drives, and interfaces."]
	quest.267ABF42F9628FEA.quest_subtitle: "1x Controller"
	quest.267ABF42F9628FEA.title: "Brain of Operations: Network Controller"
	quest.2A02D797F5CABAD6.quest_desc: ["An infinite source of andesite for mass production of Andesite Alloy."]
