{
	quest.0223CC1700D49B6C.quest_desc: [
		"Combining brass with redstone circuitry creates an advanced control module."
		""
		"This is the heart of smart automation – from filtering chutes and sequencers to crafting terminals and Refined Storage autocrafters."
	]
	quest.0223CC1700D49B6C.quest_subtitle: "1x Brass Redstone Machine"
	quest.0223CC1700D49B6C.title: "Brass Logic: Brass Redstone Machine"
	quest.02E1E48521F85EF6.quest_desc: [
		"Powerful, reinforced crushing wheels assembled on a Mechanical Crafter."
		""
		"Rotating against each other, they grind rocks and ores at high speeds, providing extra resource yields and access to valuable dusts."
	]
	quest.02E1E48521F85EF6.quest_subtitle: "2x Crushing Wheel"
	quest.02E1E48521F85EF6.title: "Heavy Crushers: Crushing Wheels"
	quest.046B84EA84A40FA7.quest_desc: [
		"Budding Amethyst is the living heart of a geode where new crystals continuously grow."
		""
		"Secure it in place or create your own via an infusion ritual to automate amethyst shard harvesting!"
	]
