{
  "pack_name": "AeroStratum: Integrated Engineering",
  "version": "1.0.0",
  "target_version": "NeoForge 1.21.1",
  "eras": [
    {
      "id": "era_1",
      "name": "Era I: Rdzeń Andezytu",
      "theme": "Kinetyka i Surowa Cyfryzacja",
      "description": "Podstawowa automatyzacja oparta na sile mechanicznej (koła wodne, wiatraki). Świat jest surowy, a przetrwanie zależy od ręcznego kucia i pierwszych taśmociągów. Sieć cyfrowa jest luksusem niszczącym sieć energetyczną.",
      "machine_integration": {
        "base_machine": "kubejs:andesite_machine",
        "process": "Sequenced Assembly (Andesite Casing -> Andesite Alloy -> Pressing -> Cogwheel x3 pętle) i Vanilla Smithing Table."
      },
      "kubejs_changes": [
        {
          "target": "refinedstorage:controller",
          "action": "remove_default_recipe",
          "new_method": "mechanical_crafting_3x3",
          "components": ["create:precision_mechanism", "create:andesite_alloy", "lightmanscurrency:coin_copper"]
        },
        {
          "target": "kubejs:andesite_machine",
          "action": "add_sequenced_assembly",
          "loops": 3,
          "steps": ["deploying_andesite_alloy", "pressing", "deploying_cogwheel"]
        },
        {
          "action": "remove_default_and_add_smithing",
          "template": "silentgear:blueprint_paper",
          "base_item": "kubejs:andesite_machine",
          "outputs": [
            { "item": "create:deployer", "addition": "create:brass_hand" },
            { "item": "create:mechanical_press", "addition": "minecraft:iron_block" },
            { "item": "create:mechanical_drill", "addition": "create:mechanical_drill_head" },
            { "item": "create:mechanical_saw", "addition": "create:saw_blade" },
            { "item": "create:encased_fan", "addition": "create:propeller" }
          ]
        },
        {
          "target": "storage_drawers:oak_full_drawers_1",
          "action": "modify_shaped_recipe",
          "components": ["create:andesite_alloy", "minecraft:oak_planks", "minecraft:chest"]
        }
      ],
      "config_changes": [
        {
          "file": "config/refinedstorage/refinedstorage.toml",
          "path": "controller.baseUsage",
          "new_value": 350,
          "reason": "Zmuszenie gracza do budowy infrastruktury energetycznej wczesnego Create"
        }
      ]
    },
    {
      "id": "era_intermediate",
      "name": "Era Intermediate: Logistyka Płynów",
      "theme": "Miedź, Ciśnienie i Para",
      "description": "Zarządzanie płynami, gazami i logistyką rurociągów. Gracz odchodzi od prostego magazynowania na rzecz zaawansowanego transportu rurami i zarządzania interfejsami.",
      "machine_integration": {
        "base_machine": "kubejs:copper_machine",
        "process": "Sequenced Assembly (Copper Casing -> Fluid Pipe -> Pressing -> Iron Nugget x3 pętle) i Vanilla Smithing Table."
      },
      "kubejs_changes": [
        {
          "target": "kubejs:copper_machine",
          "action": "add_sequenced_assembly",
          "loops": 3,
          "steps": ["deploying_fluid_pipe", "pressing", "deploying_iron_nugget"]
        },
        {
          "action": "remove_default_and_add_smithing",
          "template": "silentgear:blueprint_paper",
          "base_item": "kubejs:copper_machine",
          "outputs": [
            { "item": "create:portable_storage_interface", "addition": "create:chute" },
            { "item": "create:fluid_valve", "addition": "create:shaft" }
          ]
        }
      ],
      "config_changes": []
    },
    {
      "id": "era_2",
      "name": "Era II: Mosiądz i Petrochemia",
      "theme": "Ciężki Przemysł i Bezwzględna Wydajność",
      "description": "Wkroczenie w prawdziwy wiek przemysłowy i automatyzację logiczną. Pojawiają się pierwsze filtry, inteligentne ramiona, przetwórstwo ropy naftowej oraz automatyczna, mechaniczna utylizacja zasobów.",
      "machine_integration": {
        "base_machine": "kubejs:brass_machine",
        "process": "Sequenced Assembly (Brass Casing -> Precision Mechanism -> Pressing -> Electron Tube x4 pętle) i Vanilla Smithing Table."
      },
      "kubejs_changes": [
        {
          "target": "kubejs:brass_machine",
          "action": "add_sequenced_assembly",
          "loops": 4,
          "steps": ["deploying_precision_mechanism", "pressing", "deploying_electron_tube"]
        },
        {
          "action": "remove_default_and_add_smithing",
          "template": "silentgear:blueprint_paper",
          "base_item": "kubejs:brass_machine",
          "outputs": [
            { "item": "create:mechanical_mixer", "addition": "create:whisk" },
            { "item": "create:mechanical_arm", "addition": "create:precision_mechanism" }
          ]
        },
        {
          "target": "silentgear:blueprint_paper",
          "action": "remove_and_move_to_pressing",
          "components": ["minecraft:paper", "create:brass_sheet", "lightmanscurrency:coin_copper"]
        },
        {
          "target": "silentgear:gear_smithing_table",
          "action": "modify_shaped_recipe",
          "components": ["create_tfmg:steel_ingot", "create:precision_mechanism", "create:brass_casing"]
        },
        {
          "target": "mob_grinding_utils:saw",
          "action": "modify_shaped_recipe",
          "components": ["create_tfmg:steel_ingot", "create:cogwheel", "create:precision_mechanism"]
        }
      ],
      "config_changes": [
        {
          "file": "config/ftbchunks/ftbchunks-world.toml",
          "path": "claims.max_claimed_chunks",
          "new_value": 100
        },
        {
          "file": "config/ftbchunks/ftbchunks-world.toml",
          "path": "claims.max_force_loaded_chunks",
          "new_value": 15
        },
        {
          "file": "config/ftbchunks/ftbchunks-world.toml",
          "path": "protection.allow_explosions",
          "new_value": false
        }
      ]
    },
    {
      "id": "era_3",
      "name": "Era III: Atom, Diesel i Flota Powietrzna",
      "theme": "Globalny Endgame i Bezprzewodowość",
      "description": "Najwyższy stopień zaawansowania. Gracz buduje ogromne, mobilne statki powietrzne, wielkie rafinerie diesla oraz reaktory jądrowe, by zasilić globalną automatyzację i okiełznać bezprzewodowość sieci RS.",
      "machine_integration": {
        "base_machine": "N/A",
        "process": "Łączenie endgame'owych komponentów technologicznych z materiałami rozszczepialnymi i walutą wyższego tieru."
      },
      "kubejs_changes": [
        {
          "target": "refinedstorage:wireless_transmitter",
          "action": "remove_and_move_to_mechanical_crafting",
          "components": ["create_nuclear:uranium_ingot", "create_nuclear:lead_ingot", "create:precision_mechanism", "create:brass_casing"]
        },
        {
          "target": "rsinfinitybooster:infinity_card",
          "action": "add_sequenced_assembly",
          "base_item": "refinedstorage:advanced_processor",
          "loops": 4,
          "steps": ["deploying_uranium_ingot", "pressing", "deploying_gold_coin"]
        },
        {
          "target": "createbigcannons:built_up_barrel",
          "action": "modify_mechanical_crafting",
          "components": ["create_tfmg:steel_block"]
        }
      ],
      "config_changes": []
    },
    {
      "id": "era_4",
      "name": "Era IV: Endgame",
      "theme": "Ekspedycja w Głąb Ciemności",
      "description": "Świat zewnętrzny został w pełni zautomatyzowany. Najpotężniejsze zasoby, mityczne ulepszenia Silent Gear oraz boskie klejnoty z Apotheosis są ukryte głęboko pod ziemią (Alex's Caves i Deep Dark). Pancerniki powietrzne ruszają na wojnę z bossami Cataclysm.",
      "machine_integration": {
        "base_machine": "N/A",
        "process": "Eksploracja i walka z bossami jako jedyne źródło surowców mitycznych."
      },
      "kubejs_changes": [
        {
          "target": "apotheosis_loot_tables",
          "action": "inject_into_underground_structures_only",
          "allowed_dimensions": ["alexscaves:underground", "minecraft:the_dark_deep"]
        }
      ],
      "config_changes": []
    }
  ]
}